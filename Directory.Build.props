<Project>
  <PropertyGroup>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904</NoWarn>
    
    <!-- ⚡ Visual Studio & MSBuild Build Acceleration (Skips rebuilding up-to-date projects) -->
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    
    <!-- ⚡ .NET 10 Dynamic Tiered Compilation & Profile Guided Optimization (20-30% faster execution) -->
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
</Project>
