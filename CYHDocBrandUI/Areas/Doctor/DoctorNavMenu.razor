@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<div class="cyh-brand" style="border-bottom: 1px solid rgba(0, 242, 254, 0.25);">
    <div class="cyh-brand-logo" style="background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%); box-shadow: 0 0 20px rgba(0, 242, 254, 0.45); color: #070d1e;">
        <i class="bi bi-heart-pulse-fill"></i>
    </div>
    <div>
        <div class="cyh-brand-title">CYH DoctorHub</div>
        <div class="cyh-brand-subtitle" style="color: #00f2fe;">Clinical Workspace</div>
    </div>
</div>

<div class="px-3 pt-3">
    <div class="p-2 text-center rounded-3" style="background: rgba(0, 242, 254, 0.12); border: 1px solid rgba(0, 242, 254, 0.35);">
        <span class="badge" style="background: transparent; color: #00f2fe; font-size: 0.72rem; letter-spacing: 0.8px; font-weight: 700;">
            <i class="bi bi-person-badge-fill me-1"></i> DOCTOR PORTAL
        </span>
    </div>
</div>

<div class="cyh-nav">
    <div class="cyh-nav-divider" style="color: #cbd5e1;">Navigation</div>

    <NavLink class="cyh-nav-item" href="doctor/dashboard" Match="NavLinkMatch.All">
        <i class="bi bi-hospital-fill text-info"></i>
        <span>My Clinical Dashboard</span>
    </NavLink>

    <NavLink class="cyh-nav-item" href="doctor/profile">
        <i class="bi bi-person-circle text-info"></i>
        <span>My Profile</span>
    </NavLink>

    <NavLink class="cyh-nav-item" href="doctor/schedule">
        <i class="bi bi-calendar3-week text-info"></i>
        <span>OPD Timings & Duty</span>
    </NavLink>

    <NavLink class="cyh-nav-item" href="doctor/colleagues">
        <i class="bi bi-person-badge-fill text-info"></i>
        <span>Hospital Faculty</span>
    </NavLink>
</div>

<div class="cyh-sidebar-footer" style="border-top: 1px solid rgba(0, 242, 254, 0.2); padding: 0.9rem 1rem;">
    <button type="button" class="glass-btn-danger w-100 d-flex align-items-center justify-content-center gap-2 py-2" @onclick="Logout" style="border-radius: 10px; font-size: 0.88rem; font-weight: 600; cursor: pointer; transition: all 0.2s ease;">
        <i class="bi bi-box-arrow-right"></i>
        <span>Logout</span>
    </button>
</div>

@code {
    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("login", forceLoad: true);
    }
}
