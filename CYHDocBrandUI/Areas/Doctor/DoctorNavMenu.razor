@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<style>
    .cyh-locked-item {
        transition: all 0.2s ease;
    }
    .cyh-locked-item:hover {
        background: rgba(245, 158, 11, 0.1) !important;
        border-color: rgba(245, 158, 11, 0.6) !important;
        transform: translateX(3px);
    }
</style>

<div class="cyh-brand" style="border-bottom: 1px solid rgba(0, 242, 254, 0.25);">
    <div class="cyh-brand-logo" style="background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%); box-shadow: 0 0 20px rgba(0, 242, 254, 0.45); color: #070d1e;">
        <i class="bi bi-heart-pulse-fill"></i>
    </div>
    <div class="flex-grow-1 min-w-0" style="overflow: hidden;">
        <div class="cyh-brand-title text-truncate">CYH Brand Hub</div>
        <div class="cyh-brand-subtitle text-truncate" style="color: #00f2fe; font-size: 0.72rem;">Workspace</div>
    </div>
    <!-- Mobile Close Button -->
    <button type="button" class="cyh-sidebar-close-btn d-lg-none" @onclick="HandleClose" @onclick:stopPropagation="true" aria-label="Close menu" title="Close menu" style="border-color: rgba(0, 242, 254, 0.45); color: #00f2fe; background: rgba(0, 242, 254, 0.1);">
        <i class="bi bi-x-lg"></i>
    </button>
</div>

<div class="px-3 pt-3 flex-shrink-0">
    @if (IsActive)
    {
        <div class="p-2 text-center rounded-3" style="background: rgba(0, 242, 254, 0.12); border: 1px solid rgba(0, 242, 254, 0.35);">
            <span class="badge" style="background: transparent; color: #00f2fe; font-size: 0.72rem; letter-spacing: 0.8px; font-weight: 700;">
                <i class="bi bi-person-badge-fill me-1"></i> DOCTOR PORTAL • ACTIVE
            </span>
        </div>
    }
    else
    {
        <div class="p-2 text-center rounded-3" style="background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.45); box-shadow: 0 0 15px rgba(245, 158, 11, 0.15);">
            <div class="d-flex align-items-center justify-content-center gap-1 text-warning fw-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                <i class="bi bi-clock-history"></i> APPROVAL PENDING
            </div>
            <div style="font-size: 0.68rem; color: #cbd5e1; margin-top: 3px;">
                Only <strong class="text-warning">Profile</strong> is unlocked
            </div>
        </div>
    }
</div>

<div class="cyh-nav">
    <div class="cyh-nav-divider" style="color: #cbd5e1;">Navigation</div>

    @if (IsActive)
    {
        <NavLink class="cyh-nav-item" href="doctor/dashboard" Match="NavLinkMatch.All" @onclick="HandleClose">
            <i class="bi bi-speedometer2 text-info"></i>
            <span>Dashboard</span>
        </NavLink>

        <NavLink class="cyh-nav-item" href="doctor/profile" @onclick="HandleClose">
            <i class="bi bi-person-circle text-info"></i>
            <span>My Profile &amp; Branding</span>
        </NavLink>

        <NavLink class="cyh-nav-item" href="doctor/template-gallery" @onclick="HandleClose">
            <i class="bi bi-grid-3x3-gap-fill text-info"></i>
            <span>50+ Templates Gallery</span>
        </NavLink>

        <NavLink class="cyh-nav-item" href="doctor/banner-design" @onclick="HandleClose">
            <i class="bi bi-palette-fill text-info"></i>
            <span>AI Banner Studio</span>
        </NavLink>

        <NavLink class="cyh-nav-item" href="doctor/banner-designs" @onclick="HandleClose">
            <i class="bi bi-collection-play-fill text-info"></i>
            <span>My Banner Designs</span>
        </NavLink>

        <NavLink class="cyh-nav-item" href="doctor/schedules" @onclick="HandleClose">
            <i class="bi bi-calendar2-check-fill text-info"></i>
            <span>Scheduled Posts</span>
        </NavLink>

        <NavLink class="cyh-nav-item" href="doctor/credit-history" @onclick="HandleClose">
            <i class="bi bi-clock-history text-info"></i>
            <span>Credit &amp; Usage History</span>
        </NavLink>
    }
    else
    {
        <div class="cyh-nav-item cyh-locked-item" style="display: flex; align-items: center; justify-content: space-between; cursor: pointer; background: rgba(255, 255, 255, 0.04); border: 1px dashed rgba(245, 158, 11, 0.35); border-radius: 8px; margin-bottom: 6px; padding: 0.65rem 0.85rem;" @onclick='() => ShowLockedNotice("Dashboard")' title="Click to view lock details">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-speedometer2" style="color: #94a3b8; font-size: 1rem;"></i>
                <span style="color: #e2e8f0; font-weight: 500; font-size: 0.88rem;">Dashboard</span>
            </div>
            <span class="badge" style="background: rgba(245, 158, 11, 0.22); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.5); font-size: 0.68rem; font-weight: 700; padding: 3px 7px;">
                <i class="bi bi-lock-fill me-1"></i> LOCKED
            </span>
        </div>

        <NavLink class="cyh-nav-item" href="doctor/profile" style="display: flex; align-items: center; justify-content: space-between; background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.45); border-radius: 8px; margin-bottom: 6px; padding: 0.65rem 0.85rem;" @onclick="HandleClose">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-person-circle text-info" style="font-size: 1.05rem;"></i>
                <span class="fw-bold text-white" style="font-size: 0.88rem;">My Profile &amp; Branding</span>
            </div>
            <span class="badge" style="background: rgba(16, 185, 129, 0.25); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.5); font-size: 0.68rem; font-weight: 700; padding: 3px 7px;">
                <i class="bi bi-unlock-fill me-1"></i> UNLOCKED
            </span>
        </NavLink>

        <div class="cyh-nav-item cyh-locked-item" style="display: flex; align-items: center; justify-content: space-between; cursor: pointer; background: rgba(255, 255, 255, 0.04); border: 1px dashed rgba(245, 158, 11, 0.35); border-radius: 8px; margin-bottom: 6px; padding: 0.65rem 0.85rem;" @onclick='() => ShowLockedNotice("50+ Templates Gallery")' title="Click to view lock details">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-grid-3x3-gap-fill" style="color: #94a3b8; font-size: 1rem;"></i>
                <span style="color: #e2e8f0; font-weight: 500; font-size: 0.88rem;">50+ Templates Gallery</span>
            </div>
            <span class="badge" style="background: rgba(245, 158, 11, 0.22); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.5); font-size: 0.68rem; font-weight: 700; padding: 3px 7px;">
                <i class="bi bi-lock-fill me-1"></i> LOCKED
            </span>
        </div>

        <div class="cyh-nav-item cyh-locked-item" style="display: flex; align-items: center; justify-content: space-between; cursor: pointer; background: rgba(255, 255, 255, 0.04); border: 1px dashed rgba(245, 158, 11, 0.35); border-radius: 8px; margin-bottom: 6px; padding: 0.65rem 0.85rem;" @onclick='() => ShowLockedNotice("AI Banner Studio")' title="Click to view lock details">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-palette-fill" style="color: #94a3b8; font-size: 1rem;"></i>
                <span style="color: #e2e8f0; font-weight: 500; font-size: 0.88rem;">AI Banner Studio</span>
            </div>
            <span class="badge" style="background: rgba(245, 158, 11, 0.22); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.5); font-size: 0.68rem; font-weight: 700; padding: 3px 7px;">
                <i class="bi bi-lock-fill me-1"></i> LOCKED
            </span>
        </div>

        <div class="cyh-nav-item cyh-locked-item" style="display: flex; align-items: center; justify-content: space-between; cursor: pointer; background: rgba(255, 255, 255, 0.04); border: 1px dashed rgba(245, 158, 11, 0.35); border-radius: 8px; margin-bottom: 6px; padding: 0.65rem 0.85rem;" @onclick='() => ShowLockedNotice("My Banner Designs")' title="Click to view lock details">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-collection-play-fill" style="color: #94a3b8; font-size: 1rem;"></i>
                <span style="color: #e2e8f0; font-weight: 500; font-size: 0.88rem;">My Banner Designs</span>
            </div>
            <span class="badge" style="background: rgba(245, 158, 11, 0.22); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.5); font-size: 0.68rem; font-weight: 700; padding: 3px 7px;">
                <i class="bi bi-lock-fill me-1"></i> LOCKED
            </span>
        </div>

        <div class="cyh-nav-item cyh-locked-item" style="display: flex; align-items: center; justify-content: space-between; cursor: pointer; background: rgba(255, 255, 255, 0.04); border: 1px dashed rgba(245, 158, 11, 0.35); border-radius: 8px; margin-bottom: 6px; padding: 0.65rem 0.85rem;" @onclick='() => ShowLockedNotice("Scheduled Posts")' title="Click to view lock details">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-calendar2-check-fill" style="color: #94a3b8; font-size: 1rem;"></i>
                <span style="color: #e2e8f0; font-weight: 500; font-size: 0.88rem;">Scheduled Posts</span>
            </div>
            <span class="badge" style="background: rgba(245, 158, 11, 0.22); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.5); font-size: 0.68rem; font-weight: 700; padding: 3px 7px;">
                <i class="bi bi-lock-fill me-1"></i> LOCKED
            </span>
        </div>

        <div class="cyh-nav-item cyh-locked-item" style="display: flex; align-items: center; justify-content: space-between; cursor: pointer; background: rgba(255, 255, 255, 0.04); border: 1px dashed rgba(245, 158, 11, 0.35); border-radius: 8px; margin-bottom: 6px; padding: 0.65rem 0.85rem;" @onclick='() => ShowLockedNotice("Credit & Usage History")' title="Click to view lock details">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-clock-history" style="color: #94a3b8; font-size: 1rem;"></i>
                <span style="color: #e2e8f0; font-weight: 500; font-size: 0.88rem;">Credit &amp; Usage History</span>
            </div>
            <span class="badge" style="background: rgba(245, 158, 11, 0.22); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.5); font-size: 0.68rem; font-weight: 700; padding: 3px 7px;">
                <i class="bi bi-lock-fill me-1"></i> LOCKED
            </span>
        </div>
    }
</div>

<div class="cyh-sidebar-footer" style="border-top: 1px solid rgba(0, 242, 254, 0.2); padding: 0.9rem 1rem;">
    <!-- Live Server Time (Indian Standard Time) -->
    <div class="mb-2 d-flex justify-content-center">
        <ServerTimeClock />
    </div>

    <button type="button" class="glass-btn-danger w-100 d-flex align-items-center justify-content-center gap-2 py-2" @onclick="Logout" style="border-radius: 10px; font-size: 0.88rem; font-weight: 600; cursor: pointer; transition: all 0.2s ease;">
        <i class="bi bi-box-arrow-right"></i>
        <span>Logout</span>
    </button>
</div>

@code {
    [Parameter]
    public EventCallback<string> OnLockedClicked { get; set; }

    [Parameter]
    public EventCallback OnCloseMenu { get; set; }

    private bool IsActive = true;

    protected override async Task OnInitializedAsync()
    {
        var currentUser = await AuthService.GetOrRestoreCurrentUserAsync();
        if (currentUser != null)
        {
            IsActive = currentUser.IsActive;
        }
    }

    private async Task HandleClose()
    {
        if (OnCloseMenu.HasDelegate)
        {
            await OnCloseMenu.InvokeAsync();
        }
    }

    private async Task ShowLockedNotice(string moduleName)
    {
        if (OnLockedClicked.HasDelegate)
        {
            await OnLockedClicked.InvokeAsync(moduleName);
        }
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("login", forceLoad: true);
    }
}
