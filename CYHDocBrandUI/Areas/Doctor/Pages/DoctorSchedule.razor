@page "/doctor/schedule"
@layout DoctorLayout
@inject IDoctorRepository DoctorRepo
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider

<div class="d-flex flex-column gap-4">
    <!-- Header -->
    <div class="glass-panel p-4 d-flex flex-wrap align-items-center justify-content-between gap-3" style="border-left: 4px solid #00f2fe;">
        <div>
            <h3 class="fw-bold mb-1 text-white">
                <i class="bi bi-calendar3-week text-info me-2"></i>OPD Timings & Duty Schedule
            </h3>
            <p class="small mb-0" style="color: #cbd5e1;">Personal Clinical Consultation Shift • Room Allocation & Active Duty</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="glass-btn-primary" @onclick="ToggleAvailability">
                <i class="bi bi-power"></i>
                <span>@(CurrentDoctor?.IsAvailableToday == true ? "Shift Active (Click to Set Away)" : "Shift Away (Click to Set Active)")</span>
            </button>
        </div>
    </div>

    <div class="row g-4">
        <!-- Weekly Schedule Card -->
        <div class="col-12 col-lg-7">
            <div class="glass-panel p-4 h-100">
                <h5 class="fw-bold text-white mb-3">
                    <i class="bi bi-clock-history text-info me-2"></i>Weekly Consultation Allocation
                </h5>
                <div class="d-flex flex-column gap-3">
                    <div class="glass-card p-3 d-flex align-items-center justify-content-between">
                        <div>
                            <div class="fw-bold text-white">Clinical Days</div>
                            <small style="color: #94a3b8;">Regular OPD operational schedule</small>
                        </div>
                        <span class="badge bg-dark border border-secondary text-info fs-6 px-3 py-2">
                            @(CurrentDoctor?.AvailableDays ?? "Monday - Saturday")
                        </span>
                    </div>

                    <div class="glass-card p-3 d-flex align-items-center justify-content-between">
                        <div>
                            <div class="fw-bold text-white">Consultation Hours</div>
                            <small style="color: #94a3b8;">Designated outpatient clinic slots</small>
                        </div>
                        <span class="badge bg-dark border border-secondary text-info fs-6 px-3 py-2">
                            @(CurrentDoctor?.AvailableHours ?? "09:00 AM - 04:00 PM")
                        </span>
                    </div>

                    <div class="glass-card p-3 d-flex align-items-center justify-content-between">
                        <div>
                            <div class="fw-bold text-white">Consultation Fee</div>
                            <small style="color: #94a3b8;">Per outpatient visit / case</small>
                        </div>
                        <span class="badge bg-dark border border-secondary text-success fs-6 px-3 py-2">
                            $@(CurrentDoctor?.ConsultationFee.ToString("N2") ?? "85.00")
                        </span>
                    </div>

                    <div class="glass-card p-3 d-flex align-items-center justify-content-between">
                        <div>
                            <div class="fw-bold text-white">Assigned Examination Room</div>
                            <small style="color: #94a3b8;">Hospital floor department room</small>
                        </div>
                        <span class="badge bg-dark border border-secondary text-white fs-6 px-3 py-2">
                            Room 304 (Coronary Care Wing)
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Live Shift Status -->
        <div class="col-12 col-lg-5">
            <div class="glass-panel p-4 h-100 d-flex flex-column justify-content-between">
                <div>
                    <h5 class="fw-bold text-white mb-3">
                        <i class="bi bi-activity text-info me-2"></i>Live Hospital Duty
                    </h5>
                    <p class="small mb-4" style="color: #94a3b8;">
                        Your status is broadcasted to the Central Command and the entire medical team via SQL Server Stored Procedures.
                    </p>

                    <div class="glass-card p-4 text-center mb-3">
                        <div class="display-6 mb-2 @(CurrentDoctor?.IsAvailableToday == true ? "text-success" : "text-muted")">
                            <i class="bi @(CurrentDoctor?.IsAvailableToday == true ? "bi-check-circle-fill" : "bi-moon-fill")"></i>
                        </div>
                        <h4 class="fw-bold text-white">@(CurrentDoctor?.IsAvailableToday == true ? "Currently On Duty" : "Currently Off Duty")</h4>
                        <p class="small mb-0" style="color: #cbd5e1;">
                            @(CurrentDoctor?.IsAvailableToday == true ? "You are marked active and visible for clinical care today." : "You are marked offline or away.")
                        </p>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top" style="border-color: rgba(255,255,255,0.08) !important;">
                    <span class="small" style="color: #94a3b8;">Audit Log:</span>
                    <span class="badge bg-dark text-info">Managed via ManageDoctor_CYH</span>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private DoctorProfile? CurrentDoctor;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var currentUser = await AuthService.GetOrRestoreCurrentUserAsync();
            if (currentUser == null)
            {
                NavigationManager.NavigateTo("login");
                return;
            }

            if (currentUser.Role != "Doctor")
            {
                NavigationManager.NavigateTo("admin/dashboard");
                return;
            }

            if (!currentUser.IsActive)
            {
                NavigationManager.NavigateTo("doctor/profile");
                return;
            }

            await LoadDoctorDataAsync();
        }
        catch
        {
            // Fail gracefully on reload
        }
    }

    private async Task LoadDoctorDataAsync()
    {
        try
        {
            var currentUser = await AuthService.GetOrRestoreCurrentUserAsync();
            if (currentUser == null) return;

            DoctorProfile? doc = null;
            if (currentUser.DoctorProfileId.HasValue)
            {
                doc = await DoctorRepo.GetByIdAsync(currentUser.DoctorProfileId.Value);
            }

            if (doc == null && !string.IsNullOrEmpty(currentUser.UserId))
            {
                doc = await DoctorRepo.GetByUserIdAsync(currentUser.UserId);
            }

            CurrentDoctor = doc;
        }
        catch
        {
            // Fail gracefully
        }
    }

    private async Task ToggleAvailability()
    {
        try
        {
            if (CurrentDoctor == null) return;
            await DoctorRepo.ToggleAvailabilityAsync(CurrentDoctor.Id);
            await LoadDoctorDataAsync();
        }
        catch
        {
            // Fail gracefully
        }
    }
}
