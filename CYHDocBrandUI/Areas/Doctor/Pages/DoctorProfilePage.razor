@page "/doctor/profile"
@layout DoctorLayout
@using CYHDocBrandRepo.Utilities
@inject IDoctorRepository DoctorRepo
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IWebHostEnvironment WebHostEnvironment

<div class="d-flex flex-column gap-4">
    <!-- Top Header Banner & Actions -->
    <div class="glass-panel p-4 d-flex flex-wrap align-items-center justify-content-between gap-3" style="border-left: 4px solid #00f2fe;">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1" style="font-size: 0.8rem;">
                    <li class="breadcrumb-item"><a href="doctor/dashboard" class="text-info text-decoration-none"><i class="bi bi-hospital me-1"></i>Dashboard</a></li>
                    <li class="breadcrumb-item active" style="color: #cbd5e1;" aria-current="page">My Profile</li>
                </ol>
            </nav>
            <h3 class="fw-bold mb-1 text-white d-flex align-items-center gap-2">
                <i class="bi bi-person-badge-fill text-info"></i>
                <span>Doctor Profile &amp; Clinical Branding</span>
            </h3>
            <p class="small mb-0" style="color: #cbd5e1;">Manage your professional clinical identity, clinic details, qualifications, and available platform credits.</p>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            <!-- AI Credits Pill Badge -->
            <div class="badge px-3 py-2 rounded-pill d-flex align-items-center gap-2" 
                 style="background: rgba(245, 158, 11, 0.18); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.4); font-size: 0.82rem; font-weight: 700;"
                 title="Available AI Generation Credits">
                <i class="bi bi-lightning-charge-fill text-warning fs-6"></i>
                <span>Credits: <strong style="color: #ffffff; font-size: 0.92rem;">@(Profile?.AiCredits ?? 25)</strong></span>
            </div>

            <!-- Verified Badge -->
            <span class="badge bg-success bg-opacity-25 text-success border border-success px-3 py-2 rounded-pill" style="font-size: 0.8rem;">
                <i class="bi bi-patch-check-fill me-1"></i> Verified Specialist
            </span>

            <button type="button" class="glass-btn-primary" @onclick="SaveChanges" disabled="@IsSaving">
                @if (IsSaving)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                    <span>Saving...</span>
                }
                else
                {
                    <i class="bi bi-check2-circle me-1"></i>
                    <span>Save Changes</span>
                }
            </button>
        </div>
    </div>

    <!-- Feedback Alerts -->
    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <div class="alert alert-success py-2 px-3 d-flex align-items-center gap-2 mb-0" style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.35); color: #34d399; border-radius: 12px;">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <span>@SuccessMessage</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger py-2 px-3 d-flex align-items-center gap-2 mb-0" style="background: rgba(244, 63, 94, 0.15); border: 1px solid rgba(244, 63, 94, 0.35); color: #fda4af; border-radius: 12px;">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <span>@ErrorMessage</span>
        </div>
    }

    <!-- 2-Column Main Workspace -->
    <div class="row g-4">
        <!-- ── LEFT COLUMN: Avatar, Photo & Brand Card ── -->
        <div class="col-12 col-lg-4">
            <div class="d-flex flex-column gap-4">
                <!-- Profile Identity Card -->
                <div class="glass-panel p-4 text-center position-relative overflow-hidden">
                    <div class="position-absolute top-0 start-0 w-100" style="height: 3px; background: linear-gradient(90deg, #00f2fe, #4facfe, #8b5cf6);"></div>

                    <!-- Hidden File Input for Doctor Photo -->
                    <InputFile id="profilePicInput" OnChange="HandleProfilePicUpload" accept=".jpg,.jpeg,.png,.webp" style="display:none;" />

                    <!-- Doctor Avatar / Photo with Upload Overlay -->
                    <div class="position-relative d-inline-block mt-3 mb-2">
                        <label for="profilePicInput" class="rounded-circle shadow border border-3 border-info overflow-hidden d-inline-flex align-items-center justify-content-center position-relative mb-0"
                             style="width: 125px; height: 125px; background: linear-gradient(135deg, #0b1c3a, #152d5a); cursor: pointer;"
                             title="Click to upload or change photo">
                            @if (IsUploadingPic)
                            {
                                <div class="position-absolute w-100 h-100 d-flex flex-column align-items-center justify-content-center" style="background: rgba(7, 13, 30, 0.82); z-index: 5;">
                                    <span class="spinner-border text-info spinner-border-sm mb-1" role="status"></span>
                                    <span style="font-size: 0.68rem; color: #38bdf8;">Saving...</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Profile?.ProfilePic))
                            {
                                <img src="@Profile.ProfilePic" alt="@Profile.FullName" class="w-100 h-100" style="object-fit: cover;" />
                            }
                            else
                            {
                                <div class="user-avatar" style="width: 100%; height: 100%; border-radius: 0; font-size: 2.8rem; background: linear-gradient(135deg, #00f2fe, #4facfe); color: #070d1e; display: flex; align-items: center; justify-content: center;">
                                    @(Profile?.FullName?.Length > 0 ? Profile.FullName[0] : 'D')
                                </div>
                            }
                        </label>
                        <label for="profilePicInput" class="position-absolute bottom-0 end-0 bg-info text-dark rounded-circle p-2 shadow-sm d-flex align-items-center justify-content-center border border-2 border-dark"
                              style="width: 34px; height: 34px; transform: translate(-2px, -2px); cursor: pointer;"
                              title="Click to upload or change photo">
                            <i class="bi bi-camera-fill" style="font-size: 0.85rem;"></i>
                        </label>
                    </div>

                    <!-- Photo Action Buttons (Upload / Edit / Delete) -->
                    <div class="d-flex flex-wrap align-items-center justify-content-center gap-2 mb-1">
                        <label for="profilePicInput" class="glass-btn-secondary btn-sm mb-0 d-inline-flex align-items-center gap-1" style="cursor: pointer; font-size: 0.78rem; padding: 5px 12px;">
                            @if (IsUploadingPic)
                            {
                                <span class="spinner-border spinner-border-sm me-1" style="width: 0.75rem; height: 0.75rem;"></span>
                                <span>Uploading...</span>
                            }
                            else
                            {
                                <i class="bi bi-pencil-square text-info"></i>
                                <span>@(string.IsNullOrEmpty(Profile?.ProfilePic) ? "Upload Photo" : "Change Photo")</span>
                            }
                        </label>

                        @if (!string.IsNullOrEmpty(Profile?.ProfilePic))
                        {
                            <button type="button" class="btn btn-sm d-inline-flex align-items-center gap-1"
                                    style="border-radius: 10px; font-size: 0.78rem; padding: 5px 12px; background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #fca5a5;"
                                    @onclick="RemoveProfilePic"
                                    disabled="@(IsUploadingPic || IsSaving)"
                                    title="Delete current photo">
                                <i class="bi bi-trash3-fill text-danger"></i>
                                <span>Delete Photo</span>
                            </button>
                        }
                    </div>

                    <small class="text-white-50 d-block mb-3" style="font-size: 0.7rem;">
                        <i class="bi bi-shield-check text-info me-1"></i>Max image size: 1 MB (Auto-optimized)
                    </small>

                    <h4 class="fw-bold mb-1 text-white">@(string.IsNullOrWhiteSpace(Profile?.DisplayName) ? Profile?.FullName : Profile.DisplayName)</h4>
                    <p class="text-info fw-semibold small mb-2">@(Profile?.Specialization ?? "Chief Specialist")</p>
                    <span class="badge bg-dark border border-secondary text-white-50 px-3 py-1 mb-3" style="font-size: 0.75rem;">
                        @(Profile?.Qualifications ?? "MBBS, MD, DM, FACC")
                    </span>

                    <!-- Quick Metrics Strip -->
                    <div class="d-flex flex-column gap-2 text-start pt-3 border-top" style="border-color: rgba(255, 255, 255, 0.08) !important;">
                        <div class="glass-card p-2 d-flex justify-content-between align-items-center">
                            <span style="color: #94a3b8; font-size: 0.82rem;"><i class="bi bi-lightning-charge-fill text-warning me-1"></i> AI Credits:</span>
                            <span class="badge" style="background: rgba(245, 158, 11, 0.2); color: #fbbf24; font-size: 0.82rem; font-weight: 700;">
                                @(Profile?.AiCredits ?? 25) Credits
                            </span>
                        </div>

                        <div class="glass-card p-2 d-flex justify-content-between align-items-center">
                            <span style="color: #94a3b8; font-size: 0.82rem;"><i class="bi bi-currency-dollar text-success me-1"></i> Fee:</span>
                            <span class="text-success fw-bold">$@(Profile?.ConsultationFee.ToString("N2") ?? "85.00")</span>
                        </div>

                        <div class="glass-card p-2 d-flex justify-content-between align-items-center">
                            <span style="color: #94a3b8; font-size: 0.82rem;"><i class="bi bi-award-fill text-info me-1"></i> Experience:</span>
                            <span class="text-white fw-semibold">@(Profile?.ExperienceYears ?? 14) Years</span>
                        </div>

                        <div class="glass-card p-2 d-flex justify-content-between align-items-center">
                            <span style="color: #94a3b8; font-size: 0.82rem;"><i class="bi bi-activity text-info me-1"></i> Duty Status:</span>
                            <span class="badge @(Profile?.IsAvailableToday == true ? "bg-success" : "bg-secondary") rounded-pill">
                                @(Profile?.IsAvailableToday == true ? "● On Duty" : "○ Off Duty")
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Doctor Branding Palette Card -->
                <div class="glass-panel p-4">
                    <h6 class="fw-bold text-white mb-3 text-uppercase" style="font-size: 0.8rem; letter-spacing: 0.8px;">
                        <i class="bi bi-palette-fill text-info me-2"></i>Brand Identity &amp; Styling
                    </h6>
                    <div class="d-flex flex-column gap-2 small">
                        <div class="d-flex align-items-center justify-content-between glass-card p-2">
                            <span style="color: #cbd5e1;">Primary Accent:</span>
                            <div class="d-flex align-items-center gap-2">
                                <span class="rounded" style="width: 22px; height: 22px; background: @(Profile?.PrimaryColorHex ?? "#00f2fe"); border: 1px solid rgba(255,255,255,0.3);"></span>
                                <span class="text-white fw-semibold">@(Profile?.PrimaryColorHex ?? "#00f2fe")</span>
                            </div>
                        </div>

                        <div class="d-flex align-items-center justify-content-between glass-card p-2">
                            <span style="color: #cbd5e1;">Secondary Accent:</span>
                            <div class="d-flex align-items-center gap-2">
                                <span class="rounded" style="width: 22px; height: 22px; background: @(Profile?.SecondaryColorHex ?? "#4facfe"); border: 1px solid rgba(255,255,255,0.3);"></span>
                                <span class="text-white fw-semibold">@(Profile?.SecondaryColorHex ?? "#4facfe")</span>
                            </div>
                        </div>

                        <div class="d-flex align-items-center justify-content-between glass-card p-2">
                            <span style="color: #cbd5e1;">Brand Typography:</span>
                            <span class="text-info fw-semibold">@(Profile?.PreferredFont ?? "Inter / Modern")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── RIGHT COLUMN: Detailed Profile & Clinic Form ── -->
        <div class="col-12 col-lg-8">
            <div class="d-flex flex-column gap-4">
                <!-- Section 1: Personal & Medical Credentials -->
                <div class="glass-panel p-4">
                    <h5 class="fw-bold text-white mb-3 border-bottom pb-2" style="border-color: rgba(255, 255, 255, 0.08) !important;">
                        <i class="bi bi-person-vcard text-info me-2"></i>Personal &amp; Medical Credentials
                    </h5>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-white">Full Name</label>
                            <input type="text" class="glass-input" @bind="Profile.FullName" placeholder="Dr. Full Name" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-white">Display Name</label>
                            <input type="text" class="glass-input" @bind="Profile.DisplayName" placeholder="e.g. Dr. A. Sharma, MD" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-white">Email Address</label>
                            <input type="email" class="glass-input" value="@(CurrentUser?.Email ?? "doctor@cyhdoctorhub.com")" disabled style="opacity: 0.75;" />
                            <small style="color: #94a3b8; font-size: 0.72rem;">Authentication account email (read-only)</small>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-white">Contact Mobile No</label>
                            <input type="text" class="glass-input" @bind="Profile.MobileNo" placeholder="+91 98765 43210" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-white">Medical Specialization</label>
                            <input type="text" class="glass-input" @bind="Profile.Specialization" placeholder="e.g. Cardiology, Neurology" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-white">Medical License / Council Reg No</label>
                            <input type="text" class="glass-input" @bind="Profile.LicenseNumber" placeholder="MED-DEL-98421" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-white">Qualifications &amp; Degrees</label>
                            <input type="text" class="glass-input" @bind="Profile.Qualifications" placeholder="MBBS, MD (Cardiology), DM, FACC" />
                        </div>

                        <div class="col-12 col-md-3">
                            <label class="form-label small fw-semibold text-white">Experience (Years)</label>
                            <input type="number" class="glass-input" @bind="Profile.ExperienceYears" min="0" max="60" />
                        </div>

                        <div class="col-12 col-md-3">
                            <label class="form-label small fw-semibold text-white">Consultation Fee ($)</label>
                            <input type="number" step="0.5" class="glass-input" @bind="Profile.ConsultationFee" min="0" />
                        </div>
                    </div>
                </div>

                <!-- Section 2: Clinic & Hospital Information -->
                <div class="glass-panel p-4">
                    <h5 class="fw-bold text-white mb-3 border-bottom pb-2" style="border-color: rgba(255, 255, 255, 0.08) !important;">
                        <i class="bi bi-hospital text-info me-2"></i>Clinic &amp; Hospital Information
                    </h5>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-white">Hospital / Clinic Name</label>
                            <input type="text" class="glass-input" @bind="Profile.ClinicName" placeholder="CYH Heart Care Institute" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-white">Official Website / Portal URL</label>
                            <input type="url" class="glass-input" @bind="Profile.WebsiteUrl" placeholder="https://www.clickyourhospital.com" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-white">Available Consultation Days</label>
                            <input type="text" class="glass-input" @bind="Profile.AvailableDays" placeholder="Mon - Sat" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-white">Available Hours / Shift</label>
                            <input type="text" class="glass-input" @bind="Profile.AvailableHours" placeholder="09:00 AM - 04:00 PM" />
                        </div>

                        <div class="col-12">
                            <label class="form-label small fw-semibold text-white">Clinic / Chamber Address</label>
                            <input type="text" class="glass-input" @bind="Profile.ClinicAddress" placeholder="Plot 42, Health City, Medical Enclave" />
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-semibold text-white">City</label>
                            <input type="text" class="glass-input" @bind="Profile.City" placeholder="New Delhi" />
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-semibold text-white">State</label>
                            <input type="text" class="glass-input" @bind="Profile.State" placeholder="Delhi" />
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-semibold text-white">PIN Code</label>
                            <input type="text" class="glass-input" @bind="Profile.PinCode" placeholder="110029" />
                        </div>
                    </div>
                </div>

                <!-- Section 3: Professional Bio -->
                <div class="glass-panel p-4">
                    <h5 class="fw-bold text-white mb-3 border-bottom pb-2" style="border-color: rgba(255, 255, 255, 0.08) !important;">
                        <i class="bi bi-file-earmark-medical text-info me-2"></i>Professional Bio &amp; Clinical Scope
                    </h5>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-white">Doctor Biography &amp; Practice Description</label>
                        <textarea class="glass-input" rows="4" @bind="Profile.Bio" placeholder="Describe your clinical expertise, surgical procedures, patient care philosophy, and scope of practice..."></textarea>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-2">
                        <button type="button" class="glass-btn-secondary" @onclick="LoadProfileDataAsync">
                            <i class="bi bi-arrow-counterclockwise"></i> Reset
                        </button>
                        <button type="button" class="glass-btn-primary" @onclick="SaveChanges" disabled="@IsSaving">
                            @if (IsSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <i class="bi bi-check2-circle me-1"></i>
                                <span>Save Changes</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private CurrentUserDTO? CurrentUser;
    private CYHDocBrandData.Entities.DoctorProfile Profile = new();
    private bool IsSaving = false;
    private bool IsUploadingPic = false;
    private string? SuccessMessage;
    private string? ErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            CurrentUser = AuthService.GetCurrentUser();
            if (CurrentUser == null)
            {
                var doctors = await DoctorRepo.GetAllWithUsersAsync();
                var doc = doctors.FirstOrDefault();
                if (doc != null)
                {
                    CurrentUser = new CurrentUserDTO
                    {
                        UserId = doc.UserId,
                        FullName = doc.FullName,
                        Email = doc.User?.Email ?? "doctor@cyhdoctorhub.com",
                        Role = "Doctor",
                        Department = doc.Specialization,
                        DoctorProfileId = doc.Id
                    };

                    if (AuthStateProvider is CustomAuthenticationStateProvider customAuth)
                    {
                        customAuth.SetUser(CurrentUser);
                    }
                }
                else
                {
                    NavigationManager.NavigateTo("login");
                    return;
                }
            }

            if (CurrentUser?.Role != "Doctor")
            {
                NavigationManager.NavigateTo("admin/dashboard");
                return;
            }

            await LoadProfileDataAsync();
        }
        catch
        {
            // Fail gracefully on reload
        }
    }

    private async Task LoadProfileDataAsync()
    {
        try
        {
            SuccessMessage = null;
            ErrorMessage = null;

            var doctors = await DoctorRepo.GetAllWithUsersAsync();
            CYHDocBrandData.Entities.DoctorProfile? doc = null;

            if (CurrentUser?.DoctorProfileId.HasValue == true)
            {
                doc = doctors.FirstOrDefault(d => d.Id == CurrentUser.DoctorProfileId.Value);
            }

            doc ??= doctors.FirstOrDefault(d => d.UserId == CurrentUser?.UserId) ?? doctors.FirstOrDefault();

            if (doc != null)
            {
                Profile = doc;
                if (string.IsNullOrWhiteSpace(Profile.DisplayName))
                {
                    Profile.DisplayName = Profile.FullName;
                }
            }
        }
        catch
        {
            // Fail gracefully
        }
    }

    private async Task SaveChanges()
    {
        IsSaving = true;
        SuccessMessage = null;
        ErrorMessage = null;

        try
        {
            var success = await DoctorRepo.UpdateProfileAsync(Profile);
            if (success)
            {
                SuccessMessage = "Doctor profile and clinical information successfully updated and saved to SQL Server!";
            }
            else
            {
                ErrorMessage = "Could not update profile. Please verify connection and retry.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Error saving profile: " + ex.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task HandleProfilePicUpload(InputFileChangeEventArgs e)
    {
        IsUploadingPic = true;
        SuccessMessage = null;
        ErrorMessage = null;

        try
        {
            var file = e.File;
            if (file == null) return;

            // 1. Validate extension using ImageUtility
            if (!ImageUtility.IsValidImageExtension(file.Name))
            {
                ErrorMessage = "Invalid image format. Supported formats: JPG, JPEG, PNG, WEBP.";
                return;
            }

            // 2. Prepare physical target directory
            var webRoot = WebHostEnvironment.WebRootPath;
            if (string.IsNullOrWhiteSpace(webRoot))
            {
                webRoot = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot");
            }
            var uploadsFolder = Path.Combine(webRoot, "uploads", "doctors");

            // 3. Client-side dimension scaling to maintain image size safely under 1 MB
            IBrowserFile uploadFile = file;
            var ext = Path.GetExtension(file.Name).ToLowerInvariant();
            var targetMime = ext == ".png" ? "image/png" : (ext == ".webp" ? "image/webp" : "image/jpeg");

            try
            {
                // Auto-scale to max 1000x1000 pixels (smoothly keeps file size between 60KB and 350KB)
                uploadFile = await file.RequestImageFileAsync(targetMime, 1000, 1000);
            }
            catch
            {
                // Fallback to original file if client scaler not applicable
                uploadFile = file;
            }

            // 4. Delete existing physical file via ImageUtility
            ImageUtility.DeletePhysicalImage(webRoot, Profile.ProfilePic);

            // 5. Enforce strict 1 MB limit and write file using ImageUtility
            var docIdentifier = Profile.Id > 0 ? Profile.Id.ToString() : (Profile.UserId ?? "doc");
            await using var stream = uploadFile.OpenReadStream(maxAllowedSize: ImageUtility.MaxImageSizeBytes * 2);

            var saveResult = await ImageUtility.SaveImageWithinLimitAsync(
                inputStream: stream,
                originalFileName: uploadFile.Name,
                targetDirectory: uploadsFolder,
                urlPrefix: "/uploads/doctors",
                fileIdentifier: docIdentifier
            );

            if (!saveResult.Success)
            {
                ErrorMessage = saveResult.ErrorMessage ?? "Could not save image.";
                return;
            }

            // 6. Update Profile and SQL Server
            Profile.ProfilePic = saveResult.RelativePath;

            var success = await DoctorRepo.UpdateProfileAsync(Profile);
            if (success)
            {
                if (CurrentUser != null)
                {
                    CurrentUser.AvatarUrl = saveResult.RelativePath;
                    if (AuthStateProvider is CustomAuthenticationStateProvider customAuth)
                    {
                        customAuth.SetUser(CurrentUser);
                    }
                }
                SuccessMessage = $"Profile picture uploaded and saved successfully ({ImageUtility.FormatFileSize(saveResult.FinalSizeBytes)} - strictly under 1 MB)!";
            }
            else
            {
                ErrorMessage = "Image saved to disk, but database profile update encountered an issue.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error uploading photo: {ex.Message}";
        }
        finally
        {
            IsUploadingPic = false;
        }
    }

    private async Task RemoveProfilePic()
    {
        IsUploadingPic = true;
        SuccessMessage = null;
        ErrorMessage = null;

        try
        {
            var webRoot = WebHostEnvironment.WebRootPath;
            if (string.IsNullOrWhiteSpace(webRoot))
            {
                webRoot = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot");
            }

            // Delete physical file via ImageUtility
            ImageUtility.DeletePhysicalImage(webRoot, Profile.ProfilePic);

            Profile.ProfilePic = null;

            var success = await DoctorRepo.UpdateProfileAsync(Profile);
            if (success)
            {
                if (CurrentUser != null)
                {
                    CurrentUser.AvatarUrl = null;
                    if (AuthStateProvider is CustomAuthenticationStateProvider customAuth)
                    {
                        customAuth.SetUser(CurrentUser);
                    }
                }
                SuccessMessage = "Profile photo deleted and default avatar restored.";
            }
            else
            {
                ErrorMessage = "Could not remove profile picture from database.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error removing profile photo: {ex.Message}";
        }
        finally
        {
            IsUploadingPic = false;
        }
    }
}
