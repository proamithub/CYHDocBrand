@inherits LayoutComponentBase
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IDoctorRepository DoctorRepo

<div class="cyh-app-container">
    <!-- Dedicated Doctor Sidebar -->
    <aside class="cyh-sidebar" style="border-right: 1px solid rgba(0, 242, 254, 0.2);">
        <DoctorNavMenu />
    </aside>

    <!-- Main Content Area -->
    <div class="cyh-main-content">
        <!-- Top Navigation Bar for Doctor -->
        <header class="cyh-topbar" style="border-bottom: 1px solid rgba(0, 242, 254, 0.2);">
            <div class="d-flex align-items-center gap-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge" style="background: rgba(0, 242, 254, 0.15); color: #38bdf8; border: 1px solid rgba(0, 242, 254, 0.35); padding: 0.45rem 0.85rem; font-size: 0.82rem; font-weight: 700;">
                        <i class="bi bi-heart-pulse-fill me-1"></i> Doctor Clinical Workspace
                    </span>
                </div>
            </div>

            <div class="d-flex align-items-center gap-3">
                <!-- User Profile Pill -->
                <div class="user-profile-pill" style="border-color: rgba(0, 242, 254, 0.35);">
                    <div class="user-avatar" style="background: linear-gradient(135deg, #00f2fe, #4facfe); color: #070d1e; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                        @if (!string.IsNullOrEmpty(CurrentUser?.AvatarUrl))
                        {
                            <img src="@CurrentUser.AvatarUrl" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover;" />
                        }
                        else
                        {
                            @(string.IsNullOrEmpty(CurrentUser?.FullName) ? 'D' : CurrentUser.FullName[0])
                        }
                    </div>
                    <div>
                        <div style="font-size: 0.85rem; font-weight: 600; line-height: 1.1; color: #ffffff;">
                            @(CurrentUser?.FullName ?? "Dr. A. Sharma")
                        </div>
                        <div style="font-size: 0.72rem; color: #00f2fe; font-weight: 600;">
                            @(CurrentUser?.Department ?? "Cardiologist Specialist")
                        </div>
                    </div>
                    <button class="btn btn-link text-muted p-0 ms-2" @onclick="Logout" title="Logout">
                        <i class="bi bi-box-arrow-right text-danger"></i>
                    </button>
                </div>
            </div>
        </header>

        <!-- Body Content -->
        <main class="cyh-body">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private CurrentUserDTO? CurrentUser;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            AuthStateProvider.AuthenticationStateChanged += async (task) =>
            {
                CurrentUser = AuthService.GetCurrentUser();
                await InvokeAsync(StateHasChanged);
            };

            CurrentUser = AuthService.GetCurrentUser();

            // Resilient Session Recovery on Page Reload / Refresh:
            if (CurrentUser == null)
            {
                var doctors = await DoctorRepo.GetAllWithUsersAsync();
                var doc = doctors.FirstOrDefault();
                if (doc != null)
                {
                    var restoredUser = new CurrentUserDTO
                    {
                        UserId = doc.UserId,
                        FullName = doc.FullName,
                        Email = doc.User?.Email ?? "doctor@cyhdoctorhub.com",
                        Role = "Doctor",
                        Department = doc.Specialization,
                        DoctorProfileId = doc.Id,
                        AvatarUrl = doc.ProfilePic ?? doc.User?.AvatarUrl
                    };

                    if (AuthStateProvider is CustomAuthenticationStateProvider customAuth)
                    {
                        customAuth.SetUser(restoredUser);
                    }
                    CurrentUser = restoredUser;
                }
                else
                {
                    NavigationManager.NavigateTo("login");
                    return;
                }
            }

            if (CurrentUser.Role != "Doctor")
            {
                NavigationManager.NavigateTo("admin/dashboard");
                return;
            }
        }
        catch
        {
            // Gracefully handle reload
        }
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("login");
    }
}
