@inherits LayoutComponentBase
@implements IDisposable
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IDoctorRepository DoctorRepo

<div class="cyh-app-container">
    <!-- Mobile Sidebar Dark Backdrop -->
    <div class="cyh-sidebar-backdrop @(isMobileNavOpen ? "show" : "")" @onclick="CloseMobileNav"></div>

    <!-- Dedicated Doctor Sidebar (Desktop Fixed + Mobile Off-Canvas Drawer) -->
    <aside class="cyh-sidebar @(isMobileNavOpen ? "mobile-open" : "")" style="border-right: 1px solid rgba(0, 242, 254, 0.2);">
        <DoctorNavMenu OnLockedClicked="HandleLockedNotice" OnCloseMenu="CloseMobileNav" />
    </aside>

    <!-- Main Content Area -->
    <div class="cyh-main-content">
        <!-- Top Navigation Bar for Doctor -->
        <header class="cyh-topbar" style="border-bottom: 1px solid rgba(0, 242, 254, 0.2);">
            <div class="d-flex align-items-center gap-2">
                <!-- Hamburger Menu Toggle (Mobile & Tablet) -->
                <button class="cyh-mobile-toggle d-lg-none" type="button" @onclick="ToggleMobileNav" aria-label="Toggle navigation">
                    <i class="bi bi-list"></i>
                </button>

                <span class="badge d-flex align-items-center gap-1" style="background: rgba(0, 242, 254, 0.15); color: #38bdf8; border: 1px solid rgba(0, 242, 254, 0.35); padding: 0.45rem 0.75rem; font-size: 0.82rem; font-weight: 700;">
                    <i class="bi bi-heart-pulse-fill"></i>
                    <span class="d-none d-sm-inline">Doctor Clinical Workspace</span>
                    <span class="d-inline d-sm-none">Doctor Workspace</span>
                </span>
            </div>

            <div class="d-flex align-items-center gap-2">
                <!-- User Profile Pill -->
                <div class="user-profile-pill" style="border-color: rgba(0, 242, 254, 0.35);">
                    <div class="user-avatar" style="background: linear-gradient(135deg, #00f2fe, #4facfe); color: #070d1e; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                        @if (!string.IsNullOrEmpty(CurrentUser?.AvatarUrl))
                        {
                            <img src="@CurrentUser.AvatarUrl" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover;" />
                        }
                        else
                        {
                            @(string.IsNullOrEmpty(CurrentUser?.FullName) ? 'D' : CurrentUser.FullName[0])
                        }
                    </div>
                    <div class="d-none d-sm-block">
                        <div style="font-size: 0.85rem; font-weight: 600; line-height: 1.1; color: #ffffff; max-width: 140px;" class="text-truncate">
                            @(CurrentUser?.FullName ?? "Dr.")
                        </div>
                        <div class="d-none d-md-block text-truncate" style="font-size: 0.72rem; color: #00f2fe; font-weight: 600; max-width: 140px;">
                            @(CurrentUser?.Department ?? "Specialist")
                        </div>
                    </div>
                    <button class="btn btn-link text-muted p-0 ms-1" @onclick="Logout" title="Logout" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;">
                        <i class="bi bi-box-arrow-right text-danger fs-6"></i>
                    </button>
                </div>
            </div>
        </header>

        <!-- Body Content -->
        <main class="cyh-body">
            @Body
        </main>
    </div>
</div>

@code {
    private CurrentUserDTO? CurrentUser;
    private bool _disposed = false;
    private bool isMobileNavOpen = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            AuthStateProvider.AuthenticationStateChanged += OnAuthStateChanged;
            NavigationManager.LocationChanged += OnLocationChanged;

            CurrentUser = await AuthService.GetOrRestoreCurrentUserAsync();

            if (CurrentUser == null)
            {
                NavigationManager.NavigateTo("login", forceLoad: true);
                return;
            }

            if (CurrentUser.Role != "Doctor")
            {
                NavigationManager.NavigateTo("admin/dashboard", forceLoad: true);
                return;
            }

            CheckAccess();
        }
        catch
        {
            // Gracefully handle reload
        }
    }

    private void ToggleMobileNav()
    {
        isMobileNavOpen = !isMobileNavOpen;
        StateHasChanged();
    }

    private void CloseMobileNav()
    {
        isMobileNavOpen = false;
        StateHasChanged();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (isMobileNavOpen)
        {
            isMobileNavOpen = false;
            InvokeAsync(StateHasChanged);
        }
    }

    protected override void OnParametersSet()
    {
        CheckAccess();
    }

    private void CheckAccess()
    {
        if (CurrentUser != null && !CurrentUser.IsActive)
        {
            var uri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
            if (!uri.StartsWith("doctor/profile", StringComparison.OrdinalIgnoreCase) &&
                !uri.StartsWith("login", StringComparison.OrdinalIgnoreCase) &&
                !string.IsNullOrWhiteSpace(uri))
            {
                NavigationManager.NavigateTo("doctor/profile");
            }
        }
    }

    private void OnAuthStateChanged(Task<AuthenticationState> task)
    {
        if (_disposed) return;
        _ = InvokeAsync(() =>
        {
            if (_disposed) return;
            CurrentUser = AuthService.GetCurrentUser();
            StateHasChanged();
        });
    }

    private void DismissPopup()
    {
        popupCts?.Cancel();
        ActivePopup = null;
    }

    private ToastNotificationDTO? ActivePopup;
    private CancellationTokenSource? popupCts;

    private void HandleLockedNotice(string moduleName)
    {
        popupCts?.Cancel();
        popupCts?.Dispose();
        popupCts = new CancellationTokenSource();

        ActivePopup = new ToastNotificationDTO
        {
            Title = "Module Locked (Pending Approval)",
            Message = $"'{moduleName}' is locked. Your doctor account is pending activation by  Admin. Only your Profile page is accessible until activated.",
            Type = "warning"
        };
        StateHasChanged();

        var token = popupCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(5000, token);
                if (!token.IsCancellationRequested)
                {
                    await InvokeAsync(() =>
                    {
                        ActivePopup = null;
                        StateHasChanged();
                    });
                }
            }
            catch (TaskCanceledException) { }
        }, token);
    }

    public void Dispose()
    {
        _disposed = true;
        popupCts?.Cancel();
        popupCts?.Dispose();
        AuthStateProvider.AuthenticationStateChanged -= OnAuthStateChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("login", forceLoad: true);
    }
}

<!-- Floating Toast Notification Popup -->
<ToastPopup Notification="ActivePopup" OnDismiss="DismissPopup" />
