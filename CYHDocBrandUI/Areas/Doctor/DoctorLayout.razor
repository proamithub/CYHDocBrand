    private async Task CopyCaptionText()
    {
        if (activeShareModalSchedule == null) return;
        var text = $"{activeShareModalSchedule.BannerHeading}\n\n{activeShareModalSchedule.Caption}";
        await JSRuntime.InvokeVoidAsync("cyhSocial.copyToClipboard", text);
        isCopied = true;
        StateHasChanged();
    }

    private async Task MarkAsCompletedAsync(int scheduleId)
    {
        await ScheduleRepo.UpdateScheduleStatusAsync(scheduleId, "Success", null);
        activeShareModalSchedule = null;
        liveBannerAlert = null;
        await CheckDueSchedulesAsync();
    }

    private async Task ToggleSoundChoice()
    {
        isSoundEnabled = !isSoundEnabled;
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "cyh_alert_sound", isSoundEnabled ? "1" : "0");
            if (isSoundEnabled)
            {
                await JSRuntime.InvokeVoidAsync("cyhSocial.playAlertSound");
            }
        }
        catch { }
        StateHasChanged();
    }

    private async Task SnoozeSchedule(int scheduleId)
    {
        int currentCount = scheduleSnoozeCounts.GetValueOrDefault(scheduleId, 0);
        if (currentCount < 3)
        {
            scheduleSnoozeCounts[scheduleId] = currentCount + 1;
            await ScheduleRepo.SnoozeScheduleAsync(scheduleId, 5);
            notifiedScheduleIds.Remove(scheduleId);
            activeShareModalSchedule = null;
            liveBannerAlert = null;
            await CheckDueSchedulesAsync();
        }
    }

    private async Task CancelScheduleAsync(int scheduleId)
    {
        await ScheduleRepo.CancelScheduleAsync(scheduleId);
        activeShareModalSchedule = null;
        liveBannerAlert = null;
        notifiedScheduleIds.Add(scheduleId);
        await CheckDueSchedulesAsync();
    }

    private void ToggleMobileNav()
    {
        isMobileNavOpen = !isMobileNavOpen;
        StateHasChanged();
    }

    private void CloseMobileNav()
    {
        isMobileNavOpen = false;
        StateHasChanged();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (isMobileNavOpen)
        {
            isMobileNavOpen = false;
            InvokeAsync(StateHasChanged);
        }
    }

    protected override void OnParametersSet()
    {
        CheckAccess();
    }

    private void CheckAccess()
    {
        if (CurrentUser != null && !CurrentUser.IsActive)
        {
            var uri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
            if (!uri.StartsWith("doctor/profile", StringComparison.OrdinalIgnoreCase) &&
                !uri.StartsWith("login", StringComparison.OrdinalIgnoreCase) &&
                !string.IsNullOrWhiteSpace(uri))
            {
                NavigationManager.NavigateTo("doctor/profile");
            }
        }
    }

    private void OnAuthStateChanged(Task<AuthenticationState> task)
    {
        if (_disposed) return;
        _ = InvokeAsync(() =>
        {
            if (_disposed) return;
            CurrentUser = AuthService.GetCurrentUser();
            StateHasChanged();
        });
    }

    private void DismissPopup()
    {
        popupCts?.Cancel();
        ActivePopup = null;
    }

    private ToastNotificationDTO? ActivePopup;
    private CancellationTokenSource? popupCts;

    private void HandleLockedNotice(string moduleName)
    {
        popupCts?.Cancel();
        popupCts?.Dispose();
        popupCts = new CancellationTokenSource();

        ActivePopup = new ToastNotificationDTO
        {
            Title = "Module Locked (Pending Approval)",
            Message = $"'{moduleName}' is locked. Your doctor account is pending activation by Admin. Only your Profile page is accessible until activated.",
            Type = "warning"
        };
        StateHasChanged();

        var token = popupCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(5000, token);
                if (!token.IsCancellationRequested)
                {
                    await InvokeAsync(() =>
                    {
                        ActivePopup = null;
                        StateHasChanged();
                    });
                }
            }
            catch (TaskCanceledException) { }
        }, token);
    }

    public void Dispose()
    {
        _disposed = true;
        checkTimer?.Dispose();
        popupCts?.Cancel();
        popupCts?.Dispose();
        AuthStateProvider.AuthenticationStateChanged -= OnAuthStateChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("login", forceLoad: true);
    }
}
