@inherits LayoutComponentBase
@implements IDisposable
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IDoctorRepository DoctorRepo
@inject IBannerScheduleRepository ScheduleRepo
@inject IJSRuntime JSRuntime
@using CYHDocBrandModel.Common
@using CYHDocBrandModel.DTO
@using CYHDocBrandRepo.IRepository
@using CYHDocBrandUI.Components.Common

<div class="cyh-app-container">
    <!-- Mobile Sidebar Dark Backdrop -->
    <div class="cyh-sidebar-backdrop @(isMobileNavOpen ? "show" : "")" @onclick="CloseMobileNav"></div>

    <!-- Dedicated Doctor Sidebar (Desktop Fixed + Mobile Off-Canvas Drawer) -->
    <aside class="cyh-sidebar @(isMobileNavOpen ? "mobile-open" : "")" style="border-right: 1px solid rgba(0, 242, 254, 0.2);">
        <DoctorNavMenu OnLockedClicked="HandleLockedNotice" OnCloseMenu="CloseMobileNav" />
    </aside>

    <!-- Main Content Area -->
    <div class="cyh-main-content">
        <!-- Top Navigation Bar for Doctor -->
        <header class="cyh-topbar" style="border-bottom: 1px solid rgba(0, 242, 254, 0.2);">
            <div class="d-flex align-items-center gap-2">
                <!-- Hamburger Menu Toggle (Mobile & Tablet) -->
                <button class="cyh-mobile-toggle d-lg-none" type="button" @onclick="ToggleMobileNav" aria-label="Toggle navigation">
                    <i class="bi bi-list"></i>
                </button>

                <span class="badge d-flex align-items-center gap-1" style="background: rgba(0, 242, 254, 0.15); color: #38bdf8; border: 1px solid rgba(0, 242, 254, 0.35); padding: 0.45rem 0.75rem; font-size: 0.82rem; font-weight: 700;">
                    <i class="bi bi-heart-pulse-fill"></i>
                    <span class="d-none d-sm-inline">Doctor Workspace</span>
                    <span class="d-inline d-sm-none">Doctor Workspace</span>
                </span>

                <!-- Live Running Server Time (Indian Standard Time - Hidden on mobile view to save space) -->
                <div class="d-none d-md-block">
                    <ServerTimeClock />
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <!-- Theme Switcher (Glass, Dark, Light) -->
                <ThemeSelector />

                <!-- Sound Alert Choice Toggle (Sound ON / OFF) -->
                <button type="button" class="btn btn-outline-secondary p-2 rounded-circle d-flex align-items-center justify-content-center"
                        style="width: 38px; height: 38px; border-color: @(isSoundEnabled ? "rgba(0, 242, 254, 0.5)" : "rgba(255,255,255,0.15)"); background: rgba(14, 25, 48, 0.7);"
                        @onclick="ToggleSoundChoice" 
                        title="@(isSoundEnabled ? "Sound Alert: ON (Click to Mute)" : "Sound Alert: OFF (Click to Unmute)")">
                    <i class="bi @(isSoundEnabled ? "bi-volume-up-fill text-info" : "bi-volume-mute text-secondary") fs-5"></i>
                </button>

                <!-- Live Schedule Reminder Bell -->
                <div class="position-relative">
                    <button type="button" class="btn btn-outline-secondary position-relative p-2 rounded-circle d-flex align-items-center justify-content-center"
                            style="width: 38px; height: 38px; border-color: @(dueSchedules.Count > 0 ? "rgba(0, 242, 254, 0.6)" : "rgba(255,255,255,0.15)"); background: rgba(14, 25, 48, 0.7);"
                            @onclick="ToggleNotificationDropdown" title="Scheduled Post Notifications">
                        <i class="bi @(dueSchedules.Count > 0 ? "bi-bell-fill text-warning bell-ring-anim" : "bi-bell text-secondary") fs-5"></i>
                        @if (dueSchedules.Count > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.68rem; box-shadow: 0 0 10px rgba(239, 68, 68, 0.8);">
                                @dueSchedules.Count
                            </span>
                        }
                    </button>

                    <!-- Due Notifications Dropdown -->
                    @if (showNotificationDropdown)
                    {
                        <div class="position-absolute end-0 mt-2 p-3 rounded-4 shadow-lg glass-panel" style="width: 320px; max-width: 90vw; background: rgba(14, 25, 48, 0.98); border: 1px solid rgba(0, 242, 254, 0.4); z-index: 1050;">
                            <div class="d-flex align-items-center justify-content-between mb-2 pb-2 border-bottom border-secondary border-opacity-25">
                                <span class="text-white fw-bold small">
                                    <i class="bi bi-clock-history text-info me-1"></i> Ready to Share Now (@dueSchedules.Count)
                                </span>
                                <button type="button" class="btn-close btn-close-white small" style="font-size: 0.75rem;" @onclick="() => showNotificationDropdown = false"></button>
                            </div>

                            @if (dueSchedules.Count == 0)
                            {
                                <div class="text-center py-3 text-secondary small">
                                    <i class="bi bi-check-circle fs-4 text-success d-block mb-1"></i>
                                    Abhi koi post pending nahi hai.
                                </div>
                            }
                            else
                            {
                                <div style="max-height: 280px; overflow-y: auto;">
                                    @foreach (var s in dueSchedules)
                                    {
                                        <div class="p-2 mb-2 rounded-3 bg-dark border border-secondary border-opacity-25 d-flex gap-2 align-items-center justify-content-between">
                                            <div class="min-w-0 flex-grow-1 cursor-pointer" @onclick="() => OpenShareModal(s)" style="cursor: pointer;">
                                                <div class="text-white fw-semibold small text-truncate">@s.BannerHeading</div>
                                                <div class="text-info small" style="font-size: 0.72rem;">Doctor: @s.DoctorName &bull; <i class="bi bi-clock me-1 text-warning"></i>@s.ScheduledAt.ToIndianTime().ToString("hh:mm tt") IST</div>
                                            </div>
                                            <button type="button" class="btn btn-success btn-sm py-1 px-2 fw-semibold" @onclick="() => OpenShareModal(s)" style="background: #25d366; border: none; font-size: 0.75rem; color: #070d1e;">
                                                <i class="bi bi-whatsapp"></i> Send
                                            </button>
                                        </div>
                                    }
                                </div>
                            }

                            <div class="mt-2 pt-2 border-top border-secondary border-opacity-25">
                                <button type="button" class="btn btn-outline-info btn-sm w-100 py-1" style="font-size: 0.75rem;" @onclick="EnableDesktopNotificationsAsync">
                                    <i class="bi bi-bell-fill text-warning me-1"></i> Test Chime Sound &amp; Alerts
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <!-- User Profile Pill -->
                <div class="user-profile-pill" style="border-color: rgba(0, 242, 254, 0.35);">
                    <div class="user-avatar" style="background: linear-gradient(135deg, #00f2fe, #4facfe); color: #070d1e; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                        @if (!string.IsNullOrEmpty(CurrentUser?.AvatarUrl))
                        {
                            <img src="@CurrentUser.AvatarUrl" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover;" />
                        }
                        else
                        {
                            @(string.IsNullOrEmpty(CurrentUser?.FullName) ? 'D' : CurrentUser.FullName[0])
                        }
                    </div>
                    <div class="d-none d-sm-block">
                        <div style="font-size: 0.85rem; font-weight: 600; line-height: 1.1; color: var(--cyh-text-primary); max-width: 140px;" class="text-truncate">
                            @(CurrentUser?.FullName ?? "Dr.")
                        </div>
                        <div class="d-none d-md-block text-truncate" style="font-size: 0.72rem; color: #00f2fe; font-weight: 600; max-width: 140px;">
                            @(CurrentUser?.Department ?? "Specialist")
                        </div>
                    </div>
                    <button class="btn btn-link text-muted p-0 ms-1" @onclick="Logout" title="Logout" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;">
                        <i class="bi bi-box-arrow-right text-danger fs-6"></i>
                    </button>
                </div>
            </div>
        </header>

        <!-- Floating Live Reminder Alert Strip (When post becomes due) -->
        @if (liveBannerAlert != null)
        {
            <div class="alert alert-warning m-3 mb-0 p-3 rounded-4 shadow-lg d-flex align-items-center justify-content-between gap-3 border-warning position-relative"
                 style="background: linear-gradient(135deg, rgba(0, 242, 254, 0.25) 0%, rgba(14, 25, 48, 0.98) 100%); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 2px solid #00f2fe !important; box-shadow: 0 10px 30px rgba(0, 242, 254, 0.3) !important;">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-2 rounded-circle bg-info text-dark fs-4 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; box-shadow: 0 0 15px rgba(0, 242, 254, 0.8);">
                        <i class="bi bi-bell-fill bell-ring-anim"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-white fs-6">
                            ⏰ Scheduled Banner Ka Time Ho Gaya: "@liveBannerAlert.BannerHeading"
                        </div>
                        <div class="text-light small">
                            Scheduled for @liveBannerAlert.ScheduledAt.ToIndianTime().ToString("hh:mm tt") IST &bull; Doctor: <strong>@liveBannerAlert.DoctorName</strong>
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-success px-3 py-2 fw-bold d-flex align-items-center gap-2 shadow" @onclick="() => OpenShareModal(liveBannerAlert)" style="background: #25d366; border: none; color: #070d1e;">
                        <i class="bi bi-whatsapp fs-5"></i>
                        <span class="d-none d-sm-inline">Send on WhatsApp / Social (1-Click)</span>
                        <span class="d-inline d-sm-none">Send</span>
                    </button>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => liveBannerAlert = null" title="Dismiss"></button>
                </div>
            </div>
        }

        <!-- Body Content -->
        <main class="cyh-body">
            @Body
        </main>
    </div>
</div>

<!-- 1-Click Interactive Social & WhatsApp Share Modal -->
@if (activeShareModalSchedule != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0, 0, 0, 0.85); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); z-index: 1090;">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content glass-panel" style="background: rgba(14, 25, 48, 0.98); border: 1px solid rgba(37, 211, 102, 0.4); border-radius: 20px;">
                <div class="modal-header border-bottom border-secondary border-opacity-25 px-4 py-3 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-send-check-fill text-success fs-4"></i>
                        <div>
                            <h5 class="modal-title text-white fw-bold mb-0">1-Click Social &amp; WhatsApp Share</h5>
                            <span class="text-secondary small">Scheduled post share karne ke liye ready hai</span>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <!-- Sound Choice Button in Modal -->
                        <button type="button" class="btn btn-sm @(isSoundEnabled ? "btn-outline-info text-info" : "btn-outline-secondary text-muted") py-1 px-2 d-flex align-items-center gap-1" 
                                @onclick="ToggleSoundChoice" 
                                style="font-size: 0.76rem; border-radius: 8px;" 
                                title="@(isSoundEnabled ? "Sound Alert is ON - Click to Mute" : "Sound Alert is OFF - Click to Unmute")">
                            <i class="bi @(isSoundEnabled ? "bi-volume-up-fill text-info" : "bi-volume-mute-fill text-secondary")"></i>
                            <span>Sound: @(isSoundEnabled ? "ON" : "OFF")</span>
                        </button>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => activeShareModalSchedule = null"></button>
                    </div>
                </div>

                <div class="modal-body p-4">
                    <!-- Banner Visual Preview -->
                    <div class="row g-3 mb-4 align-items-center">
                        <div class="col-md-4 col-12 text-center">
                            @if (!string.IsNullOrEmpty(activeShareModalSchedule.ImageUrl))
                            {
                                <img src="@activeShareModalSchedule.ImageUrl" alt="Banner" class="img-fluid rounded-3 shadow border border-secondary border-opacity-50" style="max-height: 180px; object-fit: contain;" />
                            }
                            else
                            {
                                <div class="rounded-3 bg-dark p-4 text-info border border-secondary border-opacity-25">
                                    <i class="bi bi-image fs-1"></i>
                                </div>
                            }
                        </div>
                        <div class="col-md-8 col-12">
                            <h5 class="text-white fw-bold mb-1">@activeShareModalSchedule.BannerHeading</h5>
                            <div class="text-secondary small mb-2">
                                <i class="bi bi-hospital me-1"></i>@(activeShareModalSchedule.HospitalName ?? "CYH Hospital") &bull;
                                <span class="text-info fw-semibold">Dr. @activeShareModalSchedule.DoctorName</span>
                            </div>
                            <div class="badge bg-info bg-opacity-25 text-info border border-info border-opacity-50 px-3 py-1 rounded-pill small">
                                ⏰ Scheduled Time: @activeShareModalSchedule.ScheduledAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                            </div>
                        </div>
                    </div>

                    <!-- Caption Preview Box with Copy Button -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label text-white fw-bold small mb-0">Message &amp; Caption:</label>
                            <button type="button" class="btn btn-outline-info btn-sm py-1 px-2" @onclick="CopyCaptionText" style="font-size: 0.75rem;">
                                <i class="bi @(isCopied ? "bi-check2 text-success" : "bi-clipboard") me-1"></i>
                                @(isCopied ? "Copied!" : "Copy Caption")
                            </button>
                        </div>
                        <div class="p-3 rounded-3 bg-dark text-light border border-secondary border-opacity-25 small" style="white-space: pre-wrap; max-height: 130px; overflow-y: auto;">
                            @activeShareModalSchedule.Caption
                        </div>
                    </div>

                    <!-- 1-Click Action Buttons -->
                    <div class="mb-2">
                        <label class="form-label text-secondary small fw-bold mb-2">1-CLICK SHARE NOW (Bina kisi API key ke direct open hoga):</label>
                        <div class="d-grid gap-2">
                            <!-- WhatsApp 1-Click Send -->
                            <button type="button" class="btn btn-success py-3 px-4 fw-bold fs-6 d-flex align-items-center justify-content-center gap-2 rounded-3 shadow"
                                    @onclick="() => TriggerWhatsAppShare(activeShareModalSchedule)" style="background: linear-gradient(135deg, #25d366 0%, #128c7e 100%); border: none; color: #ffffff;">
                                <i class="bi bi-whatsapp fs-4"></i>
                                <span>Send on WhatsApp (1-Click Web / App)</span>
                            </button>

                            <div class="row g-2 mt-1">
                                <!-- Facebook Share -->
                                <div class="col-md-4 col-12">
                                    <button type="button" class="btn btn-primary w-100 py-2 d-flex align-items-center justify-content-center gap-2 rounded-3 fw-semibold"
                                            @onclick="() => TriggerFacebookShare(activeShareModalSchedule)" style="background: #1877f2; border: none;">
                                        <i class="bi bi-facebook fs-5"></i>
                                        <span>Facebook</span>
                                    </button>
                                </div>
                                <!-- Instagram Share -->
                                <div class="col-md-4 col-12">
                                    <button type="button" class="btn w-100 py-2 d-flex align-items-center justify-content-center gap-2 rounded-3 fw-semibold text-white"
                                            @onclick="() => TriggerInstagramShare(activeShareModalSchedule)" 
                                            style="background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%); border: none;">
                                        <i class="bi bi-instagram fs-5"></i>
                                        <span>Instagram</span>
                                    </button>
                                </div>
                                <!-- Twitter / X Share -->
                                <div class="col-md-4 col-12">
                                    <button type="button" class="btn btn-outline-light w-100 py-2 d-flex align-items-center justify-content-center gap-2 rounded-3 fw-semibold"
                                            @onclick="() => TriggerTwitterShare(activeShareModalSchedule)" style="border-color: rgba(255, 255, 255, 0.4);">
                                        <i class="bi bi-twitter-x fs-5"></i>
                                        <span>Twitter / X</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-top border-secondary border-opacity-25 px-4 py-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <!-- Snooze -->
                        @{
                            int currentSnooze = scheduleSnoozeCounts.GetValueOrDefault(activeShareModalSchedule.Id, 0);
                        }
                        @if (currentSnooze < 3)
                        {
                            <button type="button" class="btn btn-outline-warning btn-sm px-3 fw-bold d-flex align-items-center gap-1" 
                                    @onclick="() => SnoozeSchedule(activeShareModalSchedule.Id)" 
                                    style="border-color: #f59e0b; color: #fbbf24; border-radius: 8px;"
                                    title="Is alert ko 5 minute ke liye postpone karein (Maximum 3 baar)">
                                <i class="bi bi-alarm-fill text-warning"></i>
                                <span>Snooze 5 Min (@(currentSnooze + 1)/3)</span>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm px-3 disabled" disabled style="opacity: 0.55; border-radius: 8px;">
                                <i class="bi bi-alarm"></i>
                                <span>Max Snoozes (3/3) Reached</span>
                            </button>
                        }

                        <!-- Cancel Post Button -->
                        <button type="button" class="btn btn-outline-danger btn-sm px-3 fw-semibold d-flex align-items-center gap-1"
                                @onclick="() => CancelScheduleAsync(activeShareModalSchedule.Id)"
                                style="border-color: rgba(239, 68, 68, 0.5); border-radius: 8px;"
                                title="Is post ko cancel karein">
                            <i class="bi bi-x-circle-fill text-danger"></i>
                            <span>Cancel Post</span>
                        </button>
                    </div>

                    <div class="d-flex align-items-center gap-2 ms-auto">
                        <button type="button" class="btn btn-outline-secondary btn-sm px-3" @onclick="() => activeShareModalSchedule = null" style="border-radius: 8px;">
                            Close
                        </button>
                        <button type="button" class="btn btn-success btn-sm px-4 fw-bold d-flex align-items-center gap-2" 
                                @onclick="() => MarkAsCompletedAsync(activeShareModalSchedule.Id)" 
                                style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); border: none; border-radius: 8px; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.4);">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>Mark as Shared &amp; Done</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Floating Toast Notification Popup -->
<ToastPopup Notification="ActivePopup" OnDismiss="DismissPopup" />

@code {
    private CurrentUserDTO? CurrentUser;
    private bool _disposed = false;
    private bool isMobileNavOpen = false;

    private List<BannerScheduleDTO> dueSchedules = new();
    private BannerScheduleDTO? liveBannerAlert;
    private BannerScheduleDTO? activeShareModalSchedule;
    private bool showNotificationDropdown = false;
    private bool isCopied = false;
    private bool isSoundEnabled = true;
    private readonly HashSet<int> notifiedScheduleIds = new();
    private readonly Dictionary<int, int> scheduleSnoozeCounts = new();

    private System.Threading.Timer? checkTimer;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            AuthStateProvider.AuthenticationStateChanged += OnAuthStateChanged;
            NavigationManager.LocationChanged += OnLocationChanged;

            CurrentUser = await AuthService.GetOrRestoreCurrentUserAsync();

            if (CurrentUser == null)
            {
                NavigationManager.NavigateTo("login", forceLoad: true);
                return;
            }

            if (CurrentUser.Role != "Doctor")
            {
                NavigationManager.NavigateTo("admin/dashboard", forceLoad: true);
                return;
            }

            CheckAccess();

            // Initial immediate check for due schedules
            await CheckDueSchedulesAsync();

            // Run background check every 12 seconds for live alerts & notifications
            checkTimer = new System.Threading.Timer(async _ =>
            {
                await CheckDueSchedulesAsync();
                await InvokeAsync(StateHasChanged);
            }, null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(12));
        }
        catch
        {
            // Gracefully handle reload
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var soundPref = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "cyh_alert_sound");
                if (soundPref == "0")
                {
                    isSoundEnabled = false;
                    StateHasChanged();
                }

                // Ask browser desktop notification permission
                await JSRuntime.InvokeVoidAsync("cyhSocial.requestNotificationPermission");
                if (CurrentUser != null)
                {
                    await JSRuntime.InvokeVoidAsync("cyhTheme.syncUserTheme", CurrentUser.UserId);
                }

                // 🚀 Register Device for Background Web Push (Works even when browser is CLOSED!)
                if (CurrentUser != null)
                {
                    await JSRuntime.InvokeVoidAsync("cyhPush.subscribeUser", CurrentUser.DoctorProfileId, CurrentUser.UserId);
                }
            }
            catch { }
        }
    }

    private async Task CheckDueSchedulesAsync()
    {
        if (CurrentUser == null) return;

        try
        {
            var rawSchedules = await ScheduleRepo.GetByDoctorAsync(CurrentUser.DoctorProfileId, CurrentUser.UserId);

            if (rawSchedules == null || rawSchedules.Count == 0)
            {
                dueSchedules = new List<BannerScheduleDTO>();
                return;
            }

            // DOCTOR-WISE ISOLATION: Sirf wahi schedules alert karenge jo is doctor ne banaye hain ya iske hain
            var allSchedules = rawSchedules.Where(s =>
                (CurrentUser.DoctorProfileId.HasValue && CurrentUser.DoctorProfileId.Value > 0 && s.DoctorId == CurrentUser.DoctorProfileId.Value) ||
                (!string.IsNullOrEmpty(CurrentUser.UserId) && s.UserId == CurrentUser.UserId) ||
                (!string.IsNullOrEmpty(CurrentUser.FullName) && (s.CreatedBy == CurrentUser.FullName || s.DoctorName == CurrentUser.FullName))
            ).ToList();

            var newlyDue = allSchedules
                .Where(s => (s.Status == "Pending" || s.Status == "ReadyToShare" || s.Status == "Processing") &&
                            (s.Status == "ReadyToShare" || s.ScheduledAt <= IndianTimeHelper.Now))
                .OrderBy(s => s.ScheduledAt)
                .ToList();

            dueSchedules = newlyDue;

            var freshSchedules = newlyDue.Where(s => !notifiedScheduleIds.Contains(s.Id)).ToList();
            if (freshSchedules.Count > 0)
            {
                var topAlert = freshSchedules.First();
                notifiedScheduleIds.Add(topAlert.Id);
                liveBannerAlert = topAlert;

                if (isSoundEnabled)
                {
                    try
                    {
                        await JSRuntime.InvokeVoidAsync("cyhSocial.playAlertSound");
                    }
                    catch { }
                }

                try
                {
                    await JSRuntime.InvokeVoidAsync("cyhSocial.showDesktopNotification",
                        $"⏰ Banner Time Ho Gaya: {topAlert.BannerHeading}",
                        $"Dr. {topAlert.DoctorName} ka banner post ready hai! WhatsApp par 1-click share karein.",
                        topAlert.ImageUrl);
                }
                catch { }

                if (activeShareModalSchedule == null)
                {
                    activeShareModalSchedule = topAlert;
                }
            }
            else if (liveBannerAlert == null && newlyDue.Count > 0)
            {
                liveBannerAlert = newlyDue.First();
            }
        }
        catch { }
    }

    private async Task EnableDesktopNotificationsAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("cyhSocial.playAlertSound");
            var ok = await JSRuntime.InvokeAsync<bool>("cyhSocial.requestNotificationPermissionExplicit");
            if (ok)
            {
                if (CurrentUser != null)
                {
                    await JSRuntime.InvokeVoidAsync("cyhPush.subscribeUser", CurrentUser.DoctorProfileId, CurrentUser.UserId);
                }
                await JSRuntime.InvokeVoidAsync("cyhSocial.showDesktopNotification", "✅ Push Notifications Active", "Background Web Push is now active! You will receive alerts even when browser is closed.", "/favicon.png");
            }
        }
        catch { }
    }

    private void ToggleNotificationDropdown()
    {
        showNotificationDropdown = !showNotificationDropdown;
    }

    private void OpenShareModal(BannerScheduleDTO schedule)
    {
        activeShareModalSchedule = schedule;
        showNotificationDropdown = false;
        isCopied = false;
    }

    private async Task TriggerWhatsAppShare(BannerScheduleDTO schedule)
    {
        var message = $"{schedule.BannerHeading}\n\n{schedule.Caption}";
        if (!string.IsNullOrEmpty(schedule.ImageUrl))
        {
            message += $"\n\n📷 Banner Image: {schedule.ImageUrl}";
        }

        await JSRuntime.InvokeVoidAsync("cyhSocial.openWhatsApp", "", message);
    }

