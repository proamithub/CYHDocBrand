@page "/admin/dashboard"
@layout AdminLayout
@inject IAnalyticsService AnalyticsService
@inject IDoctorRepository DoctorRepo
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider

<div class="d-flex flex-column gap-4">
    <!-- Admin Header -->
    <div class="glass-panel p-4 d-flex flex-wrap align-items-center justify-content-between gap-3" style="border-left: 4px solid #f59e0b;">
        <div class="d-flex align-items-center gap-3">
            <div class="stat-icon-wrapper" style="width: 58px; height: 58px; font-size: 1.6rem; border-radius: 16px; background: rgba(245, 158, 11, 0.15); color: #fbbf24; border-color: rgba(245, 158, 11, 0.4);">
                <i class="bi bi-shield-shaded"></i>
            </div>
            <div>
                <div class="d-flex align-items-center gap-2">
                    <h3 class="mb-0 fw-bold text-white">Hospital Administration Dashboard</h3>
                    <span class="badge rounded-pill px-2 py-1" style="background: rgba(245, 158, 11, 0.2); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.4); font-size: 0.72rem;">Admin Command</span>
                </div>
                <div class="small mt-1" style="color: #cbd5e1;">
                    CYH DoctorHub Health System • SQL Server Instance: <span class="text-warning fw-semibold">VRS-AMITPC\SQLEXPRESS</span> • Pure ADO.NET
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <button class="glass-btn-secondary" @onclick="LoadAdminDataAsync" style="border-color: rgba(245, 158, 11, 0.35); color: #fbbf24;">
                <i class="bi bi-arrow-clockwise"></i> Refresh Metrics
            </button>
            <a href="admin/doctors" class="glass-btn-primary" style="background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%); color: #070d1e;">
                <i class="bi bi-people-fill"></i> Manage Doctors
            </a>
        </div>
    </div>

    <!-- 4 High-Level Metric Cards -->
    <div class="row g-3">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="glass-card stat-card">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="stat-label">Total Doctors</span>
                    <div class="stat-icon-wrapper" style="background: rgba(245, 158, 11, 0.12); color: #fbbf24; border-color: rgba(245, 158, 11, 0.25);">
                        <i class="bi bi-hospital"></i>
                    </div>
                </div>
                <div class="stat-value text-warning">@(Stats?.TotalDoctors ?? 0)</div>
                <small style="color: #94a3b8; font-size: 0.75rem;">Verified clinical specialists</small>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="glass-card stat-card">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="stat-label">Active On Duty</span>
                    <div class="stat-icon-wrapper stat-icon-emerald">
                        <i class="bi bi-person-check-fill"></i>
                    </div>
                </div>
                <div class="stat-value text-success">@(Stats?.ActiveDoctorsOnDuty ?? 0)</div>
                <small style="color: #94a3b8; font-size: 0.75rem;">Currently on hospital floor</small>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="glass-card stat-card">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="stat-label">Departments</span>
                    <div class="stat-icon-wrapper" style="background: rgba(0, 242, 254, 0.12); color: #00f2fe; border-color: rgba(0, 242, 254, 0.25);">
                        <i class="bi bi-diagram-3-fill"></i>
                    </div>
                </div>
                <div class="stat-value text-info">@(Stats?.TotalDepartments ?? 0)</div>
                <small style="color: #94a3b8; font-size: 0.75rem;">Active hospital specialties</small>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="glass-card stat-card">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="stat-label">System Accounts</span>
                    <div class="stat-icon-wrapper stat-icon-purple">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                </div>
                <div class="stat-value text-white">@(Stats?.TotalUsers ?? 0)</div>
                <small style="color: #94a3b8; font-size: 0.75rem;">Authorized staff & admins</small>
            </div>
        </div>
    </div>

    <!-- Doctor Faculty Roster & System Status -->
    <div class="row g-4">
        <!-- Doctor Roster -->
        <div class="col-12 col-lg-8">
            <div class="glass-panel p-4 h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h5 class="fw-bold mb-0 text-white">
                        <i class="bi bi-person-badge text-warning me-2"></i>Medical Specialists & Roster
                    </h5>
                    <span class="badge" style="background: rgba(245, 158, 11, 0.2); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.4);">
                        @(Doctors?.Count ?? 0) Doctors Registered
                    </span>
                </div>

                @if (Doctors == null)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border spinner-border-sm text-warning"></div>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var doc in Doctors)
                        {
                            <div class="glass-card p-3 d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="user-avatar" style="background: linear-gradient(135deg, #f59e0b, #fbbf24); color: #070d1e;">
                                        @doc.FullName[0]
                                    </div>
                                    <div>
                                        <div class="fw-bold text-white small">@doc.FullName</div>
                                        <div class="text-warning" style="font-size: 0.75rem;">@doc.Specialization</div>
                                        <small style="color: #94a3b8; font-size: 0.7rem;">Fee: $@doc.ConsultationFee • Hours: @doc.AvailableHours • License: @doc.LicenseNumber</small>
                                    </div>
                                </div>
                                <button class="glass-btn-secondary glass-btn-sm @(doc.IsAvailableToday ? "text-success border-success" : "text-muted")" @onclick="() => ToggleDocDuty(doc.Id)">
                                    <i class="bi bi-power"></i> @(doc.IsAvailableToday ? "● On Duty" : "○ Away")
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Infrastructure & Security Card -->
        <div class="col-12 col-lg-4">
            <div class="glass-panel p-4 h-100 d-flex flex-column justify-content-between">
                <div>
                    <h5 class="fw-bold mb-3 text-white">
                        <i class="bi bi-cpu text-warning me-2"></i>System Infrastructure
                    </h5>
                    <p class="small mb-3" style="color: #94a3b8;">
                        CYH DoctorHub runs on native ADO.NET and SQL Server Stored Procedures for optimal execution speed.
                    </p>

                    <div class="d-flex flex-column gap-2 small">
                        <div class="glass-card p-2 d-flex justify-content-between">
                            <span style="color: #cbd5e1;">Data Engine:</span>
                            <span class="text-white fw-semibold">SQL Server Express</span>
                        </div>
                        <div class="glass-card p-2 d-flex justify-content-between">
                            <span style="color: #cbd5e1;">Database:</span>
                            <span class="text-warning fw-semibold">CYHDocBrandBD</span>
                        </div>
                        <div class="glass-card p-2 d-flex justify-content-between">
                            <span style="color: #cbd5e1;">Data Access:</span>
                            <span class="text-success fw-semibold">Pure ADO.NET Procedures</span>
                        </div>
                        <div class="glass-card p-2 d-flex justify-content-between">
                            <span style="color: #cbd5e1;">Security:</span>
                            <span class="text-white fw-semibold">AES-256 CBC Encryption</span>
                        </div>
                        <div class="glass-card p-2 d-flex justify-content-between">
                            <span style="color: #cbd5e1;">Runtime:</span>
                            <span class="text-info fw-semibold">.NET 10.0 LTS</span>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center" style="border-color: rgba(255,255,255,0.08) !important;">
                    <span class="small" style="color: #cbd5e1;">Server Status</span>
                    <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50">Online • Active</span>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private AdminDashboardDTO? Stats;
    private List<DoctorProfile>? Doctors;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var currentUser = AuthService.GetCurrentUser();
            if (currentUser == null)
            {
                var adminUser = new CurrentUserDTO
                {
                    UserId = "admin-sys-01",
                    Email = "admin@cyhdoctorhub.com",
                    FullName = "Hospital Chief Administrator",
                    Role = "Admin",
                    Department = "Hospital Operations"
                };

                if (AuthStateProvider is CustomAuthenticationStateProvider customAuth)
                {
                    customAuth.SetUser(adminUser);
                }
                currentUser = adminUser;
            }

            if (currentUser?.Role != "Admin")
            {
                NavigationManager.NavigateTo("doctor/dashboard");
                return;
            }

            await LoadAdminDataAsync();
        }
        catch
        {
            // Fail gracefully on reload
        }
    }

    private async Task LoadAdminDataAsync()
    {
        try
        {
            Stats = await AnalyticsService.GetAdminStatsAsync();
            Doctors = await DoctorRepo.GetAllWithUsersAsync();
        }
        catch
        {
            // Fail gracefully
        }
    }

    private async Task ToggleDocDuty(int doctorId)
    {
        try
        {
            await DoctorRepo.ToggleAvailabilityAsync(doctorId);
            await LoadAdminDataAsync();
        }
        catch
        {
            // Fail gracefully
        }
    }
}
