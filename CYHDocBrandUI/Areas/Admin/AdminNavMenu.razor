@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<div class="cyh-brand" style="border-bottom: 1px solid rgba(245, 158, 11, 0.25);">
    <div class="cyh-brand-logo" style="background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%); box-shadow: 0 0 20px rgba(245, 158, 11, 0.45); color: #070d1e;">
        <i class="bi bi-shield-shaded"></i>
    </div>
    <div>
        <div class="cyh-brand-title">CYH AdminHub</div>
        <div class="cyh-brand-subtitle" style="color: #fbbf24;">Hospital Command</div>
    </div>
</div>

<div class="px-3 pt-3">
    <div class="p-2 text-center rounded-3" style="background: rgba(245, 158, 11, 0.12); border: 1px solid rgba(245, 158, 11, 0.35);">
        <span class="badge" style="background: transparent; color: #fbbf24; font-size: 0.72rem; letter-spacing: 0.8px; font-weight: 700;">
            <i class="bi bi-shield-lock-fill me-1"></i> ADMIN CONSOLE
        </span>
    </div>
</div>

<div class="cyh-nav">
    <div class="cyh-nav-divider" style="color: #cbd5e1;">Administration Command</div>

    <NavLink class="cyh-nav-item" href="admin/dashboard" Match="NavLinkMatch.All">
        <i class="bi bi-speedometer2 text-warning"></i>
        <span>Admin Dashboard</span>
    </NavLink>

    <NavLink class="cyh-nav-item" href="admin/doctors">
        <i class="bi bi-people-fill text-warning"></i>
        <span>Manage Specialists</span>
    </NavLink>

    <NavLink class="cyh-nav-item" href="admin/system">
        <i class="bi bi-cpu-fill text-warning"></i>
        <span>System Infrastructure</span>
    </NavLink>
</div>

<div class="cyh-sidebar-footer" style="border-top: 1px solid rgba(245, 158, 11, 0.2); padding: 0.9rem 1rem;">
    <button type="button" class="glass-btn-danger w-100 d-flex align-items-center justify-content-center gap-2 py-2" @onclick="Logout" style="border-radius: 10px; font-size: 0.88rem; font-weight: 600; cursor: pointer; transition: all 0.2s ease;">
        <i class="bi bi-box-arrow-right"></i>
        <span>Logout</span>
    </button>
</div>

@code {
    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("login");
    }
}
