@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<div class="cyh-brand" style="border-bottom: 1px solid rgba(245, 158, 11, 0.25);">
    <div class="cyh-brand-logo" style="background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%); box-shadow: 0 0 20px rgba(245, 158, 11, 0.45); color: #070d1e;">
        <i class="bi bi-shield-shaded"></i>
    </div>
    <div class="flex-grow-1 min-w-0" style="overflow: hidden;">
        <div class="cyh-brand-title text-truncate">CYH AdminHub</div>
        <div class="cyh-brand-subtitle text-truncate" style="color: #fbbf24; font-size: 0.72rem;">Hospital Command</div>
    </div>
    <!-- Mobile Close Button -->
    <button type="button" class="cyh-sidebar-close-btn d-lg-none" @onclick="HandleClose" @onclick:stopPropagation="true" aria-label="Close menu" title="Close menu" style="border-color: rgba(245, 158, 11, 0.45); color: #fbbf24; background: rgba(245, 158, 11, 0.1);">
        <i class="bi bi-x-lg"></i>
    </button>
</div>

<div class="px-3 pt-3 flex-shrink-0">
    <div class="p-2 text-center rounded-3" style="background: rgba(245, 158, 11, 0.12); border: 1px solid rgba(245, 158, 11, 0.35);">
        <span class="badge" style="background: transparent; color: #fbbf24; font-size: 0.72rem; letter-spacing: 0.8px; font-weight: 700;">
            <i class="bi bi-shield-lock-fill me-1"></i> ADMIN CONSOLE
        </span>
    </div>
</div>

<div class="cyh-nav">
    <div class="cyh-nav-divider" style="color: #cbd5e1;">Administration Command</div>

    <NavLink class="cyh-nav-item" href="admin/dashboard" Match="NavLinkMatch.All" @onclick="HandleClose">
        <i class="bi bi-speedometer2 text-warning"></i>
        <span>Admin Dashboard</span>
    </NavLink>

    <NavLink class="cyh-nav-item" href="admin/doctors" @onclick="HandleClose">
        <i class="bi bi-people-fill text-warning"></i>
        <span>Manage Specialists</span>
    </NavLink>

    <NavLink class="cyh-nav-item" href="admin/credits" @onclick="HandleClose">
        <i class="bi bi-coin text-warning"></i>
        <span>Manage Credit System</span>
    </NavLink>

    <NavLink class="cyh-nav-item" href="admin/banner-designs" @onclick="HandleClose">
        <i class="bi bi-collection-play-fill text-warning"></i>
        <span>Doctor Banners (View &amp; Delete)</span>
    </NavLink>

    <NavLink class="cyh-nav-item" href="admin/schedules" @onclick="HandleClose">
        <i class="bi bi-broadcast-pin text-warning"></i>
        <span>Social Schedules Monitor</span>
    </NavLink>

    <NavLink class="cyh-nav-item" href="admin/credit-history" @onclick="HandleClose">
        <i class="bi bi-clock-history text-warning"></i>
        <span>Credit &amp; Usage History</span>
    </NavLink>

    <NavLink class="cyh-nav-item" href="admin/ai-settings" @onclick="HandleClose">
        <i class="bi bi-key-fill text-warning"></i>
        <span>AI API Key Management</span>
    </NavLink>

    <NavLink class="cyh-nav-item" href="admin/system" @onclick="HandleClose">
        <i class="bi bi-cpu-fill text-warning"></i>
        <span>System Infrastructure</span>
    </NavLink>
</div>

<div class="cyh-sidebar-footer" style="border-top: 1px solid rgba(245, 158, 11, 0.2); padding: 0.9rem 1rem;">
    <!-- PWA Install WebApp Button -->
    <button type="button" 
            class="btn cyh-pwa-install-btn w-100 d-flex align-items-center justify-content-center gap-2 py-2 mb-2" 
            id="pwaAdminInstallBtn"
            onclick="window.cyhPwa && window.cyhPwa.promptInstall()"
            style="border-radius: 10px; font-size: 0.84rem; font-weight: 600; background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.4); color: #fbbf24; transition: all 0.2s ease;">
        <i class="bi bi-download"></i>
        <span>Install Web App</span>
    </button>
    <button type="button" class="glass-btn-danger w-100 d-flex align-items-center justify-content-center gap-2 py-2" @onclick="Logout" style="border-radius: 10px; font-size: 0.88rem; font-weight: 600; cursor: pointer; transition: all 0.2s ease;">
        <i class="bi bi-box-arrow-right"></i>
        <span>Logout</span>
    </button>
</div>

@code {
    [Parameter]
    public EventCallback OnCloseMenu { get; set; }

    private async Task HandleClose()
    {
        if (OnCloseMenu.HasDelegate)
        {
            await OnCloseMenu.InvokeAsync();
        }
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("login", forceLoad: true);
    }
}
