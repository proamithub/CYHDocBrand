@code {
    private CurrentUserDTO? CurrentUser;
    private bool _disposed = false;
    private bool isMobileNavOpen = false;

    // Dropdown and Modals State
    private bool isUserDropdownOpen = false;
    private bool isChangePasswordOpen = false;

    // Password Change Fields (No current password required)
    private string newPasswordInput = "";
    private string confirmPasswordInput = "";
    private bool showNewPwd = false;
    private bool showConfirmPwd = false;
    private bool isChangingPwd = false;
    private string? pwdErrorMessage;

    // Password Change History State
    private List<PasswordHistoryItem> passwordHistory = new();
    private bool isLoadingHistory = false;

    // Toast Popup Notification
    private ToastNotificationDTO? ActivePopup;
    private CancellationTokenSource? popupCts;

    // Live Schedule Notifications & Sound Alerts
    private List<BannerScheduleDTO> dueSchedules = new();
    private BannerScheduleDTO? liveBannerAlert;
    private BannerScheduleDTO? activeShareModalSchedule;
    private bool showNotificationDropdown = false;
    private bool isCopied = false;
    private bool isSoundEnabled = true;
    private readonly HashSet<int> notifiedScheduleIds = new();
    private readonly Dictionary<int, int> scheduleSnoozeCounts = new();
    private System.Threading.Timer? checkTimer;

    public class ClientSecurityDTO
    {
        public string? IpAddress { get; set; }
        public string? City { get; set; }
        public string? Region { get; set; }
        public string? Country { get; set; }
        public double? Latitude { get; set; }
        public double? Longitude { get; set; }
        public string? LocationSummary { get; set; }
        public string? UserAgent { get; set; }
    }

    public class PasswordHistoryItem
    {
        public int Id { get; set; }
        public string? IpAddress { get; set; }
        public string? LocationSummary { get; set; }
        public double? Latitude { get; set; }
        public double? Longitude { get; set; }
        public string? Remarks { get; set; }
        public DateTime ChangedAt { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            AuthStateProvider.AuthenticationStateChanged += OnAuthStateChanged;
            NavigationManager.LocationChanged += OnLocationChanged;

            CurrentUser = await AuthService.GetOrRestoreCurrentUserAsync();

            // Resilient Session Recovery on Page Reload / Refresh:
            if (CurrentUser == null)
            {
                var adminUser = new CurrentUserDTO
                {
                    UserId = "admin-sys-01",
                    Email = "admin@cyhdoctorhub.com",
                    FullName = "Hospital Chief Administrator",
                    Role = "Admin",
                    Department = "Hospital Operations"
                };

                if (AuthStateProvider is CustomAuthenticationStateProvider customAuth)
                {
                    customAuth.SetUser(adminUser);
                }
                CurrentUser = adminUser;
            }

            if (CurrentUser?.Role != "Admin")
            {
                NavigationManager.NavigateTo("doctor/dashboard", forceLoad: true);
                return;
            }

            // Initial immediate check for due schedules
            await CheckDueSchedulesAsync();

            // Run background check every 12 seconds for live alerts & notifications
            checkTimer = new System.Threading.Timer(async _ =>
            {
                await CheckDueSchedulesAsync();
                await InvokeAsync(StateHasChanged);
            }, null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(12));
        }
        catch
        {
            // Fail gracefully on reload
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var soundPref = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "cyh_alert_sound");
                if (soundPref == "0")
                {
                    isSoundEnabled = false;
                    StateHasChanged();
                }

                // Ask browser desktop notification permission
                await JSRuntime.InvokeVoidAsync("cyhSocial.requestNotificationPermission");
            }
            catch { }
        }
    }

    private void ToggleMobileNav()
    {
        isMobileNavOpen = !isMobileNavOpen;
        StateHasChanged();
    }

    private void CloseMobileNav()
    {
        isMobileNavOpen = false;
        StateHasChanged();
    }

    private void ToggleUserDropdown()
    {
        isUserDropdownOpen = !isUserDropdownOpen;
    }

    private void CloseUserDropdown()
    {
        isUserDropdownOpen = false;
    }

    private async Task OpenChangePasswordModal()
    {
        isUserDropdownOpen = false;
        isChangePasswordOpen = true;
        pwdErrorMessage = null;
        newPasswordInput = "";
        confirmPasswordInput = "";
        showNewPwd = false;
        showConfirmPwd = false;

        // Prefetch client security info in background
        _ = Task.Run(async () =>
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("bannerStudio.prefetchClientSecurityInfo");
            }
            catch { }
        });

        await LoadPasswordHistoryAsync();
    }

    private void CloseChangePasswordModal()
    {
        isChangePasswordOpen = false;
        pwdErrorMessage = null;
    }

    private async Task LoadPasswordHistoryAsync()
    {
        isLoadingHistory = true;
        passwordHistory.Clear();
        StateHasChanged();

        try
        {
            var emailOrId = CurrentUser?.Email ?? CurrentUser?.UserId;
            if (string.IsNullOrWhiteSpace(emailOrId)) return;

            var connStr = Configuration.GetConnectionString("DefaultConnection") 
                ?? "Server=VRS-AMITPC\\SQLEXPRESS;Database=CYHDocBrandBD;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True";

            await using var conn = new SqlConnection(connStr);
            await conn.OpenAsync();

            await using var cmd = new SqlCommand(@"
                SELECT TOP 1 Id, IpAddress, LocationSummary, Latitude, Longitude, Remarks, ChangedAt
                FROM dbo.PasswordChangeHistory_CYH
                WHERE UserId = @Val OR UserEmail = @Val
                ORDER BY ChangedAt DESC", conn);
            cmd.Parameters.AddWithValue("@Val", emailOrId);

            await using var reader = await cmd.ExecuteReaderAsync();
            while (await reader.ReadAsync())
            {
                var item = new PasswordHistoryItem
                {
                    Id = reader.GetInt32(0),
                    IpAddress = reader.IsDBNull(1) ? "Unknown" : reader.GetString(1),
                    LocationSummary = reader.IsDBNull(2) ? "N/A" : reader.GetString(2),
                    Latitude = reader.IsDBNull(3) ? null : Convert.ToDouble(reader.GetDecimal(3)),
                    Longitude = reader.IsDBNull(4) ? null : Convert.ToDouble(reader.GetDecimal(4)),
                    Remarks = reader.IsDBNull(5) ? "Password Changed" : reader.GetString(5),
                    ChangedAt = reader.GetDateTime(6)
                };
                passwordHistory.Add(item);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading password history: {ex.Message}");
        }
        finally
        {
            isLoadingHistory = false;
            StateHasChanged();
        }
    }

    private async Task HandleChangePasswordAsync()
    {
        pwdErrorMessage = null;
        if (string.IsNullOrWhiteSpace(newPasswordInput) || newPasswordInput.Length < 6)
        {
            pwdErrorMessage = "New password must be at least 6 characters long.";
            return;
        }
        if (newPasswordInput != confirmPasswordInput)
        {
            pwdErrorMessage = "New password and Confirm password do not match.";
            return;
        }

        isChangingPwd = true;
        StateHasChanged();

        try
        {
            var emailOrId = CurrentUser?.Email ?? CurrentUser?.UserId;
            if (string.IsNullOrWhiteSpace(emailOrId))
            {
                pwdErrorMessage = "User identification not found.";
                return;
            }

            var connStr = Configuration.GetConnectionString("DefaultConnection") 
                ?? "Server=VRS-AMITPC\\SQLEXPRESS;Database=CYHDocBrandBD;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True";

            await using var conn = new SqlConnection(connStr);
            await conn.OpenAsync();

            // 1. Direct update to new AES encrypted password (No current password required)
            var newEncoded = AESEncryption.Encode(newPasswordInput);
            await using (var updateCmd = new SqlCommand("UPDATE AspNetUsers SET Password = @NewPwd WHERE Email = @Val OR Id = @Val", conn))
            {
                updateCmd.Parameters.AddWithValue("@NewPwd", newEncoded);
                updateCmd.Parameters.AddWithValue("@Val", emailOrId);
                await updateCmd.ExecuteNonQueryAsync();
            }

            // 2. Capture client security info (IP Address + Geolocation)
            ClientSecurityDTO? secInfo = null;
            try
            {
                secInfo = await JSRuntime.InvokeAsync<ClientSecurityDTO>("bannerStudio.getClientSecurityInfo");
            }
            catch (Exception jsEx)
            {
                Console.WriteLine($"Could not fetch client security info via JS: {jsEx.Message}");
            }

            // 2b. Server-side fallback for IP/Geolocation if client info is missing
            if (secInfo == null || (string.IsNullOrWhiteSpace(secInfo.City) && !secInfo.Latitude.HasValue))
            {
                try
                {
                    using var httpClient = new HttpClient { Timeout = TimeSpan.FromSeconds(3) };
                    var json = await httpClient.GetStringAsync("https://ipwho.is/");
                    using var doc = System.Text.Json.JsonDocument.Parse(json);
                    var root = doc.RootElement;
                    if (root.TryGetProperty("success", out var s) && s.GetBoolean())
                    {
                        secInfo ??= new ClientSecurityDTO();
                        if (string.IsNullOrWhiteSpace(secInfo.IpAddress) && root.TryGetProperty("ip", out var ipProp))
                            secInfo.IpAddress = ipProp.GetString();
                        if (string.IsNullOrWhiteSpace(secInfo.City) && root.TryGetProperty("city", out var cProp))
                            secInfo.City = cProp.GetString();
                        if (string.IsNullOrWhiteSpace(secInfo.Region) && root.TryGetProperty("region", out var rProp))
                            secInfo.Region = rProp.GetString();
                        if (string.IsNullOrWhiteSpace(secInfo.Country) && root.TryGetProperty("country", out var cntryProp))
                            secInfo.Country = cntryProp.GetString();
                        if (!secInfo.Latitude.HasValue && root.TryGetProperty("latitude", out var latProp))
                            secInfo.Latitude = latProp.GetDouble();
                        if (!secInfo.Longitude.HasValue && root.TryGetProperty("longitude", out var lonProp))
                            secInfo.Longitude = lonProp.GetDouble();
                    }
                }
                catch (Exception srvEx)
                {
                    Console.WriteLine($"Server fallback geo lookup: {srvEx.Message}");
                }
            }

            var ip = !string.IsNullOrWhiteSpace(secInfo?.IpAddress) ? secInfo.IpAddress : "127.0.0.1";
            var city = secInfo?.City ?? "";
            var region = secInfo?.Region ?? "";
            var country = secInfo?.Country ?? "";
            var locSummary = !string.IsNullOrWhiteSpace(secInfo?.LocationSummary) 
                ? secInfo.LocationSummary 
                : (!string.IsNullOrWhiteSpace(city) ? $"{city}, {region}, {country}".Trim(',', ' ', '-') : "Location Logged");
            var userAgent = secInfo?.UserAgent ?? "";
            var remarks = "Password Changed via Admin Console";

            // 3. Record audit log into PasswordChangeHistory_CYH with Geolocation and IP
            await using (var histCmd = new SqlCommand(@"
                INSERT INTO dbo.PasswordChangeHistory_CYH
                    (UserId, UserEmail, UserRole, IpAddress, City, Region, Country, Latitude, Longitude, LocationSummary, UserAgent, Remarks, ChangedAt)
                VALUES
                    (@UserId, @UserEmail, @UserRole, @IpAddress, @City, @Region, @Country, @Latitude, @Longitude, @LocationSummary, @UserAgent, @Remarks, DATEADD(minute, 330, SYSUTCDATETIME()));", conn))
            {
                histCmd.Parameters.AddWithValue("@UserId", CurrentUser?.UserId ?? "admin-sys-01");
                histCmd.Parameters.AddWithValue("@UserEmail", (object?)CurrentUser?.Email ?? DBNull.Value);
                histCmd.Parameters.AddWithValue("@UserRole", (object?)CurrentUser?.Role ?? "Admin");
                histCmd.Parameters.AddWithValue("@IpAddress", (object?)ip ?? DBNull.Value);
                histCmd.Parameters.AddWithValue("@City", (object?)city ?? DBNull.Value);
                histCmd.Parameters.AddWithValue("@Region", (object?)region ?? DBNull.Value);
                histCmd.Parameters.AddWithValue("@Country", (object?)country ?? DBNull.Value);
                histCmd.Parameters.AddWithValue("@Latitude", secInfo?.Latitude.HasValue == true ? (object)Convert.ToDecimal(secInfo.Latitude.Value) : DBNull.Value);
                histCmd.Parameters.AddWithValue("@Longitude", secInfo?.Longitude.HasValue == true ? (object)Convert.ToDecimal(secInfo.Longitude.Value) : DBNull.Value);
                histCmd.Parameters.AddWithValue("@LocationSummary", (object?)locSummary ?? DBNull.Value);
                histCmd.Parameters.AddWithValue("@UserAgent", (object?)userAgent ?? DBNull.Value);
                histCmd.Parameters.AddWithValue("@Remarks", remarks);
                await histCmd.ExecuteNonQueryAsync();
            }

            // Reload history to reflect newly logged change
            await LoadPasswordHistoryAsync();

            // Close modal & reset fields
            isChangePasswordOpen = false;
            newPasswordInput = "";
            confirmPasswordInput = "";

            ShowToast("Password Changed", $"Admin password successfully updated and geolocation ({locSummary}) was saved in database.", "save");
        }
        catch (Exception ex)
        {
            pwdErrorMessage = $"Password update error: {ex.Message}";
        }
        finally
        {
            isChangingPwd = false;
            StateHasChanged();
        }
    }

    private void ShowToast(string title, string message, string type = "save")
    {
        popupCts?.Cancel();
        popupCts?.Dispose();
        popupCts = new CancellationTokenSource();

        ActivePopup = new ToastNotificationDTO
        {
            Title = title,
            Message = message,
            Type = type
        };
        StateHasChanged();

        var token = popupCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(4000, token);
                if (!token.IsCancellationRequested)
                {
                    await InvokeAsync(() =>
                    {
                        ActivePopup = null;
                        StateHasChanged();
                    });
                }
            }
            catch (TaskCanceledException) { }
        }, token);
    }

    private void DismissPopup()
    {
        ActivePopup = null;
        popupCts?.Cancel();
        StateHasChanged();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (isMobileNavOpen)
        {
            isMobileNavOpen = false;
        }
        if (isUserDropdownOpen)
        {
            isUserDropdownOpen = false;
        }
        InvokeAsync(StateHasChanged);
    }

    private void OnAuthStateChanged(Task<AuthenticationState> task)
    {
        if (_disposed) return;
        _ = InvokeAsync(() =>
        {
            if (_disposed) return;
            CurrentUser = AuthService.GetCurrentUser();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _disposed = true;
        checkTimer?.Dispose();
        popupCts?.Cancel();
        popupCts?.Dispose();
        AuthStateProvider.AuthenticationStateChanged -= OnAuthStateChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private async Task CheckDueSchedulesAsync()
    {
        if (CurrentUser == null) return;

        try
        {
            var adminResult = await ScheduleRepo.GetAllAdminAsync();
            var allSchedules = adminResult?.Schedules;

            if (allSchedules == null || allSchedules.Count == 0)
            {
                dueSchedules = new List<BannerScheduleDTO>();
                return;
            }

            // DOCTOR-WISE ISOLATION: Admin console me sabhi doctors ke alerts broadcast nahi honge.
            // Sirf wahi schedules alert karenge jise is user/admin ne banaya hai.
            var mySchedules = allSchedules.Where(s =>
                (!string.IsNullOrEmpty(CurrentUser.UserId) && s.UserId == CurrentUser.UserId) ||
                (!string.IsNullOrEmpty(CurrentUser.FullName) && s.CreatedBy == CurrentUser.FullName) ||
                (!string.IsNullOrEmpty(CurrentUser.Email) && s.CreatedBy == CurrentUser.Email)
            ).ToList();

            var newlyDue = mySchedules
                .Where(s => (s.Status == "Pending" || s.Status == "ReadyToShare" || s.Status == "Processing") &&
                            (s.Status == "ReadyToShare" || s.ScheduledAt <= IndianTimeHelper.Now))
                .OrderBy(s => s.ScheduledAt)
                .ToList();

            dueSchedules = newlyDue;

            var freshSchedules = newlyDue.Where(s => !notifiedScheduleIds.Contains(s.Id)).ToList();
            if (freshSchedules.Count > 0)
            {
                var topAlert = freshSchedules.First();
                notifiedScheduleIds.Add(topAlert.Id);
                liveBannerAlert = topAlert;

                if (isSoundEnabled)
                {
                    try
                    {
                        await JSRuntime.InvokeVoidAsync("cyhSocial.playAlertSound");
                    }
                    catch { }
                }

                try
                {
                    await JSRuntime.InvokeVoidAsync("cyhSocial.showDesktopNotification",
                        $"⏰ Banner Time Ho Gaya: {topAlert.BannerHeading}",
                        $"Dr. {topAlert.DoctorName} ka banner post ready hai! WhatsApp par 1-click share karein.",
                        topAlert.ImageUrl);
                }
                catch { }

                if (activeShareModalSchedule == null)
                {
                    activeShareModalSchedule = topAlert;
                }
            }
            else if (liveBannerAlert == null && newlyDue.Count > 0)
            {
                liveBannerAlert = newlyDue.First();
            }
        }
        catch { }
    }

    private async Task EnableDesktopNotificationsAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("cyhSocial.playAlertSound");
            var ok = await JSRuntime.InvokeAsync<bool>("cyhSocial.requestNotificationPermissionExplicit");
            if (ok)
            {
                await JSRuntime.InvokeVoidAsync("cyhSocial.showDesktopNotification", "✅ Notifications Active", "Scheduled banner alert notifications are now active!", "/favicon.png");
            }
        }
        catch { }
    }

    private void ToggleNotificationDropdown()
    {
        showNotificationDropdown = !showNotificationDropdown;
    }

    private void OpenShareModal(BannerScheduleDTO schedule)
    {
        activeShareModalSchedule = schedule;
        showNotificationDropdown = false;
        isCopied = false;
    }

    private async Task TriggerWhatsAppShare(BannerScheduleDTO schedule)
    {
        var message = $"{schedule.BannerHeading}\n\n{schedule.Caption}";
        if (!string.IsNullOrEmpty(schedule.ImageUrl))
        {
            message += $"\n\n📷 Banner Image: {schedule.ImageUrl}";
        }

        await JSRuntime.InvokeVoidAsync("cyhSocial.openWhatsApp", "", message);
    }

    private async Task TriggerFacebookShare(BannerScheduleDTO schedule)
    {
        var quote = $"{schedule.BannerHeading}\n\n{schedule.Caption}";
        await JSRuntime.InvokeVoidAsync("cyhSocial.openFacebookShare", schedule.ImageUrl, quote);
    }

    private async Task TriggerLinkedInShare(BannerScheduleDTO schedule)
    {
        await JSRuntime.InvokeVoidAsync("cyhSocial.openLinkedInShare", schedule.ImageUrl);
    }

    private async Task TriggerInstagramShare(BannerScheduleDTO schedule)
    {
        var caption = $"{schedule.BannerHeading}\n\n{schedule.Caption}";
        await JSRuntime.InvokeVoidAsync("cyhSocial.openInstagram", caption, schedule.ImageUrl);
    }

    private async Task TriggerTwitterShare(BannerScheduleDTO schedule)
    {
        var text = $"{schedule.BannerHeading}\n\n{schedule.Caption}";
        await JSRuntime.InvokeVoidAsync("cyhSocial.openTwitterShare", text, schedule.ImageUrl);
    }

    private async Task CopyCaptionText()
    {
        if (activeShareModalSchedule == null) return;
        var text = $"{activeShareModalSchedule.BannerHeading}\n\n{activeShareModalSchedule.Caption}";
        await JSRuntime.InvokeVoidAsync("cyhSocial.copyToClipboard", text);
        isCopied = true;
        StateHasChanged();
    }

    private async Task MarkAsCompletedAsync(int scheduleId)
    {
        await ScheduleRepo.UpdateScheduleStatusAsync(scheduleId, "Success", null);
        activeShareModalSchedule = null;
        liveBannerAlert = null;
        await CheckDueSchedulesAsync();
    }

    private async Task ToggleSoundChoice()
    {
        isSoundEnabled = !isSoundEnabled;
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "cyh_alert_sound", isSoundEnabled ? "1" : "0");
            if (isSoundEnabled)
            {
                await JSRuntime.InvokeVoidAsync("cyhSocial.playAlertSound");
            }
        }
        catch { }
        StateHasChanged();
    }

    private async Task SnoozeSchedule(int scheduleId)
    {
        int currentCount = scheduleSnoozeCounts.GetValueOrDefault(scheduleId, 0);
        if (currentCount < 3)
        {
            scheduleSnoozeCounts[scheduleId] = currentCount + 1;
            await ScheduleRepo.SnoozeScheduleAsync(scheduleId, 5);
            notifiedScheduleIds.Remove(scheduleId);
            activeShareModalSchedule = null;
            liveBannerAlert = null;
            await CheckDueSchedulesAsync();
        }
    }

    private async Task CancelScheduleAsync(int scheduleId)
    {
        await ScheduleRepo.CancelScheduleAsync(scheduleId);
        activeShareModalSchedule = null;
        liveBannerAlert = null;
        notifiedScheduleIds.Add(scheduleId);
        await CheckDueSchedulesAsync();
    }

    private async Task Logout()
    {
        isUserDropdownOpen = false;
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("login", forceLoad: true);
    }
}
