@inherits LayoutComponentBase
@implements IDisposable
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IConfiguration Configuration
@inject IJSRuntime JSRuntime
@inject IBannerScheduleRepository ScheduleRepo
@using System.Data
@using Microsoft.Data.SqlClient
@using CYHDocBrandRepo.Utilities
@using CYHDocBrandRepo.IRepository
@using CYHDocBrandModel.DTO
@using CYHDocBrandModel.Common
@using CYHDocBrandUI.Components.Common

<div class="cyh-app-container">
    <!-- Mobile Sidebar Dark Backdrop -->
    <div class="cyh-sidebar-backdrop @(isMobileNavOpen ? "show" : "")" @onclick="CloseMobileNav"></div>

    <!-- Dedicated Admin Sidebar (Desktop Fixed + Mobile Off-Canvas Drawer) -->
    <aside class="cyh-sidebar @(isMobileNavOpen ? "mobile-open" : "")" style="border-right: 1px solid rgba(245, 158, 11, 0.25);">
        <AdminNavMenu OnCloseMenu="CloseMobileNav" />
    </aside>

    <!-- Main Content Area -->
    <div class="cyh-main-content">
        <!-- Top Navigation Bar for Admin -->
        <header class="cyh-topbar" style="border-bottom: 1px solid rgba(245, 158, 11, 0.2);">
            <div class="d-flex align-items-center gap-2">
                <!-- Hamburger Menu Toggle (Mobile & Tablet) -->
                <button class="cyh-mobile-toggle d-lg-none" type="button" @onclick="ToggleMobileNav" aria-label="Toggle navigation" style="border-color: rgba(245, 158, 11, 0.4); color: #fbbf24;">
                    <i class="bi bi-list"></i>
                </button>

                <span class="badge d-flex align-items-center gap-1" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.35); padding: 0.45rem 0.75rem; font-size: 0.82rem; font-weight: 700;">
                    <i class="bi bi-shield-lock-fill"></i>
                    <span class="d-none d-sm-inline">Hospital Central Command</span>
                    <span class="d-inline d-sm-none">Admin Console</span>
                </span>

                <!-- Live Running Server Time (Indian Standard Time - Hidden on mobile view to save space) -->
                <div class="d-none d-md-block">
                    <ServerTimeClock />
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <!-- Sound Alert Choice Toggle (Sound ON / OFF) -->
                <button type="button" class="btn btn-outline-secondary p-2 rounded-circle d-flex align-items-center justify-content-center"
                        style="width: 38px; height: 38px; border-color: @(isSoundEnabled ? "rgba(245, 158, 11, 0.5)" : "rgba(255,255,255,0.15)"); background: rgba(14, 25, 48, 0.7);"
                        @onclick="ToggleSoundChoice" 
                        title="@(isSoundEnabled ? "Sound Alert: ON (Click to Mute)" : "Sound Alert: OFF (Click to Unmute)")">
                    <i class="bi @(isSoundEnabled ? "bi-volume-up-fill text-warning" : "bi-volume-mute text-secondary") fs-5"></i>
                </button>

                <!-- Live Schedule Reminder Bell -->
                <div class="position-relative">
                    <button type="button" class="btn btn-outline-secondary position-relative p-2 rounded-circle d-flex align-items-center justify-content-center"
                            style="width: 38px; height: 38px; border-color: @(dueSchedules.Count > 0 ? "rgba(245, 158, 11, 0.6)" : "rgba(255,255,255,0.15)"); background: rgba(14, 25, 48, 0.7);"
                            @onclick="ToggleNotificationDropdown" title="Scheduled Post Notifications">
                        <i class="bi @(dueSchedules.Count > 0 ? "bi-bell-fill text-warning bell-ring-anim" : "bi-bell text-secondary") fs-5"></i>
                        @if (dueSchedules.Count > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.68rem; box-shadow: 0 0 10px rgba(239, 68, 68, 0.8);">
                                @dueSchedules.Count
                            </span>
                        }
                    </button>

                    <!-- Due Notifications Dropdown -->
                    @if (showNotificationDropdown)
                    {
                        <div class="position-absolute end-0 mt-2 p-3 rounded-4 shadow-lg glass-panel" style="width: 320px; max-width: 90vw; background: rgba(14, 25, 48, 0.98); border: 1px solid rgba(245, 158, 11, 0.4); z-index: 1050;">
                            <div class="d-flex align-items-center justify-content-between mb-2 pb-2 border-bottom border-secondary border-opacity-25">
                                <span class="text-white fw-bold small">
                                    <i class="bi bi-clock-history text-warning me-1"></i> Ready to Share Now (@dueSchedules.Count)
                                </span>
                                <button type="button" class="btn-close btn-close-white small" style="font-size: 0.75rem;" @onclick="() => showNotificationDropdown = false"></button>
                            </div>

                            @if (dueSchedules.Count == 0)
                            {
                                <div class="text-center py-3 text-secondary small">
                                    <i class="bi bi-check-circle fs-4 text-success d-block mb-1"></i>
                                    Abhi koi post pending nahi hai.
                                </div>
                            }
                            else
                            {
                                <div style="max-height: 280px; overflow-y: auto;">
                                    @foreach (var s in dueSchedules)
                                    {
                                        <div class="p-2 mb-2 rounded-3 bg-dark border border-secondary border-opacity-25 d-flex gap-2 align-items-center justify-content-between">
                                            <div class="min-w-0 flex-grow-1 cursor-pointer" @onclick="() => OpenShareModal(s)" style="cursor: pointer;">
                                                <div class="text-white fw-semibold small text-truncate">@s.BannerHeading</div>
                                                <div class="text-info small" style="font-size: 0.72rem;">Doctor: @s.DoctorName &bull; <i class="bi bi-clock me-1 text-warning"></i>@s.ScheduledAt.ToIndianTime().ToString("hh:mm tt") IST</div>
                                            </div>
                                            <button type="button" class="btn btn-success btn-sm py-1 px-2 fw-semibold" @onclick="() => OpenShareModal(s)" style="background: #25d366; border: none; font-size: 0.75rem; color: #070d1e;">
                                                <i class="bi bi-whatsapp"></i> Send
                                            </button>
                                        </div>
                                    }
                                </div>
                            }

                            <div class="mt-2 pt-2 border-top border-secondary border-opacity-25">
                                <button type="button" class="btn btn-outline-warning btn-sm w-100 py-1" style="font-size: 0.75rem;" @onclick="EnableDesktopNotificationsAsync">
                                    <i class="bi bi-bell-fill text-warning me-1"></i> Test Chime Sound &amp; Alerts
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <!-- Top Right Admin Dropdown -->
                <div class="position-relative">
                <button type="button" 
                        class="btn p-0 border-0 bg-transparent d-flex align-items-center" 
                        @onclick="ToggleUserDropdown"
                        aria-expanded="@isUserDropdownOpen"
                        title="Admin Account Options">
                    <div class="user-profile-pill d-flex align-items-center gap-2" 
                         style="border: 1px solid rgba(245, 158, 11, 0.45); background: rgba(14, 25, 48, 0.85); padding: 5px 12px 5px 6px; border-radius: 30px; cursor: pointer; transition: all 0.2s ease;">
                        <div class="user-avatar" style="width: 32px; height: 32px; border-radius: 50%; background: linear-gradient(135deg, #f59e0b, #fbbf24); color: #070d1e; display: flex; align-items: center; justify-content: center; font-weight: bold;">
                            <i class="bi bi-shield-fill"></i>
                        </div>
                        <div class="d-none d-sm-block text-start">
                            <div style="font-size: 0.85rem; font-weight: 600; line-height: 1.1; color: #ffffff; max-width: 140px;" class="text-truncate">
                                @(CurrentUser?.FullName ?? "System Administrator")
                            </div>
                            <div class="d-none d-md-block text-truncate" style="font-size: 0.72rem; color: #fbbf24; font-weight: 600; max-width: 140px;">
                                Hospital Administrator
                            </div>
                        </div>
                        <i class="bi bi-chevron-down ms-1" style="color: #fbbf24; font-size: 0.75rem; transition: transform 0.2s; transform: @(isUserDropdownOpen ? "rotate(180deg)" : "rotate(0deg)");"></i>
                    </div>
                </button>

                @if (isUserDropdownOpen)
                {
                    <!-- Backdrop for click-outside -->
                    <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1040;" @onclick="CloseUserDropdown"></div>

                    <!-- Dropdown Menu Box -->
                    <div class="dropdown-menu show shadow-lg fade-in" 
                         style="position: absolute; right: 0; top: calc(100% + 8px); min-width: 250px; background: rgba(10, 20, 42, 0.98); backdrop-filter: blur(16px); border: 1px solid rgba(245, 158, 11, 0.4); border-radius: 14px; padding: 8px; z-index: 1045; box-shadow: 0 14px 35px rgba(0, 0, 0, 0.75);">
                        
                        <!-- Header Section inside Dropdown -->
                        <div class="p-2 mb-2 rounded-3" style="background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.15);">
                            <div class="fw-bold text-white small text-truncate">@(CurrentUser?.FullName ?? "Administrator")</div>
                            <div class="text-secondary text-truncate" style="font-size: 0.74rem;">@(CurrentUser?.Email ?? "admin@cyhdoctorhub.com")</div>
                            <span class="badge mt-1" style="background: rgba(245, 158, 11, 0.2); color: #fbbf24; font-size: 0.68rem; border: 1px solid rgba(245, 158, 11, 0.4);">
                                <i class="bi bi-shield-check me-1"></i>Hospital Admin
                            </span>
                        </div>

                        <!-- 1. Password Change Option -->
                        <button type="button" 
                                class="dropdown-item d-flex align-items-center gap-2 rounded-2 py-2 px-3 text-white border-0 w-100 text-start" 
                                @onclick="OpenChangePasswordModal" 
                                style="font-size: 0.86rem; transition: all 0.15s; background: transparent;">
                            <i class="bi bi-key-fill text-warning fs-6"></i>
                            <span>Change Password</span>
                        </button>

                        <div class="dropdown-divider my-2" style="border-color: rgba(255, 255, 255, 0.1);"></div>

                        <!-- 2. Logout Option -->
                        <button type="button" 
                                class="dropdown-item d-flex align-items-center gap-2 rounded-2 py-2 px-3 text-danger border-0 w-100 text-start" 
                                @onclick="Logout" 
                                style="font-size: 0.86rem; transition: all 0.15s; background: transparent;">
                            <i class="bi bi-box-arrow-right fs-6"></i>
                            <span class="fw-bold">Logout</span>
                        </button>
                    </div>
                }
            </div>
        </div>
    </header>

    <!-- Floating Live Reminder Alert Strip (When post becomes due) -->
    @if (liveBannerAlert != null)
    {
        <div class="alert alert-warning m-3 mb-0 p-3 rounded-4 shadow-lg d-flex align-items-center justify-content-between gap-3 border-warning position-relative"
             style="background: linear-gradient(135deg, rgba(245, 158, 11, 0.35) 0%, rgba(14, 25, 48, 0.98) 100%); backdrop-filter: blur(12px); border: 2px solid #f59e0b !important; box-shadow: 0 10px 30px rgba(245, 158, 11, 0.3) !important;">
            <div class="d-flex align-items-center gap-3">
                <div class="p-2 rounded-circle bg-warning text-dark fs-4 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; box-shadow: 0 0 15px rgba(245, 158, 11, 0.8);">
                    <i class="bi bi-bell-fill bell-ring-anim"></i>
                </div>
                <div>
                    <div class="fw-bold text-white fs-6">
                        ⏰ Scheduled Banner Ka Time Ho Gaya: "@liveBannerAlert.BannerHeading"
                    </div>
                    <div class="text-light small">
                        Scheduled for @liveBannerAlert.ScheduledAt.ToIndianTime().ToString("hh:mm tt") IST &bull; Doctor: <strong>@liveBannerAlert.DoctorName</strong>
                    </div>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-success px-3 py-2 fw-bold d-flex align-items-center gap-2 shadow" @onclick="() => OpenShareModal(liveBannerAlert)" style="background: #25d366; border: none; color: #070d1e;">
                    <i class="bi bi-whatsapp fs-5"></i>
                    <span class="d-none d-sm-inline">Send on WhatsApp / Social (1-Click)</span>
                    <span class="d-inline d-sm-none">Send</span>
                </button>
                <button type="button" class="btn-close btn-close-white" @onclick="() => liveBannerAlert = null" title="Dismiss"></button>
            </div>
        </div>
    }

        <!-- Body Content -->
        <main class="cyh-body">
            @Body
        </main>
    </div>
</div>

<!-- ================= CHANGE PASSWORD & AUDIT HISTORY MODAL ================= -->
@if (isChangePasswordOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0, 0, 0, 0.75); backdrop-filter: blur(8px); z-index: 1055;">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width: 500px;">
            <div class="modal-content text-white rounded-4 shadow-lg" style="background: rgba(14, 25, 48, 0.98); border: 1px solid rgba(245, 158, 11, 0.4); max-height: 90vh;">
                <div class="modal-header border-bottom" style="border-color: rgba(255, 255, 255, 0.1) !important;">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; background: rgba(245, 158, 11, 0.2); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.4);">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold text-white mb-0" style="font-size: 1.05rem;">Change Admin Password</h5>
                            <span class="small text-secondary" style="font-size: 0.72rem;">Security audit logs IP &amp; Geolocation in database</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseChangePasswordModal"></button>
                </div>
                <div class="modal-body p-3 p-md-4" id="changePasswordModalBody" style="scroll-behavior: smooth;">
                    @if (!string.IsNullOrEmpty(pwdErrorMessage))
                    {
                        <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3 d-flex align-items-center gap-2" style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #fca5a5;">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <span>@pwdErrorMessage</span>
                        </div>
                    }

                    <!-- New Password -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-light mb-1">
                            <i class="bi bi-key-fill text-warning me-1"></i>New Password * (Min 6 chars)
                        </label>
                        <div class="input-group">
                            <input type="@(showNewPwd ? "text" : "password")" 
                                   class="form-control bg-dark text-white border-secondary" 
                                   placeholder="Enter new password" 
                                   @bind="newPasswordInput" 
                                   style="border-radius: 8px 0 0 8px; font-size: 0.88rem;" />
                            <button type="button" class="btn btn-outline-secondary" @onclick="() => showNewPwd = !showNewPwd">
                                <i class="bi @(showNewPwd ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Confirm New Password -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-light mb-1">
                            <i class="bi bi-check2-circle text-success me-1"></i>Confirm New Password *
                        </label>
                        <div class="input-group">
                            <input type="@(showConfirmPwd ? "text" : "password")" 
                                   class="form-control bg-dark text-white border-secondary" 
                                   placeholder="Re-enter new password" 
                                   @bind="confirmPasswordInput" 
                                   style="border-radius: 8px 0 0 8px; font-size: 0.88rem;" />
                            <button type="button" class="btn btn-outline-secondary" @onclick="() => showConfirmPwd = !showConfirmPwd">
                                <i class="bi @(showConfirmPwd ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Security Audit Note -->
                    <div class="p-2 rounded-2 mb-3 d-flex align-items-center gap-2" style="background: rgba(0, 242, 254, 0.08); border: 1px solid rgba(0, 242, 254, 0.2); font-size: 0.74rem; color: #a5f3fc;">
                        <i class="bi bi-shield-check text-info fs-6"></i>
                        <span>IP Address &amp; Geolocation database audit history mein automatically save hoga.</span>
                    </div>

                    <!-- Last Password Change Section (Single Last Record) -->
                    <div class="pt-3 border-top" style="border-color: rgba(255, 255, 255, 0.1) !important;">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="small fw-bold text-white d-flex align-items-center gap-1" style="font-size: 0.82rem;">
                                <i class="bi bi-clock-history text-warning"></i> Last Password Change
                            </span>
                            <button type="button" class="btn btn-link btn-sm p-0 text-info text-decoration-none" style="font-size: 0.72rem;" @onclick="LoadPasswordHistoryAsync">
                                <i class="bi bi-arrow-clockwise"></i> Refresh
                            </button>
                        </div>

                        @if (isLoadingHistory)
                        {
                            <div class="text-center py-2 text-secondary small">
                                <span class="spinner-border spinner-border-sm me-1"></span> Loading last record...
                            </div>
                        }
                        else if (passwordHistory.Count == 0)
                        {
                            <div class="p-2 rounded-2 text-center text-secondary small" style="background: rgba(0, 0, 0, 0.25); font-size: 0.74rem;">
                                Abhi tak koi password change record nahi hai.
                            </div>
                        }
                        else
                        {
                            var last = passwordHistory.First();
                            <div class="p-2 rounded-2" style="background: rgba(3, 8, 20, 0.7); border: 1px solid rgba(255, 255, 255, 0.08); font-size: 0.74rem;">
                                <div class="d-flex align-items-start justify-content-between gap-2">
                                    <div>
                                        <div class="text-white fw-semibold d-flex align-items-center gap-1">
                                            <i class="bi bi-geo-alt-fill text-danger" style="font-size: 0.72rem;"></i>
                                            <span>@(string.IsNullOrWhiteSpace(last.LocationSummary) ? "Location Logged" : last.LocationSummary)</span>
                                        </div>
                                        <div class="text-secondary mt-1">
                                            <span class="text-info font-monospace">IP: @last.IpAddress</span>
                                            @if (last.Latitude.HasValue && last.Longitude.HasValue)
                                            {
                                                <span class="ms-1 text-white-50">(@last.Latitude.Value.ToString("0.0000"), @last.Longitude.Value.ToString("0.0000"))</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="text-end text-nowrap">
                                        <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3); font-size: 0.65rem;">
                                            @last.ChangedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer border-top" style="border-color: rgba(255, 255, 255, 0.1) !important;">
                    <button type="button" class="btn btn-secondary btn-sm px-3" @onclick="CloseChangePasswordModal" disabled="@isChangingPwd">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-warning btn-sm px-3 fw-bold text-dark d-flex align-items-center gap-2" @onclick="HandleChangePasswordAsync" disabled="@isChangingPwd" style="background: linear-gradient(135deg, #f59e0b, #fbbf24); border: none;">
                        @if (isChangingPwd)
                        {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                            <span>Updating...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-lg"></i>
                            <span>Update Password</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- 1-Click Interactive Social & WhatsApp Share Modal -->
@if (activeShareModalSchedule != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0, 0, 0, 0.85); backdrop-filter: blur(10px); z-index: 1090;">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content glass-panel" style="background: rgba(14, 25, 48, 0.98); border: 1px solid rgba(245, 158, 11, 0.4); border-radius: 20px;">
                <div class="modal-header border-bottom border-secondary border-opacity-25 px-4 py-3 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-send-check-fill text-warning fs-4"></i>
                        <div>
                            <h5 class="modal-title text-white fw-bold mb-0">1-Click Social &amp; WhatsApp Share</h5>
                            <span class="text-secondary small">Scheduled post share karne ke liye ready hai</span>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <!-- Sound Choice Button in Modal -->
                        <button type="button" class="btn btn-sm @(isSoundEnabled ? "btn-outline-warning text-warning" : "btn-outline-secondary text-muted") py-1 px-2 d-flex align-items-center gap-1" 
                                @onclick="ToggleSoundChoice" 
                                style="font-size: 0.76rem; border-radius: 8px;" 
                                title="@(isSoundEnabled ? "Sound Alert is ON - Click to Mute" : "Sound Alert is OFF - Click to Unmute")">
                            <i class="bi @(isSoundEnabled ? "bi-volume-up-fill text-warning" : "bi-volume-mute-fill text-secondary")"></i>
                            <span>Sound: @(isSoundEnabled ? "ON" : "OFF")</span>
                        </button>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => activeShareModalSchedule = null"></button>
                    </div>
                </div>

                <div class="modal-body p-4">
                    <!-- Banner Visual Preview -->
                    <div class="row g-3 mb-4 align-items-center">
                        <div class="col-md-4 col-12 text-center">
                            @if (!string.IsNullOrEmpty(activeShareModalSchedule.ImageUrl))
                            {
                                <img src="@activeShareModalSchedule.ImageUrl" alt="Banner" class="img-fluid rounded-3 shadow border border-secondary border-opacity-50" style="max-height: 180px; object-fit: contain;" />
                            }
                            else
                            {
                                <div class="rounded-3 bg-dark p-4 text-warning border border-secondary border-opacity-25">
                                    <i class="bi bi-image fs-1"></i>
                                </div>
                            }
                        </div>
                        <div class="col-md-8 col-12">
                            <h5 class="text-white fw-bold mb-1">@activeShareModalSchedule.BannerHeading</h5>
                            <div class="text-secondary small mb-2">
                                <i class="bi bi-hospital me-1"></i>@(activeShareModalSchedule.HospitalName ?? "CYH Hospital") &bull;
                                <span class="text-warning fw-semibold">Dr. @activeShareModalSchedule.DoctorName</span>
                            </div>
                            <div class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-50 px-3 py-1 rounded-pill small">
                                ⏰ Scheduled Time: @activeShareModalSchedule.ScheduledAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                            </div>
                        </div>
                    </div>

                    <!-- Caption Preview Box with Copy Button -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label text-white fw-bold small mb-0">Message &amp; Caption:</label>
                            <button type="button" class="btn btn-outline-warning btn-sm py-1 px-2" @onclick="CopyCaptionText" style="font-size: 0.75rem;">
                                <i class="bi @(isCopied ? "bi-check2 text-success" : "bi-clipboard") me-1"></i>
                                @(isCopied ? "Copied!" : "Copy Caption")
                            </button>
                        </div>
                        <div class="p-3 rounded-3 bg-dark text-light border border-secondary border-opacity-25 small" style="white-space: pre-wrap; max-height: 130px; overflow-y: auto;">
                            @activeShareModalSchedule.Caption
                        </div>
                    </div>

                    <!-- 1-Click Action Buttons -->
                    <div class="mb-2">
                        <label class="form-label text-secondary small fw-bold mb-2">1-CLICK SHARE NOW (Bina kisi API key ke direct open hoga):</label>
                        <div class="d-grid gap-2">
                            <!-- WhatsApp 1-Click Send -->
                            <button type="button" class="btn btn-success py-3 px-4 fw-bold fs-6 d-flex align-items-center justify-content-center gap-2 rounded-3 shadow"
                                    @onclick="() => TriggerWhatsAppShare(activeShareModalSchedule)" style="background: linear-gradient(135deg, #25d366 0%, #128c7e 100%); border: none; color: #ffffff;">
                                <i class="bi bi-whatsapp fs-4"></i>
                                <span>Send on WhatsApp (1-Click Web / App)</span>
                            </button>

                            <div class="row g-2 mt-1">
                                <!-- Facebook Share -->
                                <div class="col-md-4 col-12">
                                    <button type="button" class="btn btn-primary w-100 py-2 d-flex align-items-center justify-content-center gap-2 rounded-3 fw-semibold"
                                            @onclick="() => TriggerFacebookShare(activeShareModalSchedule)" style="background: #1877f2; border: none;">
                                        <i class="bi bi-facebook fs-5"></i>
                                        <span>Facebook</span>
                                    </button>
                                </div>
                                <!-- Instagram Share -->
                                <div class="col-md-4 col-12">
                                    <button type="button" class="btn w-100 py-2 d-flex align-items-center justify-content-center gap-2 rounded-3 fw-semibold text-white"
                                            @onclick="() => TriggerInstagramShare(activeShareModalSchedule)" 
                                            style="background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%); border: none;">
                                        <i class="bi bi-instagram fs-5"></i>
                                        <span>Instagram</span>
                                    </button>
                                </div>
                                <!-- Twitter / X Share -->
                                <div class="col-md-4 col-12">
                                    <button type="button" class="btn btn-outline-light w-100 py-2 d-flex align-items-center justify-content-center gap-2 rounded-3 fw-semibold"
                                            @onclick="() => TriggerTwitterShare(activeShareModalSchedule)" style="border-color: rgba(255, 255, 255, 0.4);">
                                        <i class="bi bi-twitter-x fs-5"></i>
                                        <span>Twitter / X</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-top border-secondary border-opacity-25 px-4 py-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <!-- Snooze -->
                        @{
                            int currentSnooze = scheduleSnoozeCounts.GetValueOrDefault(activeShareModalSchedule.Id, 0);
                        }
                        @if (currentSnooze < 3)
                        {
                            <button type="button" class="btn btn-outline-warning btn-sm px-3 fw-bold d-flex align-items-center gap-1" 
                                    @onclick="() => SnoozeSchedule(activeShareModalSchedule.Id)" 
                                    style="border-color: #f59e0b; color: #fbbf24; border-radius: 8px;"
                                    title="Is alert ko 5 minute ke liye postpone karein (Maximum 3 baar)">
                                <i class="bi bi-alarm-fill text-warning"></i>
                                <span>Snooze 5 Min (@(currentSnooze + 1)/3)</span>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm px-3 disabled" disabled style="opacity: 0.55; border-radius: 8px;">
                                <i class="bi bi-alarm"></i>
                                <span>Max Snoozes (3/3) Reached</span>
                            </button>
                        }

                        <!-- Cancel Post Button -->
                        <button type="button" class="btn btn-outline-danger btn-sm px-3 fw-semibold d-flex align-items-center gap-1"
                                @onclick="() => CancelScheduleAsync(activeShareModalSchedule.Id)"
                                style="border-color: rgba(239, 68, 68, 0.5); border-radius: 8px;"
                                title="Is post ko cancel karein">
                            <i class="bi bi-x-circle-fill text-danger"></i>
                            <span>Cancel Post</span>
                        </button>
                    </div>

                    <div class="d-flex align-items-center gap-2 ms-auto">
                        <button type="button" class="btn btn-outline-secondary btn-sm px-3" @onclick="() => activeShareModalSchedule = null" style="border-radius: 8px;">
                            Close
                        </button>
                        <button type="button" class="btn btn-success btn-sm px-4 fw-bold d-flex align-items-center gap-2" 
                                @onclick="() => MarkAsCompletedAsync(activeShareModalSchedule.Id)" 
                                style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); border: none; border-radius: 8px; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.4);">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>Mark as Shared &amp; Done</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Floating Toast Notification Popup -->
