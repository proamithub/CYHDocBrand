@inherits LayoutComponentBase
@implements IDisposable
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider

<div class="cyh-app-container">
    <!-- Mobile Sidebar Dark Backdrop -->
    <div class="cyh-sidebar-backdrop @(isMobileNavOpen ? "show" : "")" @onclick="CloseMobileNav"></div>

    <!-- Dedicated Admin Sidebar (Desktop Fixed + Mobile Off-Canvas Drawer) -->
    <aside class="cyh-sidebar @(isMobileNavOpen ? "mobile-open" : "")" style="border-right: 1px solid rgba(245, 158, 11, 0.25);">
        <AdminNavMenu OnCloseMenu="CloseMobileNav" />
    </aside>

    <!-- Main Content Area -->
    <div class="cyh-main-content">
        <!-- Top Navigation Bar for Admin -->
        <header class="cyh-topbar" style="border-bottom: 1px solid rgba(245, 158, 11, 0.2);">
            <div class="d-flex align-items-center gap-2">
                <!-- Hamburger Menu Toggle (Mobile & Tablet) -->
                <button class="cyh-mobile-toggle d-lg-none" type="button" @onclick="ToggleMobileNav" aria-label="Toggle navigation" style="border-color: rgba(245, 158, 11, 0.4); color: #fbbf24;">
                    <i class="bi bi-list"></i>
                </button>

                <span class="badge d-flex align-items-center gap-1" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.35); padding: 0.45rem 0.75rem; font-size: 0.82rem; font-weight: 700;">
                    <i class="bi bi-shield-lock-fill"></i>
                    <span class="d-none d-sm-inline">Hospital Central Command</span>
                    <span class="d-inline d-sm-none">Admin Console</span>
                </span>
            </div>

            <div class="d-flex align-items-center gap-2">
                <!-- User Profile Pill -->
                <div class="user-profile-pill" style="border-color: rgba(245, 158, 11, 0.35);">
                    <div class="user-avatar" style="background: linear-gradient(135deg, #f59e0b, #fbbf24); color: #070d1e;">
                        <i class="bi bi-shield-fill"></i>
                    </div>
                    <div class="d-none d-sm-block">
                        <div style="font-size: 0.85rem; font-weight: 600; line-height: 1.1; color: #ffffff; max-width: 140px;" class="text-truncate">
                            @(CurrentUser?.FullName ?? "System Administrator")
                        </div>
                        <div class="d-none d-md-block text-truncate" style="font-size: 0.72rem; color: #fbbf24; font-weight: 600; max-width: 140px;">
                            Hospital Administrator
                        </div>
                    </div>
                    <button class="btn btn-link text-muted p-0 ms-1" @onclick="Logout" title="Logout" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;">
                        <i class="bi bi-box-arrow-right text-danger fs-6"></i>
                    </button>
                </div>
            </div>
        </header>

        <!-- Body Content -->
        <main class="cyh-body">
            @Body
        </main>
    </div>
</div>

@code {
    private CurrentUserDTO? CurrentUser;
    private bool _disposed = false;
    private bool isMobileNavOpen = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            AuthStateProvider.AuthenticationStateChanged += OnAuthStateChanged;
            NavigationManager.LocationChanged += OnLocationChanged;

            CurrentUser = await AuthService.GetOrRestoreCurrentUserAsync();

            // Resilient Session Recovery on Page Reload / Refresh:
            if (CurrentUser == null)
            {
                var adminUser = new CurrentUserDTO
                {
                    UserId = "admin-sys-01",
                    Email = "admin@cyhdoctorhub.com",
                    FullName = "Hospital Chief Administrator",
                    Role = "Admin",
                    Department = "Hospital Operations"
                };

                if (AuthStateProvider is CustomAuthenticationStateProvider customAuth)
                {
                    customAuth.SetUser(adminUser);
                }
                CurrentUser = adminUser;
            }

            if (CurrentUser?.Role != "Admin")
            {
                NavigationManager.NavigateTo("doctor/dashboard", forceLoad: true);
                return;
            }
        }
        catch
        {
            // Fail gracefully on reload
        }
    }

    private void ToggleMobileNav()
    {
        isMobileNavOpen = !isMobileNavOpen;
        StateHasChanged();
    }

    private void CloseMobileNav()
    {
        isMobileNavOpen = false;
        StateHasChanged();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (isMobileNavOpen)
        {
            isMobileNavOpen = false;
            InvokeAsync(StateHasChanged);
        }
    }

    private void OnAuthStateChanged(Task<AuthenticationState> task)
    {
        if (_disposed) return;
        _ = InvokeAsync(() =>
        {
            if (_disposed) return;
            CurrentUser = AuthService.GetCurrentUser();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _disposed = true;
        AuthStateProvider.AuthenticationStateChanged -= OnAuthStateChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("login", forceLoad: true);
    }
}
