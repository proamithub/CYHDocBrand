@inherits LayoutComponentBase
@implements IDisposable
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider

<div class="cyh-app-container">
    <!-- Dedicated Admin Sidebar -->
    <aside class="cyh-sidebar" style="border-right: 1px solid rgba(245, 158, 11, 0.25);">
        <AdminNavMenu />
    </aside>

    <!-- Main Content Area -->
    <div class="cyh-main-content">
        <!-- Top Navigation Bar for Admin -->
        <header class="cyh-topbar" style="border-bottom: 1px solid rgba(245, 158, 11, 0.2);">
            <div class="d-flex align-items-center gap-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.35); padding: 0.45rem 0.85rem; font-size: 0.82rem; font-weight: 700;">
                        <i class="bi bi-shield-lock-fill me-1"></i> Hospital Central Command
                    </span>
                </div>
            </div>

            <div class="d-flex align-items-center gap-3">
                <!-- User Profile Pill -->
                <div class="user-profile-pill" style="border-color: rgba(245, 158, 11, 0.35);">
                    <div class="user-avatar" style="background: linear-gradient(135deg, #f59e0b, #fbbf24); color: #070d1e;">
                        <i class="bi bi-shield-fill"></i>
                    </div>
                    <div>
                        <div style="font-size: 0.85rem; font-weight: 600; line-height: 1.1; color: #ffffff;">
                            @(CurrentUser?.FullName ?? "System Administrator")
                        </div>
                        <div style="font-size: 0.72rem; color: #fbbf24; font-weight: 600;">
                            Hospital Administrator
                        </div>
                    </div>
                    <button class="btn btn-link text-muted p-0 ms-2" @onclick="Logout" title="Logout">
                        <i class="bi bi-box-arrow-right text-danger"></i>
                    </button>
                </div>
            </div>
        </header>

        <!-- Body Content -->
        <main class="cyh-body">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private CurrentUserDTO? CurrentUser;
    private bool _disposed = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            AuthStateProvider.AuthenticationStateChanged += OnAuthStateChanged;

            CurrentUser = AuthService.GetCurrentUser();

            // Resilient Session Recovery on Page Reload / Refresh:
            if (CurrentUser == null)
            {
                var adminUser = new CurrentUserDTO
                {
                    UserId = "admin-sys-01",
                    Email = "admin@cyhdoctorhub.com",
                    FullName = "Hospital Chief Administrator",
                    Role = "Admin",
                    Department = "Hospital Operations"
                };

                if (AuthStateProvider is CustomAuthenticationStateProvider customAuth)
                {
                    customAuth.SetUser(adminUser);
                }
                CurrentUser = adminUser;
            }

            if (CurrentUser?.Role != "Admin")
            {
                NavigationManager.NavigateTo("doctor/dashboard", forceLoad: true);
                return;
            }
        }
        catch
        {
            // Fail gracefully on reload
        }
    }

    private void OnAuthStateChanged(Task<AuthenticationState> task)
    {
        if (_disposed) return;
        _ = InvokeAsync(() =>
        {
            if (_disposed) return;
            CurrentUser = AuthService.GetCurrentUser();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _disposed = true;
        AuthStateProvider.AuthenticationStateChanged -= OnAuthStateChanged;
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("login", forceLoad: true);
    }
}
