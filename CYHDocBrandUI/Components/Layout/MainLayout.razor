@inherits LayoutComponentBase
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider

<div class="cyh-app-container">
    <!-- Left Glass Sidebar -->
    <aside class="cyh-sidebar">
        <NavMenu />
    </aside>

    <!-- Main Content Area -->
    <div class="cyh-main-content">
        <!-- Top Glass Navigation Bar -->
        <header class="cyh-topbar">
            <div class="d-flex align-items-center gap-3">
                <span class="badge" style="@(IsAdmin ? "background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.35);" : "background: rgba(0, 242, 254, 0.15); color: #38bdf8; border: 1px solid rgba(0, 242, 254, 0.35);") padding: 0.45rem 0.85rem; font-size: 0.82rem; font-weight: 700;">
                    <i class="bi @(IsAdmin ? "bi-shield-lock-fill" : "bi-heart-pulse-fill") me-1"></i>
                    @(IsAdmin ? "Hospital Administration Console" : "Doctor Clinical Workspace")
                </span>
            </div>

            <div class="d-flex align-items-center gap-3">
                <!-- User Profile Pill -->
                <div class="user-profile-pill" style="border-color: @(IsAdmin ? "rgba(245, 158, 11, 0.35)" : "rgba(0, 242, 254, 0.35)");">
                    <div class="user-avatar" style="@(IsAdmin ? "background: linear-gradient(135deg, #f59e0b, #fbbf24); color: #070d1e;" : "")">
                        @(CurrentUser?.FullName.Length > 0 ? CurrentUser.FullName[0] : 'U')
                    </div>
                    <div>
                        <div style="font-size: 0.85rem; font-weight: 600; line-height: 1.1; color: #ffffff;">
                            @(CurrentUser?.FullName ?? "Staff Member")
                        </div>
                        <div style="font-size: 0.72rem; color: @(IsAdmin ? "#fbbf24" : "var(--cyh-accent-cyan)"); font-weight: 600;">
                            @(IsAdmin ? "Hospital Administrator" : (CurrentUser?.Department ?? "Cardiologist"))
                        </div>
                    </div>
                    <button class="btn btn-link text-muted p-0 ms-2" @onclick="Logout" title="Logout">
                        <i class="bi bi-box-arrow-right text-danger"></i>
                    </button>
                </div>
            </div>
        </header>

        <!-- Body Content -->
        <main class="cyh-body">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private CurrentUserDTO? CurrentUser;

    private bool IsDoctor => CurrentUser?.Role == "Doctor";
    private bool IsAdmin => CurrentUser?.Role == "Admin";

    protected override async Task OnInitializedAsync()
    {
        AuthStateProvider.AuthenticationStateChanged += async (task) =>
        {
            await LoadCurrentUserAsync();
            await InvokeAsync(StateHasChanged);
        };

        await LoadCurrentUserAsync();

        if (CurrentUser == null)
        {
            NavigationManager.NavigateTo("login");
            return;
        }
    }

    private async Task LoadCurrentUserAsync()
    {
        CurrentUser = AuthService.GetCurrentUser();
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("login");
    }
}
