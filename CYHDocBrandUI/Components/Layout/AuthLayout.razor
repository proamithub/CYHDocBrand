@inherits LayoutComponentBase

<div class="auth-wrapper">
    <div class="auth-glow-orb auth-glow-1"></div>
    <div class="auth-glow-orb auth-glow-2"></div>
    <div class="auth-glow-orb auth-glow-3"></div>

    <div class="auth-container">
        @Body
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<style>
    .auth-wrapper {
        min-height: 100vh;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        position: relative;
        overflow: hidden;
        background-color: var(--cyh-bg-main, #070d1e);
    }

    .auth-glow-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        pointer-events: none;
        opacity: 0.35;
    }

    .auth-glow-1 {
        width: 450px;
        height: 450px;
        background: radial-gradient(circle, #00f2fe 0%, rgba(0, 242, 254, 0) 70%);
        top: -100px;
        left: -100px;
        animation: float-slow 12s ease-in-out infinite alternate;
    }

    .auth-glow-2 {
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, #4facfe 0%, rgba(79, 172, 254, 0) 70%);
        bottom: -120px;
        right: -100px;
        animation: float-slow 14s ease-in-out infinite alternate-reverse;
    }

    .auth-glow-3 {
        width: 350px;
        height: 350px;
        background: radial-gradient(circle, #8b5cf6 0%, rgba(139, 92, 246, 0) 70%);
        top: 40%;
        left: 60%;
        opacity: 0.2;
    }

    .auth-container {
        position: relative;
        z-index: 10;
        width: 100%;
        max-width: 460px;
    }

    @@keyframes float-slow {
        0% { transform: translateY(0px) scale(1); }
        100% { transform: translateY(40px) scale(1.08); }
    }
</style>
