@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<div class="cyh-brand">
    <div class="cyh-brand-logo" style="background: transparent; box-shadow: none;">
        <img src="images/branding/cyh-emblem.png" alt="CYH" style="width: 100%; height: 100%; object-fit: contain;" />
    </div>
    <div class="flex-grow-1 min-w-0" style="overflow: hidden;">
        <div class="cyh-brand-title text-truncate">CYH @(IsAdmin ? "AdminHub" : "DoctorHub")</div>
        <div class="cyh-brand-subtitle text-truncate" style="@(IsAdmin ? "color: #fbbf24;" : "") font-size: 0.72rem;">
            @(IsAdmin ? "Hospital Command" : "Clinical Portal")
        </div>
    </div>
    <!-- Mobile Close Button -->
    <button type="button" class="cyh-sidebar-close-btn d-lg-none" @onclick="HandleClose" @onclick:stopPropagation="true" aria-label="Close menu" title="Close menu" style="@(IsAdmin ? "border-color: rgba(245, 158, 11, 0.45); color: #fbbf24; background: rgba(245, 158, 11, 0.1);" : "border-color: rgba(0, 242, 254, 0.45); color: #00f2fe; background: rgba(0, 242, 254, 0.1);")">
        <i class="bi bi-x-lg"></i>
    </button>
</div>

<div class="cyh-nav">
    @if (IsAdmin)
    {
        <div class="cyh-nav-divider">Hospital Administration</div>

        <NavLink class="cyh-nav-item" href="admin/dashboard" Match="NavLinkMatch.All" @onclick="HandleClose">
            <i class="bi bi-speedometer2 text-warning"></i>
            <span>Admin Dashboard</span>
        </NavLink>

        <NavLink class="cyh-nav-item" href="admin/doctors" @onclick="HandleClose">
            <i class="bi bi-people-fill text-warning"></i>
            <span>Manage Specialists</span>
        </NavLink>

        <NavLink class="cyh-nav-item" href="template-gallery" @onclick="HandleClose">
            <i class="bi bi-grid-1x2-fill text-warning"></i>
            <span>Template Gallery</span>
        </NavLink>

        <NavLink class="cyh-nav-item" href="banner-design" @onclick="HandleClose">
            <i class="bi bi-palette-fill text-warning"></i>
            <span>AI Banner Studio</span>
        </NavLink>

        <NavLink class="cyh-nav-item" href="banner-designs" @onclick="HandleClose">
            <i class="bi bi-collection-play-fill text-warning"></i>
            <span>Banner Designs List</span>
        </NavLink>

        <NavLink class="cyh-nav-item" href="admin/schedules" @onclick="HandleClose">
            <i class="bi bi-broadcast-pin text-warning"></i>
            <span>Social Schedules Monitor</span>
        </NavLink>

        <NavLink class="cyh-nav-item" href="admin/credit-history" @onclick="HandleClose">
            <i class="bi bi-clock-history text-info"></i>
            <span>Credit &amp; Usage History</span>
        </NavLink>

        <NavLink class="cyh-nav-item" href="admin/system" @onclick="HandleClose">
            <i class="bi bi-cpu-fill text-warning"></i>
            <span>System Infrastructure</span>
        </NavLink>
    }
    else
    {
        <div class="cyh-nav-divider">Navigation</div>

        <NavLink class="cyh-nav-item" href="doctor/dashboard" Match="NavLinkMatch.All" @onclick="HandleClose">
            <i class="bi bi-hospital-fill text-info"></i>
            <span>Doctor Dashboard</span>
        </NavLink>

        <NavLink class="cyh-nav-item" href="doctor/profile" @onclick="HandleClose">
            <i class="bi bi-person-circle text-info"></i>
            <span>My Profile</span>
        </NavLink>

        <NavLink class="cyh-nav-item" href="doctor/template-gallery" @onclick="HandleClose">
            <i class="bi bi-grid-1x2-fill text-info"></i>
            <span>Template Gallery</span>
        </NavLink>

        <NavLink class="cyh-nav-item" href="banner-design" @onclick="HandleClose">
            <i class="bi bi-palette-fill text-info"></i>
            <span>AI Banner Studio</span>
        </NavLink>

        <NavLink class="cyh-nav-item" href="banner-designs" @onclick="HandleClose">
            <i class="bi bi-collection-play-fill text-info"></i>
            <span>Banner Designs List</span>
        </NavLink>

        <NavLink class="cyh-nav-item" href="doctor/schedules" @onclick="HandleClose">
            <i class="bi bi-calendar2-check-fill text-info"></i>
            <span>Scheduled Posts</span>
        </NavLink>

        <NavLink class="cyh-nav-item" href="credit-history" @onclick="HandleClose">
            <i class="bi bi-clock-history text-info"></i>
            <span>Credit &amp; Usage History</span>
        </NavLink>
    }
</div>

<div class="cyh-sidebar-footer" style="padding: 0.9rem 1rem;">
    <!-- Live Server Time (Indian Standard Time) -->
    <div class="mb-2 d-flex justify-content-center">
        <ServerTimeClock />
    </div>

    <!-- PWA Install WebApp Button -->
    <button type="button" 
            class="btn cyh-pwa-install-btn w-100 d-flex align-items-center justify-content-center gap-2 py-2 mb-2" 
            id="pwaInstallBtn"
            onclick="window.cyhPwa && window.cyhPwa.promptInstall()"
            style="border-radius: 10px; font-size: 0.84rem; font-weight: 600; background: rgba(0, 242, 254, 0.1); border: 1px solid rgba(0, 242, 254, 0.35); color: #38bdf8; transition: all 0.2s ease;">
        <i class="bi bi-download"></i>
        <span>Install Web App</span>
    </button>
    <button type="button" class="glass-btn-danger w-100 d-flex align-items-center justify-content-center gap-2 py-2" @onclick="Logout" style="border-radius: 10px; font-size: 0.88rem; font-weight: 600; cursor: pointer; transition: all 0.2s ease;">
        <i class="bi bi-box-arrow-right"></i>
        <span>Logout</span>
    </button>
</div>

@code {
    [Parameter]
    public EventCallback OnCloseMenu { get; set; }

    private CurrentUserDTO? CurrentUser;
    private bool IsAdmin => CurrentUser?.Role == "Admin";

    protected override async Task OnInitializedAsync()
    {
        CurrentUser = await AuthService.GetOrRestoreCurrentUserAsync();
    }

    private async Task HandleClose()
    {
        if (OnCloseMenu.HasDelegate)
        {
            await OnCloseMenu.InvokeAsync();
        }
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("login");
    }
}
