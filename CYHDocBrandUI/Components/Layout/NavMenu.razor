@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<div class="cyh-brand">
    <div class="cyh-brand-logo" style="@(IsAdmin ? "background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%); color: #070d1e;" : "")">
        <i class="bi @(IsAdmin ? "bi-shield-shaded" : "bi-heart-pulse-fill")"></i>
    </div>
    <div>
        <div class="cyh-brand-title">CYH @(IsAdmin ? "AdminHub" : "DoctorHub")</div>
        <div class="cyh-brand-subtitle" style="@(IsAdmin ? "color: #fbbf24;" : "")">
            @(IsAdmin ? "Hospital Command" : "Clinical Portal")
        </div>
    </div>
</div>

<div class="cyh-nav">
    @if (IsAdmin)
    {
        <div class="cyh-nav-divider" style="color: #cbd5e1;">Hospital Administration</div>

        <NavLink class="cyh-nav-item" href="admin/dashboard" Match="NavLinkMatch.All">
            <i class="bi bi-speedometer2 text-warning"></i>
            <span>Admin Dashboard</span>
        </NavLink>

        <NavLink class="cyh-nav-item" href="admin/doctors">
            <i class="bi bi-people-fill text-warning"></i>
            <span>Manage Specialists</span>
        </NavLink>

        <NavLink class="cyh-nav-item" href="admin/system">
            <i class="bi bi-cpu-fill text-warning"></i>
            <span>System Infrastructure</span>
        </NavLink>
    }
    else
    {
        <div class="cyh-nav-divider" style="color: #cbd5e1;">Navigation</div>

        <NavLink class="cyh-nav-item" href="doctor/dashboard" Match="NavLinkMatch.All">
            <i class="bi bi-hospital-fill text-info"></i>
            <span>Doctor Dashboard</span>
        </NavLink>

        <NavLink class="cyh-nav-item" href="doctor/profile">
            <i class="bi bi-person-circle text-info"></i>
            <span>My Profile</span>
        </NavLink>

        <NavLink class="cyh-nav-item" href="doctor/schedule">
            <i class="bi bi-calendar3-week text-info"></i>
            <span>OPD Timings & Duty</span>
        </NavLink>

        <NavLink class="cyh-nav-item" href="doctor/colleagues">
            <i class="bi bi-person-badge-fill text-info"></i>
            <span>Hospital Faculty</span>
        </NavLink>
    }
</div>

<div class="cyh-sidebar-footer" style="padding: 0.9rem 1rem;">
    <button type="button" class="glass-btn-danger w-100 d-flex align-items-center justify-content-center gap-2 py-2" @onclick="Logout" style="border-radius: 10px; font-size: 0.88rem; font-weight: 600; cursor: pointer; transition: all 0.2s ease;">
        <i class="bi bi-box-arrow-right"></i>
        <span>Logout</span>
    </button>
</div>

@code {
    private CurrentUserDTO? CurrentUser;
    private bool IsAdmin => CurrentUser?.Role == "Admin";

    protected override void OnInitialized()
    {
        CurrentUser = AuthService.GetCurrentUser();
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("login");
    }
}
