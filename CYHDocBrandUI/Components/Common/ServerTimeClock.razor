@using CYHDocBrandModel.Common
@inject IJSRuntime JSRuntime

<div class="cyh-server-time-pill d-flex align-items-center gap-2 px-2 px-md-3 py-1 rounded-pill"
     style="background: rgba(14, 25, 48, 0.75); border: 1px solid rgba(0, 242, 254, 0.35); box-shadow: 0 0 10px rgba(0, 242, 254, 0.1);"
     title="Live Server Time (Indian Standard Time - IST / UTC+05:30)">
    <span class="live-dot" style="width: 8px; height: 8px; border-radius: 50%; background: #10b981; box-shadow: 0 0 8px #10b981; display: inline-block;"></span>
    <i class="bi bi-clock-fill text-warning" style="font-size: 0.85rem;"></i>
    <div class="d-flex align-items-center gap-1 font-monospace" style="font-size: 0.82rem; font-weight: 600;">
        <span class="cyh-live-time-display text-white">@IndianTimeHelper.Now.ToString("hh:mm:ss tt")</span>
        <span class="badge bg-info bg-opacity-25 text-info px-1 py-0 ms-1 d-none d-sm-inline" style="font-size: 0.68rem; border: 1px solid rgba(0, 242, 254, 0.35);">IST</span>
        <span class="text-secondary d-none d-lg-inline ms-1 cyh-live-date-display" style="font-size: 0.75rem;">@IndianTimeHelper.Now.ToString("dd MMM yyyy")</span>
    </div>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("cyhLiveClock.start");
            }
            catch { }
        }
    }
}
