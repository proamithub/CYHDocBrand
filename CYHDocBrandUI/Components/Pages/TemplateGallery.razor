    private async Task<bool> EnsureBannerStudioLoadedAsync()
    {
        try
        {
            var isReady = await JSRuntime.InvokeAsync<bool>("eval", @"
                new Promise((resolve) => {
                    if (typeof window.bannerStudio !== 'undefined' && typeof window.bannerStudio.renderBanner === 'function') {
                        return resolve(true);
                    }
                    const existing = document.getElementById('banner-studio-dynamic-script');
                    if (existing) existing.remove();
                    const s = document.createElement('script');
                    s.id = 'banner-studio-dynamic-script';
                    s.src = 'js/bannerStudio.js?v=' + Date.now();
                    s.onload = () => resolve(typeof window.bannerStudio !== 'undefined' && typeof window.bannerStudio.renderBanner === 'function');
                    s.onerror = () => resolve(false);
                    document.head.appendChild(s);
                })
            ");
            return isReady;
        }
        catch
        {
            return false;
        }
    }

    private async Task QuickDownloadTemplate(BannerTemplateDTO tpl)
    {
        try
        {
            // Credit check for Doctor on template export
            if (currentUser?.Role == "Doctor" && doctorProfile != null && doctorProfile.Id > 0)
            {
                var (ok, msg, remaining) = await CreditRepo.DeductCreditOnPublishAsync(
                    doctorProfile.Id,
                    "TEMPLATE_PUBLISH",
                    tpl.Id.ToString(),
                    $"Template Branded Export #{tpl.Id}: {tpl.Title}");

                if (!ok)
                {
                    ShowPopup("Insufficient Credits", msg, "warning");
                    return;
                }
            }
            await EnsureBannerStudioLoadedAsync();

            var config = tpl.GetConfigState();
            config.Heading = tpl.DefaultHeading;
            config.Subtitle = tpl.DefaultSubtitle ?? config.Subtitle;
            config.BadgeText = tpl.BadgeText ?? config.BadgeText;
            config.BackgroundImageUrl = tpl.BackgroundImageUrl;
            config.PrimaryColor = tpl.PrimaryColor;
            config.SecondaryColor = tpl.SecondaryColor;

            // Apply Doctor Branding
            if (doctorProfile != null)
            {
                config.DoctorName = !string.IsNullOrWhiteSpace(doctorProfile.DisplayName) ? doctorProfile.DisplayName : doctorProfile.FullName;
                if (!string.IsNullOrWhiteSpace(doctorProfile.Qualifications) && !config.DoctorName.Contains(doctorProfile.Qualifications))
                {
                    config.DoctorName += $", {doctorProfile.Qualifications}";
                }
                if (!string.IsNullOrWhiteSpace(doctorProfile.ClinicName)) config.HospitalName = doctorProfile.ClinicName;
                if (!string.IsNullOrWhiteSpace(doctorProfile.MobileNo)) config.ContactPhone = doctorProfile.MobileNo;
                if (!string.IsNullOrWhiteSpace(doctorProfile.ClinicAddress)) config.Address = doctorProfile.ClinicAddress;
                if (!string.IsNullOrWhiteSpace(doctorProfile.Specialization)) config.Specialization = doctorProfile.Specialization;
            }

            var filename = $"CYH_Template_{tpl.Id}_{DateTime.Now:yyyyMMdd_HHmm}.png";

            // Render to quickExportCanvas and trigger download via bannerStudio JS
            await JSRuntime.InvokeVoidAsync("bannerStudio.renderBanner", "quickExportCanvas", config);
            await Task.Delay(300); // Allow image paint
            await JSRuntime.InvokeVoidAsync("bannerStudio.downloadBanner", "quickExportCanvas", filename);

            ShowPopup("PNG Downloaded", $"Template #{tpl.Id} '{tpl.Title}' branded PNG download ho gaya hai!", "save");
        }
        catch (Exception ex)
        {
            ShowPopup("Download Error", ex.Message, "error");
        }
    }

    private async Task QuickShareTemplate(BannerTemplateDTO tpl)
    {
        try
        {
            await EnsureBannerStudioLoadedAsync();

            var docName = doctorProfile != null ? (!string.IsNullOrWhiteSpace(doctorProfile.DisplayName) ? doctorProfile.DisplayName : doctorProfile.FullName) : "Our Doctor";
            var clinicName = doctorProfile != null && !string.IsNullOrWhiteSpace(doctorProfile.ClinicName) ? doctorProfile.ClinicName : "CYH Hospital";
            var phone = doctorProfile != null && !string.IsNullOrWhiteSpace(doctorProfile.MobileNo) ? doctorProfile.MobileNo : "";

            var shareTitle = $"{tpl.DefaultHeading} — {clinicName}";
            var shareText = $"🏥 *{clinicName}*\n🩺 *{docName}*\n\n✨ *{tpl.DefaultHeading}*\n{tpl.DefaultSubtitle}\n\n📞 Helpline: {phone}\n🌐 Book Appointment: https://www.clickyourhospital.com";

            // Use Web Share API or WhatsApp direct
            var config = tpl.GetConfigState();
            config.BackgroundImageUrl = tpl.BackgroundImageUrl;
            await JSRuntime.InvokeVoidAsync("bannerStudio.renderBanner", "quickExportCanvas", config);
            await Task.Delay(300);

            var res = await JSRuntime.InvokeAsync<ShareResult>("bannerStudio.shareBanner", "quickExportCanvas", shareTitle, shareText);
            if (res.Success)
            {
                ShowPopup("Shared Successfully", res.Message, "save");
            }
            else
            {
                ShowPopup("Share Info", res.Message, "warning");
            }
        }
        catch (Exception ex)
        {
            ShowPopup("Share Error", ex.Message, "error");
        }
    }

