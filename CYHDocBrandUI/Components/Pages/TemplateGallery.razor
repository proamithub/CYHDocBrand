    protected override async Task OnInitializedAsync()
    {
        currentUser = await AuthService.GetOrRestoreCurrentUserAsync();
        if (currentUser != null && !currentUser.IsActive && currentUser.Role == "Doctor")
        {
            NavigationManager.NavigateTo("doctor/profile");
            return;
        }

        // Fetch Doctor Profile for branding preview
        if (currentUser != null)
        {
            try
            {
                if (currentUser.DoctorProfileId.HasValue)
                {
                    doctorProfile = await DoctorRepo.GetByIdAsync(currentUser.DoctorProfileId.Value);
                }
                if (doctorProfile == null && !string.IsNullOrEmpty(currentUser.UserId))
                {
                    doctorProfile = await DoctorRepo.GetByUserIdAsync(currentUser.UserId);
                }
            }
            catch { }
        }

        await LoadDataFromSqlAsync();
    }

    private async Task LoadDataFromSqlAsync()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            // 1. Fetch Dynamic Categories from SQL (with template counts)
            categories = await TemplateRepo.GetCategoriesAsync(onlyActive: true);

            // 2. Fetch all 50 Templates from SQL
            allTemplates = await TemplateRepo.GetAllTemplatesAsync();

            // Extract distinct styles for filter dropdown
            availableStyles = allTemplates
                .Select(t => t.StyleTheme)
                .Where(s => !string.IsNullOrWhiteSpace(s))
                .Distinct()
                .OrderBy(s => s)
                .ToList();

            ApplyFilters();
        }
        catch (Exception ex)
        {
            ShowPopup("Error Loading Templates", ex.Message, "error");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void SelectCategory(int categoryId)
    {
        selectedCategoryId = categoryId;
        ApplyFilters();
    }

    private void SetAspectRatio(string ratio)
    {
        selectedAspectRatio = ratio;
        ApplyFilters();
    }

    private string selectedLanguage = "All"; // "All", "hi", "en"

    private void SetLanguageFilter(string lang)
    {
        selectedLanguage = lang;
        ApplyFilters();
    }

    private void ClearSearch()
    {
        searchQuery = string.Empty;
        ApplyFilters();
    }

    private void ResetAllFilters()
    {
        selectedCategoryId = 0;
        selectedStyle = "All";
        selectedAspectRatio = "All";
        selectedLanguage = "All";
        searchQuery = string.Empty;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        var q = allTemplates.AsEnumerable();

        if (selectedCategoryId > 0)
        {
            q = q.Where(t => t.CategoryId == selectedCategoryId);
        }

        if (!string.IsNullOrWhiteSpace(selectedLanguage) && selectedLanguage != "All")
        {
            if (selectedLanguage == "hi")
            {
                q = q.Where(t => t.Language == "hi" ||
                    System.Text.RegularExpressions.Regex.IsMatch((t.DefaultHeading ?? "") + " " + (t.DefaultSubtitle ?? "") + " " + t.Title, @"[\u0900-\u097F]"));
            }
            else if (selectedLanguage == "en")
            {
                q = q.Where(t => t.Language == "en" &&
                    !System.Text.RegularExpressions.Regex.IsMatch((t.DefaultHeading ?? "") + " " + (t.DefaultSubtitle ?? "") + " " + t.Title, @"[\u0900-\u097F]"));
            }
        }

        if (!string.IsNullOrWhiteSpace(selectedStyle) && selectedStyle != "All")
        {
            q = q.Where(t => string.Equals(t.StyleTheme, selectedStyle, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(selectedAspectRatio) && selectedAspectRatio != "All")
        {
            q = q.Where(t => string.Equals(t.AspectRatio, selectedAspectRatio, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var s = searchQuery.Trim().ToLowerInvariant();
            q = q.Where(t => 
                (t.Title?.ToLowerInvariant().Contains(s) ?? false) ||
                (t.DefaultHeading?.ToLowerInvariant().Contains(s) ?? false) ||
                (t.DefaultSubtitle?.ToLowerInvariant().Contains(s) ?? false) ||
                (t.CategoryName?.ToLowerInvariant().Contains(s) ?? false) ||
                (t.BadgeText?.ToLowerInvariant().Contains(s) ?? false) ||
                (t.StyleTheme?.ToLowerInvariant().Contains(s) ?? false)
            );
        }

        filteredTemplates = q.ToList();
        StateHasChanged();
    }

