                        @if (!string.IsNullOrEmpty(deletingItem.ImageUrl))
                        {
                            <img src="@deletingItem.ImageUrl" class="rounded-2 border border-secondary border-opacity-50" style="width: 55px; height: 55px; object-fit: cover;" />
                        }
                        <div class="min-w-0 flex-grow-1">
                            <div class="fw-bold text-white text-truncate">@deletingItem.BannerHeading</div>
                            <div class="text-info small">Doctor: @deletingItem.DoctorName</div>
                            <div class="text-warning small">
                                <i class="bi bi-clock me-1"></i>Scheduled: @deletingItem.ScheduledAt.ToIndianTime().ToString("dd MMM yyyy, hh:mm tt") IST
                            </div>
                        </div>
                    </div>
                    <p class="text-light small mb-0">
                        Kya aap sach me Dr. @deletingItem.DoctorName ke is scheduled post ko delete karna chahte hain?
                    </p>
                </div>
                <div class="modal-footer border-0 pt-0 pb-4 px-4 gap-2">
                    <button type="button" class="btn btn-outline-secondary px-4 py-2" @onclick="() => deletingItem = null">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-danger px-4 py-2 fw-bold d-flex align-items-center gap-2" 
                            @onclick="ExecuteDeleteScheduleAsync" style="background: #ef4444; border: none; border-radius: 9px;">
                        <i class="bi bi-trash3-fill"></i>
                        <span>Yes, Delete Permanently</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

