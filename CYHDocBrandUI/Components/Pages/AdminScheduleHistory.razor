@page "/admin/schedules"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using CYHDocBrandModel.DTO
@using CYHDocBrandData.Entities
@using CYHDocBrandRepo.IRepository
@using CYHDocBrandUI.Services
@using CYHDocBrandUI.Components.Common

@inject IBannerScheduleRepository ScheduleRepo
@inject IDoctorRepository DoctorRepo
@inject IAuthService AuthService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<!-- Animated Floating Toast Popup -->
<ToastPopup Notification="activePopup" OnDismiss="DismissPopup" />

<div class="container-fluid px-3 px-md-4 py-4 fade-in" style="max-width: 1400px;">
    <!-- Page Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge px-3 py-2" style="background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.4); color: #fbbf24; border-radius: 8px; font-weight: 700;">
                    <i class="bi bi-broadcast-pin me-1"></i> ADMIN COMMAND CENTER
                </span>
                <span class="text-secondary" style="font-size: 0.85rem;">Hospital Banner Auto-Publisher</span>
            </div>
            <h2 class="mt-2 mb-1 fw-bold text-white" style="letter-spacing: -0.5px;">
                Social Media Schedules &amp; Publish Monitor
            </h2>
            <p class="text-secondary mb-0" style="font-size: 0.92rem;">
                Doctor-wise real-time audit log of scheduled banners, target platforms, live image previews, execution statuses, and direct social links.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline-warning d-flex align-items-center gap-2 px-3 py-2" @onclick="RefreshDataAsync" disabled="@isLoading">
                <i class="bi bi-arrow-repeat @(isLoading ? "spin-animation" : "")"></i>
                <span>@(isLoading ? "Refreshing..." : "Refresh Queue")</span>
            </button>
            <NavLink href="admin/banner-designs" class="btn btn-outline-info d-flex align-items-center gap-2 px-3 py-2">
                <i class="bi bi-collection-play"></i>
                <span>Banner Library</span>
            </NavLink>
        </div>
    </div>

    <!-- Top KPI Summary Cards -->
    <div class="row g-3 mb-4">
        <!-- Total -->
        <div class="col-xl-2 col-md-4 col-6">
            <div class="p-3 rounded-4 glass-panel h-100 d-flex flex-column justify-content-between" style="background: rgba(14, 25, 48, 0.65); border: 1px solid rgba(255, 255, 255, 0.08);">
                <div class="text-secondary small fw-semibold">TOTAL SCHEDULED</div>
                <div class="d-flex align-items-center justify-content-between mt-2">
                    <h3 class="fw-bold text-white mb-0">@summary.TotalScheduled</h3>
                    <div class="p-2 rounded-3 bg-secondary bg-opacity-25 text-light">
                        <i class="bi bi-calendar-event fs-5"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pending -->
        <div class="col-xl-2 col-md-4 col-6">
            <div class="p-3 rounded-4 glass-panel h-100 d-flex flex-column justify-content-between" style="background: rgba(14, 25, 48, 0.65); border: 1px solid rgba(245, 158, 11, 0.25);">
                <div class="text-warning small fw-semibold">PENDING QUEUE</div>
                <div class="d-flex align-items-center justify-content-between mt-2">
                    <h3 class="fw-bold text-warning mb-0">@summary.PendingCount</h3>
                    <div class="p-2 rounded-3 bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-hourglass-split fs-5"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Processing -->
        <div class="col-xl-2 col-md-4 col-6">
            <div class="p-3 rounded-4 glass-panel h-100 d-flex flex-column justify-content-between" style="background: rgba(14, 25, 48, 0.65); border: 1px solid rgba(0, 242, 254, 0.25);">
                <div class="text-info small fw-semibold">PROCESSING NOW</div>
                <div class="d-flex align-items-center justify-content-between mt-2">
                    <h3 class="fw-bold text-info mb-0">@summary.ProcessingCount</h3>
                    <div class="p-2 rounded-3 bg-info bg-opacity-10 text-info">
                        <i class="bi bi-arrow-repeat spin-animation fs-5"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Success -->
        <div class="col-xl-3 col-md-6 col-6">
            <div class="p-3 rounded-4 glass-panel h-100 d-flex flex-column justify-content-between" style="background: rgba(14, 25, 48, 0.65); border: 1px solid rgba(16, 185, 129, 0.25);">
                <div class="text-success small fw-semibold">SUCCESSFULLY PUBLISHED</div>
                <div class="d-flex align-items-center justify-content-between mt-2">
                    <h3 class="fw-bold text-success mb-0">@summary.SuccessCount</h3>
                    <div class="p-2 rounded-3 bg-success bg-opacity-10 text-success">
                        <i class="bi bi-check-circle-fill fs-5"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Failed -->
        <div class="col-xl-3 col-md-6 col-12">
            <div class="p-3 rounded-4 glass-panel h-100 d-flex flex-column justify-content-between" style="background: rgba(14, 25, 48, 0.65); border: 1px solid rgba(239, 68, 68, 0.25);">
                <div class="text-danger small fw-semibold">FAILED / NEEDS ACTION</div>
                <div class="d-flex align-items-center justify-content-between mt-2">
                    <h3 class="fw-bold text-danger mb-0">@summary.FailedCount</h3>
                    <div class="p-2 rounded-3 bg-danger bg-opacity-10 text-danger">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters & Search Toolbar -->
    <div class="p-3 rounded-4 mb-4" style="background: rgba(14, 25, 48, 0.85); border: 1px solid rgba(255, 255, 255, 0.08);">
        <div class="row g-3 align-items-center">
            <!-- Doctor Filter -->
            <div class="col-md-3 col-12">
                <label class="form-label text-secondary small fw-bold mb-1">Filter by Doctor</label>
                <select class="form-select bg-dark text-white border-secondary small" @bind="selectedDoctorId" @bind:after="ApplyFilter">
                    <option value="">All Doctors (Across Hospital)</option>
                    @foreach (var doc in doctorList)
                    {
                        <option value="@doc.Id">@doc.FullName (@doc.Specialization)</option>
                    }
                </select>
            </div>

            <!-- Status Filter Buttons -->
            <div class="col-md-5 col-12">
                <label class="form-label text-secondary small fw-bold mb-1">Status Filter</label>
                <div class="d-flex flex-wrap gap-1">
                    @foreach (var st in new[] { "All", "Pending", "Processing", "Success", "Failed" })
                    {
                        <button type="button" class="btn btn-sm px-3 rounded-3 @(currentStatusFilter == st ? "btn-warning text-dark fw-bold" : "btn-outline-secondary text-white")"
                                @onclick="() => SetStatusFilter(st)">
                            @st
                        </button>
                    }
                </div>
            </div>

            <!-- Search Query -->
            <div class="col-md-4 col-12">
                <label class="form-label text-secondary small fw-bold mb-1">Search Keywords</label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-secondary">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" class="form-control bg-dark text-white border-secondary small" placeholder="Doctor, Heading, or Caption..." @bind="searchQuery" @bind:event="oninput" @bind:after="ApplyFilter" />
                </div>
            </div>
        </div>
    </div>

    <!-- Schedules Data Table -->
    @if (filteredSchedules.Count == 0)
    {
        <div class="text-center py-5 glass-panel rounded-4" style="background: rgba(14, 25, 48, 0.5); border: 1px dashed rgba(255, 255, 255, 0.15);">
            <i class="bi bi-calendar-x text-secondary" style="font-size: 3.5rem;"></i>
            <h5 class="text-white mt-3 fw-bold">Koi Scheduled Post Nahi Mila</h5>
            <p class="text-secondary small mb-0">Filters change karein ya Banner Designs page se naya schedule banayein.</p>
        </div>
    }
    else
    {
        <div class="table-responsive rounded-4 glass-panel" style="background: rgba(14, 25, 48, 0.75); border: 1px solid rgba(255, 255, 255, 0.08);">
            <table class="table table-hover align-middle mb-0 text-white" style="border-collapse: separate; border-spacing: 0;">
                <thead style="background: rgba(8, 15, 30, 0.85); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">
                    <tr>
                        <th class="ps-4 py-3 text-secondary">Kon Bheja (Doctor)</th>
                        <th class="py-3 text-secondary">Kya Bheja (Banner)</th>
                        <th class="py-3 text-secondary">Caption &amp; Message</th>
                        <th class="py-3 text-secondary">Platforms</th>
                        <th class="py-3 text-secondary">Schedule Time</th>
                        <th class="py-3 text-secondary">Progress Status</th>
                        <th class="pe-4 py-3 text-end text-secondary">Actions</th>
                    </tr>
                </thead>
                <tbody style="font-size: 0.9rem;">
                    @foreach (var item in filteredSchedules)
                    {
                        <tr class="border-top border-secondary border-opacity-10">
                            <!-- Kon Bheja (Doctor Details) -->
                            <td class="ps-4 py-3">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center text-dark fw-bold" style="width: 38px; height: 38px; background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%); font-size: 0.85rem;">
                                        @(string.IsNullOrWhiteSpace(item.DoctorName) ? "DR" : item.DoctorName.Substring(0, Math.Min(2, item.DoctorName.Length)).ToUpper())
                                    </div>
                                    <div>
                                        <div class="fw-bold text-white">@item.DoctorName</div>
                                        <div class="text-secondary small text-truncate" style="max-width: 170px;">
                                            <i class="bi bi-hospital me-1"></i>@(item.HospitalName ?? "CYH Hospital")
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <!-- Kya Bheja (Banner Preview & Link) -->
                            <td class="py-3">
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <div class="position-relative cursor-pointer" @onclick="() => OpenImagePreview(item)" style="cursor: pointer;" title="Click to view full preview">
                                            <img src="@item.ImageUrl" alt="Banner" class="rounded-3 border border-secondary border-opacity-50" style="width: 55px; height: 55px; object-fit: cover;" />
                                            <span class="position-absolute bottom-0 end-0 badge bg-dark bg-opacity-75 p-1" style="font-size: 0.65rem;">
                                                <i class="bi bi-zoom-in"></i>
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="rounded-3 d-flex align-items-center justify-content-center bg-dark border border-secondary border-opacity-25" style="width: 55px; height: 55px; color: #00f2fe;">
                                            <i class="bi bi-image fs-4"></i>
                                        </div>
                                    }
                                    <div>
                                        <div class="fw-semibold text-white text-truncate" style="max-width: 180px;" title="@item.BannerHeading">
                                            @(item.BannerHeading ?? "Healthcare Banner")
                                        </div>
                                        <div class="text-info small font-monospace">
                                            Banner #@item.BannerDesignId
                                        </div>
                                        @if (!string.IsNullOrEmpty(item.ImageUrl) && !item.ImageUrl.StartsWith("data:"))
                                        {
                                            <a href="@item.ImageUrl" target="_blank" class="text-secondary small text-decoration-none" style="font-size: 0.75rem;">
                                                <i class="bi bi-link-45deg"></i> Direct Link
                                            </a>
                                        }
                                    </div>
                                </div>
                            </td>

                            <!-- Caption -->
                            <td class="py-3">
                                <div class="text-light small text-truncate" style="max-width: 220px;" title="@item.Caption">
                                    @(string.IsNullOrWhiteSpace(item.Caption) ? "(No caption)" : item.Caption)
                                </div>
                            </td>

                            <!-- Platforms -->
                            <td class="py-3">
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var p in item.PlatformList)
                                    {
                                        @if (p.Equals("Facebook", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge px-2 py-1 bg-primary bg-opacity-25 text-primary border border-primary border-opacity-40 rounded-pill small">
                                                <i class="bi bi-facebook me-1"></i> FB
                                            </span>
                                        }
                                        else if (p.Equals("Instagram", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge px-2 py-1 text-pink border rounded-pill small" style="background: rgba(225, 48, 108, 0.2); border-color: rgba(225, 48, 108, 0.4) !important; color: #f472b6;">
                                                <i class="bi bi-instagram me-1"></i> IG
                                            </span>
                                        }
                                        else if (p.Equals("WhatsApp", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge px-2 py-1 bg-success bg-opacity-25 text-success border border-success border-opacity-40 rounded-pill small">
                                                <i class="bi bi-whatsapp me-1"></i> WhatsApp
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge px-2 py-1 bg-secondary bg-opacity-25 text-light rounded-pill small">@p</span>
                                        }
                                    }
                                </div>
                            </td>

                            <!-- Schedule Time -->
                            <td class="py-3">
                                <div class="text-white small fw-semibold">
                                    <i class="bi bi-clock me-1 text-info"></i>
                                    @item.ScheduledAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                </div>
                                <div class="text-secondary small" style="font-size: 0.75rem;">
                                    Created: @item.CreatedAt.ToLocalTime().ToString("dd MMM, hh:mm tt")
                                </div>
                            </td>

                            <!-- Progress / Status -->
                            <td class="py-3">
                                @if (item.Status == "Pending")
                                {
                                    <span class="badge px-3 py-1 bg-warning bg-opacity-25 text-warning border border-warning border-opacity-50 rounded-pill">
                                        ⏳ Pending
                                    </span>
                                }
                                else if (item.Status == "Processing")
                                {
                                    <span class="badge px-3 py-1 bg-info bg-opacity-25 text-info border border-info border-opacity-50 rounded-pill d-inline-flex align-items-center gap-1">
                                        <span class="spinner-border spinner-border-sm" role="status" style="width: 10px; height: 10px;"></span>
                                        Publishing...
                                    </span>
                                }
                                else if (item.Status == "ReadyToShare")
                                {
                                    <span class="badge px-3 py-1 bg-success bg-opacity-25 text-success border border-success border-opacity-50 rounded-pill">
                                        🟢 Ready to Share
                                    </span>
                                }
                                else if (item.Status == "Success")
                                {
                                    <span class="badge px-3 py-1 bg-success bg-opacity-25 text-success border border-success border-opacity-50 rounded-pill">
                                        ✅ Published
                                    </span>
                                }
                                else if (item.Status == "Partial")
                                {
                                    <span class="badge px-3 py-1 bg-warning text-dark rounded-pill">
                                        ⚠️ Partial
                                    </span>
                                }
                                else if (item.Status == "Failed")
                                {
                                    <span class="badge px-3 py-1 bg-danger bg-opacity-25 text-danger border border-danger border-opacity-50 rounded-pill" title="@item.ErrorMessage">
                                        ❌ Failed
                                    </span>
                                }
                                else
                                {
                                    <span class="badge px-3 py-1 bg-secondary rounded-pill">@item.Status</span>
                                }

                                <!-- Detail live links / errors -->
                                @if (item.Details.Any(d => !string.IsNullOrEmpty(d.PostUrl)))
                                {
                                    <div class="mt-1 d-flex flex-wrap gap-1">
                                        @foreach (var d in item.Details.Where(d => !string.IsNullOrEmpty(d.PostUrl)))
                                        {
                                            <a href="@d.PostUrl" target="_blank" class="badge bg-dark text-info border border-info border-opacity-40 text-decoration-none" style="font-size: 0.72rem;">
                                                <i class="bi bi-box-arrow-up-right me-1"></i> @d.Platform Live
                                            </a>
                                        }
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(item.ErrorMessage))
                                {
                                    <div class="text-danger small mt-1 text-truncate" style="max-width: 180px; font-size: 0.72rem;" title="@item.ErrorMessage">
                                        <i class="bi bi-exclamation-circle me-1"></i>@item.ErrorMessage
                                    </div>
                                }
                            </td>

                            <!-- Action Buttons -->
                            <td class="pe-4 py-3 text-end">
                                <div class="d-flex align-items-center justify-content-end gap-1">
                                    <button type="button" class="btn btn-outline-success btn-sm px-2 py-1" @onclick="() => SendDirectWhatsApp(item)" title="Send on WhatsApp (1-Click)">
                                        <i class="bi bi-whatsapp"></i>
                                    </button>

                                    <button type="button" class="btn btn-outline-primary btn-sm px-2 py-1" @onclick="() => ShareToFacebook(item)" title="Share to Facebook (1-Click)">
                                        <i class="bi bi-facebook"></i>
                                    </button>

                                    <button type="button" class="btn btn-outline-danger btn-sm px-2 py-1" @onclick="() => ShareToInstagram(item)" title="Download &amp; Copy for Instagram">
                                        <i class="bi bi-instagram"></i>
                                    </button>

                                    <button type="button" class="btn btn-outline-info btn-sm px-2 py-1" @onclick="() => OpenImagePreview(item)" title="Preview Banner Photo">
                                        <i class="bi bi-eye"></i>
                                    </button>

                                    @if (item.Status == "Failed" || item.Status == "Cancelled")
                                    {
                                        <button type="button" class="btn btn-outline-warning btn-sm px-2 py-1" @onclick="() => RetryScheduleAsync(item.Id)" title="Force Retry Publishing Now">
                                            <i class="bi bi-arrow-clockwise"></i> Retry
                                        </button>
                                    }

                                    @if (item.Status == "Pending")
                                    {
                                        <button type="button" class="btn btn-outline-warning btn-sm px-2 py-1" @onclick="() => CancelScheduleAsync(item.Id)" title="Cancel this scheduled post">
                                            <i class="bi bi-x-circle"></i> Cancel
                                        </button>
                                    }

                                    <button type="button" class="btn btn-outline-danger btn-sm px-2 py-1" @onclick="() => DeleteScheduleAsync(item.Id)" title="Delete this scheduled post">
                                        <i class="bi bi-trash3-fill"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- High-Resolution Image Preview Modal -->
@if (previewingSchedule != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0, 0, 0, 0.85); backdrop-filter: blur(10px); z-index: 1070;">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content glass-panel" style="background: rgba(14, 25, 48, 0.98); border: 1px solid rgba(245, 158, 11, 0.35); border-radius: 18px;">
                <div class="modal-header border-bottom border-secondary border-opacity-25 px-4 py-3">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-image text-warning fs-4"></i>
                        <div>
                            <h5 class="modal-title text-white fw-bold mb-0">@previewingSchedule.BannerHeading</h5>
                            <span class="text-secondary small">Doctor: @previewingSchedule.DoctorName</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => previewingSchedule = null"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    @if (!string.IsNullOrEmpty(previewingSchedule.ImageUrl))
                    {
                        <img src="@previewingSchedule.ImageUrl" alt="Full Banner" class="img-fluid rounded-3 shadow-lg" style="max-height: 500px; object-fit: contain;" />
                    }
                    else
                    {
                        <div class="p-5 text-secondary">
                            <i class="bi bi-image-alt fs-1"></i>
                            <p class="mt-2">No image link saved for this schedule.</p>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(previewingSchedule.Caption))
                    {
                        <div class="text-start mt-3 p-3 rounded-3 bg-dark border border-secondary border-opacity-25">
                            <div class="text-secondary small fw-bold">Published Caption:</div>
                            <div class="text-light small mt-1" style="white-space: pre-wrap;">@previewingSchedule.Caption</div>
                        </div>
                    }
                </div>
                <div class="modal-footer border-top border-secondary border-opacity-25 px-4 py-3 d-flex justify-content-between">
                    <div class="text-secondary small">
                        Status: <strong class="text-white">@previewingSchedule.Status</strong>
                    </div>
                    <div class="d-flex gap-2">
                        @if (!string.IsNullOrEmpty(previewingSchedule.ImageUrl) && !previewingSchedule.ImageUrl.StartsWith("data:"))
                        {
                            <a href="@previewingSchedule.ImageUrl" target="_blank" class="btn btn-outline-info btn-sm">
                                <i class="bi bi-box-arrow-up-right me-1"></i> Open Image Link
                            </a>
                        }
                        <button type="button" class="btn btn-outline-secondary btn-sm px-4" @onclick="() => previewingSchedule = null">Close</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .spin-animation {
        animation: spin 1s linear infinite;
        display: inline-block;
    }
    @@keyframes spin {
        100% { transform: rotate(360deg); }
    }
</style>

@code {
    private AdminScheduleSummaryDTO summary = new();
    private List<DoctorProfile> doctorList = new();
    private List<BannerScheduleDTO> filteredSchedules = new();

    private string? selectedDoctorId;
    private string currentStatusFilter = "All";
    private string searchQuery = string.Empty;
    private bool isLoading = false;

    private BannerScheduleDTO? previewingSchedule;
    private ToastNotificationDTO? activePopup;

    protected override async Task OnInitializedAsync()
    {
        await LoadDoctorsAsync();
        await RefreshDataAsync();
    }

    private async Task LoadDoctorsAsync()
    {
        doctorList = await DoctorRepo.GetAllWithUsersAsync();
    }

    private async Task RefreshDataAsync()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            summary = await ScheduleRepo.GetAllAdminAsync();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            ShowError("Error Loading Data", ex.Message);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void SetStatusFilter(string status)
    {
        currentStatusFilter = status;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var query = summary.Schedules.AsEnumerable();

        if (!string.IsNullOrEmpty(selectedDoctorId) && int.TryParse(selectedDoctorId, out int docId))
        {
            query = query.Where(s => s.DoctorId == docId);
        }

        if (currentStatusFilter != "All")
        {
            query = query.Where(s => s.Status.Equals(currentStatusFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var q = searchQuery.Trim().ToLowerInvariant();
            query = query.Where(s =>
                (s.DoctorName != null && s.DoctorName.ToLowerInvariant().Contains(q)) ||
                (s.BannerHeading != null && s.BannerHeading.ToLowerInvariant().Contains(q)) ||
                (s.Caption != null && s.Caption.ToLowerInvariant().Contains(q)));
        }

        filteredSchedules = query.ToList();
    }

    private void OpenImagePreview(BannerScheduleDTO schedule)
    {
        previewingSchedule = schedule;
    }

    private async Task SendDirectWhatsApp(BannerScheduleDTO item)
    {
        var message = $"{item.BannerHeading}\n\n{item.Caption}";
        if (!string.IsNullOrEmpty(item.ImageUrl))
        {
            message += $"\n\n📷 Banner Link: {item.ImageUrl}";
        }
        await JSRuntime.InvokeVoidAsync("cyhSocial.openWhatsApp", "", message);
        await ScheduleRepo.UpdateScheduleStatusAsync(item.Id, "Success", null);
        ShowSuccess("Opened WhatsApp", "Banner details have been sent to WhatsApp!");
        await RefreshDataAsync();
    }

    private async Task ShareToFacebook(BannerScheduleDTO item)
    {
        var quote = $"{item.BannerHeading}\n\n{item.Caption}";
        await JSRuntime.InvokeVoidAsync("cyhSocial.openFacebookShare", item.ImageUrl, quote);
        await ScheduleRepo.UpdateScheduleStatusAsync(item.Id, "Success", null);
        ShowSuccess("Opened Facebook", "Facebook share window opened!");
        await RefreshDataAsync();
    }

    private async Task ShareToInstagram(BannerScheduleDTO item)
    {
        var text = $"{item.BannerHeading}\n\n{item.Caption}";
        await JSRuntime.InvokeVoidAsync("cyhSocial.openInstagram", text, item.ImageUrl);
        await ScheduleRepo.UpdateScheduleStatusAsync(item.Id, "Success", null);
        ShowSuccess("Opened Instagram", "Caption copied and banner downloading for Instagram!");
        await RefreshDataAsync();
    }

    private async Task RetryScheduleAsync(int scheduleId)
    {
        var ok = await ScheduleRepo.RetryScheduleAsync(scheduleId);
        if (ok)
        {
            ShowSuccess("Schedule Re-Queued", "Banner publish job has been set back to Pending queue.");
            await RefreshDataAsync();
        }
        else
        {
            ShowError("Failed", "Unable to retry schedule.");
        }
    }

    private async Task CancelScheduleAsync(int scheduleId)
    {
        var ok = await ScheduleRepo.CancelScheduleAsync(scheduleId);
        if (ok)
        {
            ShowSuccess("Cancelled", "Schedule has been cancelled.");
            await RefreshDataAsync();
        }
        else
        {
            ShowError("Failed", "Unable to cancel schedule.");
        }
    }

    private async Task DeleteScheduleAsync(int scheduleId)
    {
        var ok = await ScheduleRepo.DeleteScheduleAsync(scheduleId);
        if (ok)
        {
            ShowSuccess("Schedule Deleted", "Scheduled post has been permanently removed.");
            await RefreshDataAsync();
        }
        else
        {
            ShowError("Delete Failed", "Unable to delete schedule.");
        }
    }

    private void ShowSuccess(string title, string msg)
    {
        activePopup = new ToastNotificationDTO
        {
            Title = title,
            Message = msg,
            Type = "save"
        };
    }

    private void ShowError(string title, string msg)
    {
        activePopup = new ToastNotificationDTO
        {
            Title = title,
            Message = msg,
            Type = "error"
        };
    }

    private void DismissPopup() => activePopup = null;
}
