@code {
    private AdminScheduleSummaryDTO summary = new();
    private List<DoctorProfile> doctorList = new();
    private List<BannerScheduleDTO> filteredSchedules = new();

    private string? selectedDoctorId;
    private string currentStatusFilter = "All";
    private string searchQuery = string.Empty;
    private string viewMode = "DoctorGrouped"; // "DoctorGrouped" (default) or "Table"
    private bool isLoading = false;

    private BannerScheduleDTO? previewingSchedule;
    private BannerScheduleDTO? deletingItem;
    private ToastNotificationDTO? activePopup;

    // Live auto-refresh background timer (10s)
    private System.Threading.Timer? autoRefreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadDoctorsAsync();
        await RefreshDataAsync();

        // 10-Second Auto-Update Timer
        autoRefreshTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                try
                {
                    summary = await ScheduleRepo.GetAllAdminAsync();
                    ApplyFilter();
                    StateHasChanged();
                }
                catch { }
            });
        }, null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
    }

    public void Dispose()
    {
        autoRefreshTimer?.Dispose();
    }

    private async Task LoadDoctorsAsync()
    {
        doctorList = await DoctorRepo.GetAllWithUsersAsync();
    }

    private async Task RefreshDataAsync()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            summary = await ScheduleRepo.GetAllAdminAsync();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            ShowError("Error Loading Data", ex.Message);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void SetStatusFilter(string status)
    {
        currentStatusFilter = status;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var query = summary.Schedules.AsEnumerable();

        if (!string.IsNullOrEmpty(selectedDoctorId) && int.TryParse(selectedDoctorId, out int docId))
        {
            query = query.Where(s => s.DoctorId == docId);
        }

        if (currentStatusFilter != "All")
        {
            query = query.Where(s => s.Status.Equals(currentStatusFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var q = searchQuery.Trim().ToLowerInvariant();
            query = query.Where(s =>
                (s.DoctorName != null && s.DoctorName.ToLowerInvariant().Contains(q)) ||
                (s.BannerHeading != null && s.BannerHeading.ToLowerInvariant().Contains(q)) ||
                (s.Caption != null && s.Caption.ToLowerInvariant().Contains(q)) ||
                (s.Platforms != null && s.Platforms.ToLowerInvariant().Contains(q)));
        }

        filteredSchedules = query.OrderByDescending(s => s.ScheduledAt).ToList();
    }

    private class DoctorScheduleGroup
    {
        public int? DoctorId { get; set; }
        public string DoctorName { get; set; } = string.Empty;
        public string? HospitalName { get; set; }
        public List<BannerScheduleDTO> Schedules { get; set; } = new();
    }

    private List<DoctorScheduleGroup> GroupedByDoctor
    {
        get
        {
            return filteredSchedules
                .GroupBy(s => new {
                    s.DoctorId,
                    DoctorName = string.IsNullOrWhiteSpace(s.DoctorName) ? "General Healthcare" : s.DoctorName,
                    HospitalName = s.HospitalName ?? "CYH Hospital"
                })
                .Select(g => new DoctorScheduleGroup
                {
                    DoctorId = g.Key.DoctorId,
                    DoctorName = g.Key.DoctorName,
                    HospitalName = g.Key.HospitalName,
                    Schedules = g.OrderByDescending(s => s.ScheduledAt).ToList()
                })
                .OrderByDescending(g => g.Schedules.Count)
                .ToList();
        }
    }

    private string GetStatusBorderColor(string status) => status switch
    {
        "Pending" => "rgba(245, 158, 11, 0.8)",
        "ReadyToShare" => "rgba(0, 242, 254, 0.9)",
        "Processing" => "rgba(0, 242, 254, 0.9)",
        "Success" => "rgba(16, 185, 129, 0.9)",
        "Failed" => "rgba(239, 68, 68, 0.9)",
        _ => "rgba(148, 163, 184, 0.5)"
    };

    private void OpenImagePreview(BannerScheduleDTO schedule)
    {
        previewingSchedule = schedule;
    }

    private void PromptDeleteSchedule(BannerScheduleDTO item)
    {
        deletingItem = item;
    }

    private async Task ExecuteDeleteScheduleAsync()
    {
        if (deletingItem == null) return;
        var scheduleId = deletingItem.Id;
        deletingItem = null;

        var ok = await ScheduleRepo.DeleteScheduleAsync(scheduleId);
        if (ok)
        {
            ShowSuccess("Schedule Deleted", "Schedule has been permanently removed.");
            await RefreshDataAsync();
        }
        else
        {
            ShowError("Delete Failed", "Unable to delete schedule.");
        }
    }

    private async Task SendDirectWhatsApp(BannerScheduleDTO item)
    {
        var message = $"{item.BannerHeading}\n\n{item.Caption}";
        if (!string.IsNullOrEmpty(item.ImageUrl))
        {
            message += $"\n\n📷 Banner Link: {item.ImageUrl}";
        }
        await JSRuntime.InvokeVoidAsync("cyhSocial.openWhatsApp", "", message);
        await ScheduleRepo.UpdateScheduleStatusAsync(item.Id, "Success", null);
        ShowSuccess("Opened WhatsApp", "Banner details have been sent to WhatsApp!");
        await RefreshDataAsync();
    }

    private async Task ShareToFacebook(BannerScheduleDTO item)
    {
        var quote = $"{item.BannerHeading}\n\n{item.Caption}";
        await JSRuntime.InvokeVoidAsync("cyhSocial.openFacebookShare", item.ImageUrl, quote);
        await ScheduleRepo.UpdateScheduleStatusAsync(item.Id, "Success", null);
        ShowSuccess("Opened Facebook", "Facebook share window opened!");
        await RefreshDataAsync();
    }

    private async Task ShareToInstagram(BannerScheduleDTO item)
    {
        var text = $"{item.BannerHeading}\n\n{item.Caption}";
        await JSRuntime.InvokeVoidAsync("cyhSocial.openInstagram", text, item.ImageUrl);
        await ScheduleRepo.UpdateScheduleStatusAsync(item.Id, "Success", null);
        ShowSuccess("Opened Instagram", "Caption copied and banner downloading for Instagram!");
        await RefreshDataAsync();
    }

    private void ShowSuccess(string title, string msg)
    {
        activePopup = new ToastNotificationDTO
        {
            Title = title,
            Message = msg,
            Type = "save"
        };
    }

    private void ShowError(string title, string msg)
    {
        activePopup = new ToastNotificationDTO
        {
            Title = title,
            Message = msg,
            Type = "error"
        };
    }

    private void DismissPopup() => activePopup = null;
}
