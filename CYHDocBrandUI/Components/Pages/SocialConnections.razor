@page "/social-connections"
@page "/doctor/social-connections"
@page "/admin/social-connections"
@inject NavigationManager NavigationManager
@inject IAuthService AuthService

@code {
    protected override async Task OnInitializedAsync()
    {
        var user = await AuthService.GetOrRestoreCurrentUserAsync();
        if (user?.Role == "Admin")
        {
            NavigationManager.NavigateTo("admin/schedules", replace: true);
        }
        else
        {
            NavigationManager.NavigateTo("doctor/schedules", replace: true);
        }
    }
}
