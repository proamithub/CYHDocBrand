@page "/banner-design"
@page "/doctor/banner-design"
@page "/admin/banner-design"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable

@using CYHDocBrandModel.DTO
@using CYHDocBrandUI.Components.Common

@inject IBannerAiService BannerAiService
@inject IBannerRepository BannerRepo
@inject IDoctorRepository DoctorRepo
@inject IAuthService AuthService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<!-- Animated Floating Toast Popup -->
<ToastPopup Notification="activePopup" OnDismiss="DismissPopup" />

<div class="banner-studio-container fade-in">
    <!-- Studio Header & Action Bar -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge px-3 py-2" style="background: rgba(0, 242, 254, 0.15); border: 1px solid rgba(0, 242, 254, 0.4); color: #00f2fe; border-radius: 8px; font-weight: 700; letter-spacing: 0.5px;">
                    <i class="bi bi-stars me-1"></i> AI POWERED
                </span>
                
                @if (IsPublished)
                {
                    <span class="badge px-3 py-2" style="background: rgba(16, 185, 129, 0.2); border: 1px solid rgba(16, 185, 129, 0.5); color: #10b981; border-radius: 8px; font-weight: 700;">
                        <i class="bi bi-shield-check me-1"></i> PUBLISHED
                    </span>
                }
                else
                {
                    <span class="badge px-3 py-2" style="background: rgba(245, 158, 11, 0.2); border: 1px solid rgba(245, 158, 11, 0.5); color: #fbbf24; border-radius: 8px; font-weight: 700;">
                        <i class="bi bi-pencil-fill me-1"></i> DRAFT (EDIT ACTIVE)
                    </span>
                }

                @if (state.Id > 0)
                {
                    <span class="text-secondary" style="font-size: 0.8rem;">#ID: @state.Id</span>
                }
            </div>

            <h2 class="mt-2 mb-1 fw-bold text-white" style="letter-spacing: -0.5px;">
                Healthcare <span style="background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Banner Design Studio</span>
            </h2>
            <p class="text-secondary mb-0" style="font-size: 0.92rem;">
                Right side canvas mein Heading, Doctor Card, aur Photos ko **mouse se drag** karke position set karein.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <NavLink href="@GetListUrl()" class="btn btn-outline-secondary d-flex align-items-center gap-2 px-3 py-2" style="border-radius: 10px;">
                <i class="bi bi-collection-fill text-info"></i>
                <span>My Banners</span>
            </NavLink>

            <!-- Save Draft -->
            <button type="button" class="btn btn-outline-warning d-flex align-items-center gap-2 px-3 py-2 fw-semibold" @onclick="SaveDraftAsync" disabled="@isSaving" style="border-radius: 10px;">
                @if (isSaving && savingMode == "draft")
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>Saving Draft...</span>
                }
                else
                {
                    <i class="bi bi-save2"></i>
                    <span>@(state.Id > 0 ? "Update Draft" : "Save Draft")</span>
                }
            </button>

            <!-- Final Publish Button -->
            <button type="button" class="btn btn-success d-flex align-items-center gap-2 px-3 py-2 fw-semibold" @onclick="PublishBannerAsync" disabled="@isSaving" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); border: none; border-radius: 10px;">
                @if (isSaving && savingMode == "publish")
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>Publishing...</span>
                }
                else
                {
                    <i class="bi bi-send-check-fill"></i>
                    <span>Publish Banner</span>
                }
            </button>

            <!-- Reset Drag Positions -->
            <button type="button" class="btn btn-outline-secondary d-flex align-items-center gap-1 px-2 py-2" @onclick="ResetPositions" title="Reset mouse drag positions to default layout" style="border-radius: 10px;">
                <i class="bi bi-crosshair"></i>
                <span class="d-none d-lg-inline">Reset Layout</span>
            </button>
        </div>
    </div>

    <!-- Main 2-Column Grid Layout -->
    <div class="row g-4">
        <!-- LEFT COLUMN: EDITABLE CONTROLS & TABS (5 Cols) -->
        <div class="col-xl-5 col-lg-6 col-12">
            <div class="glass-panel p-3 p-md-4 rounded-4" style="background: rgba(14, 25, 48, 0.7); backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.08);">
                
                <!-- Tab Navigation Pill Bar -->
                <ul class="nav nav-pills nav-fill p-1 rounded-3 mb-4" style="background: rgba(7, 13, 30, 0.65); border: 1px solid rgba(255, 255, 255, 0.06); pointer-events: auto;">
                    <li class="nav-item">
                        <button class="nav-link py-2 @(activeTab == "ai" ? "active" : "")" @onclick='() => SetActiveTab("ai")' style="font-size: 0.85rem; font-weight: 600; border-radius: 8px;">
                            <i class="bi bi-cpu-fill me-1"></i> AI & Presets
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link py-2 @(activeTab == "content" ? "active" : "")" @onclick='() => SetActiveTab("content")' style="font-size: 0.85rem; font-weight: 600; border-radius: 8px;">
                            <i class="bi bi-pencil-square me-1"></i> Content
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link py-2 @(activeTab == "images" ? "active" : "")" @onclick='() => SetActiveTab("images")' style="font-size: 0.85rem; font-weight: 600; border-radius: 8px;">
                            <i class="bi bi-images me-1"></i> Photos (@state.OverlayImages.Count)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link py-2 @(activeTab == "branding" ? "active" : "")" @onclick='() => SetActiveTab("branding")' style="font-size: 0.85rem; font-weight: 600; border-radius: 8px;">
                            <i class="bi bi-shield-check me-1"></i> Branding
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link py-2 @(activeTab == "styles" ? "active" : "")" @onclick='() => SetActiveTab("styles")' style="font-size: 0.85rem; font-weight: 600; border-radius: 8px;">
                            <i class="bi bi-palette-fill me-1"></i> Styles
                        </button>
                    </li>
                </ul>

                <!-- TAB 1: AI PROVIDER & PRESETS -->
                @if (activeTab == "ai")
                {
                    <div class="tab-pane-content fade-in">
                        <div class="mb-3">
                            <label class="form-label text-secondary fw-semibold" style="font-size: 0.85rem;">
                                <i class="bi bi-robot text-info me-1"></i> AI Image Provider
                            </label>
                            <div class="row g-2">
                                <div class="col-4">
                                    <div class="provider-card p-2 text-center rounded-3 @(aiRequest.Provider == "Gemini" ? "active-provider" : "")" @onclick='() => SelectProvider("Gemini")'>
                                        <i class="bi bi-google fs-4 d-block mb-1 text-info"></i>
                                        <span class="fw-bold" style="font-size: 0.82rem;">Gemini</span>
                                        <div class="text-secondary" style="font-size: 0.7rem;">Imagen 3</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="provider-card p-2 text-center rounded-3 @(aiRequest.Provider == "OpenAI" ? "active-provider" : "")" @onclick='() => SelectProvider("OpenAI")'>
                                        <i class="bi bi-openai fs-4 d-block mb-1 text-success"></i>
                                        <span class="fw-bold" style="font-size: 0.82rem;">OpenAI</span>
                                        <div class="text-secondary" style="font-size: 0.7rem;">DALL-E 3</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="provider-card p-2 text-center rounded-3 @(aiRequest.Provider == "Custom" ? "active-provider" : "")" @onclick='() => SelectProvider("Custom")'>
                                        <i class="bi bi-sliders fs-4 d-block mb-1 text-warning"></i>
                                        <span class="fw-bold" style="font-size: 0.82rem;">Custom API</span>
                                        <div class="text-secondary" style="font-size: 0.7rem;">Preset Mock</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Image Dimensions / Aspect Ratio -->
                        <div class="mb-3">
                            <label class="form-label text-secondary fw-semibold" style="font-size: 0.85rem;">
                                <i class="bi bi-aspect-ratio text-info me-1"></i> Dimensions & Aspect Ratio
                            </label>
                            <div class="row g-2">
                                <div class="col-3">
                                    <div class="ratio-box p-2 text-center rounded-3 @(state.AspectRatio == "1:1" ? "active-ratio" : "")" @onclick='() => SetAspectRatio("1:1")'>
                                        <div class="ratio-icon mx-auto square-box"></div>
                                        <div class="fw-bold mt-1" style="font-size: 0.82rem;">1:1</div>
                                        <div class="text-secondary" style="font-size: 0.68rem;">Square</div>
                                    </div>
                                </div>
                                <div class="col-3">
                                    <div class="ratio-box p-2 text-center rounded-3 @(state.AspectRatio == "4:5" ? "active-ratio" : "")" @onclick='() => SetAspectRatio("4:5")'>
                                        <div class="ratio-icon mx-auto portrait-box"></div>
                                        <div class="fw-bold mt-1" style="font-size: 0.82rem;">4:5</div>
                                        <div class="text-secondary" style="font-size: 0.68rem;">Portrait</div>
                                    </div>
                                </div>
                                <div class="col-3">
                                    <div class="ratio-box p-2 text-center rounded-3 @(state.AspectRatio == "9:16" ? "active-ratio" : "")" @onclick='() => SetAspectRatio("9:16")'>
                                        <div class="ratio-icon mx-auto story-box"></div>
                                        <div class="fw-bold mt-1" style="font-size: 0.82rem;">9:16</div>
                                        <div class="text-secondary" style="font-size: 0.68rem;">Story/Reel</div>
                                    </div>
                                </div>
                                <div class="col-3">
                                    <div class="ratio-box p-2 text-center rounded-3 @(state.AspectRatio == "16:9" ? "active-ratio" : "")" @onclick='() => SetAspectRatio("16:9")'>
                                        <div class="ratio-icon mx-auto landscape-box"></div>
                                        <div class="fw-bold mt-1" style="font-size: 0.82rem;">16:9</div>
                                        <div class="text-secondary" style="font-size: 0.68rem;">Landscape</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Template Presets -->
                        <div class="mb-3">
                            <label class="form-label text-secondary fw-semibold" style="font-size: 0.85rem;">
                                <i class="bi bi-collection text-info me-1"></i> Medical Category Template
                            </label>
                            <select class="form-select bg-dark text-white border-secondary" @bind="state.TemplateType" @bind:after="OnTemplateChanged" style="border-radius: 8px;">
                                <option value="Doctor">Doctor Profile & OPD Consultation</option>
                                <option value="Hospital">Hospital Facility & Multispecialty</option>
                                <option value="Clinic">Specialty Clinic & Diagnostics</option>
                                <option value="Lab">Pathology & Advanced Diagnostics Lab</option>
                                <option value="Awareness">Health Awareness & Disease Prevention</option>
                                <option value="Promotional">Promotional Checkup Camp / Health Package</option>
                            </select>
                        </div>

                        <!-- Trigger AI Generation Button -->
                        <div class="mb-3">
                            <button type="button" class="btn btn-outline-info w-100 py-2 d-flex align-items-center justify-content-center gap-2 fw-semibold" @onclick="TriggerAiGeneration" disabled="@isGenerating" style="border-radius: 8px;">
                                @if (isGenerating)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    <span>Synthesizing Background with AI...</span>
                                }
                                else
                                {
                                    <i class="bi bi-magic"></i>
                                    <span>Generate AI Background</span>
                                }
                            </button>
                        </div>
                    </div>
                }

                <!-- TAB 2: EDITABLE CONTENT -->
                @if (activeTab == "content")
                {
                    <div class="tab-pane-content fade-in">
                        <div class="p-2 mb-3 rounded-2 text-info" style="background: rgba(0, 242, 254, 0.08); font-size: 0.78rem;">
                            <i class="bi bi-cursor-fill me-1"></i> <strong>Tip:</strong> Aap Heading, Doctor Card, aur Badges ko right preview canvas mein mouse se drag karke kahin bhi shift kar sakte hain!
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-secondary fw-semibold" style="font-size: 0.85rem;">Main Heading / Topic</label>
                            <input type="text" class="form-control bg-dark text-white border-secondary" @bind="state.Heading" @bind:after="RenderCanvas" placeholder="e.g. World Heart Day Awareness" style="border-radius: 8px;" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-secondary fw-semibold" style="font-size: 0.85rem;">Subtitle / Description</label>
                            <textarea class="form-control bg-dark text-white border-secondary" rows="2" @bind="state.Subtitle" @bind:after="RenderCanvas" placeholder="Brief clinical message or advice" style="border-radius: 8px; font-size: 0.85rem;"></textarea>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-7">
                                <label class="form-label text-secondary fw-semibold" style="font-size: 0.85rem;">Doctor Name & Degree</label>
                                <input type="text" class="form-control bg-dark text-white border-secondary" @bind="state.DoctorName" @bind:after="RenderCanvas" style="border-radius: 8px;" />
                            </div>
                            <div class="col-5">
                                <label class="form-label text-secondary fw-semibold" style="font-size: 0.85rem;">Category Badge</label>
                                <input type="text" class="form-control bg-dark text-white border-secondary" @bind="state.BadgeText" @bind:after="RenderCanvas" style="border-radius: 8px;" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-secondary fw-semibold" style="font-size: 0.85rem;">Specialization / Department</label>
                            <input type="text" class="form-control bg-dark text-white border-secondary" @bind="state.Specialization" @bind:after="RenderCanvas" style="border-radius: 8px;" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-secondary fw-semibold" style="font-size: 0.85rem;">Hospital / Clinic Name</label>
                            <input type="text" class="form-control bg-dark text-white border-secondary" @bind="state.HospitalName" @bind:after="RenderCanvas" style="border-radius: 8px;" />
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label text-secondary fw-semibold" style="font-size: 0.85rem;">Contact / OPD Booking</label>
                                <input type="text" class="form-control bg-dark text-white border-secondary" @bind="state.ContactPhone" @bind:after="RenderCanvas" style="border-radius: 8px;" />
                            </div>
                            <div class="col-6">
                                <label class="form-label text-secondary fw-semibold" style="font-size: 0.85rem;">Emergency Helpline</label>
                                <input type="text" class="form-control bg-dark text-white border-secondary" @bind="state.EmergencyPhone" @bind:after="RenderCanvas" style="border-radius: 8px;" />
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label text-secondary fw-semibold" style="font-size: 0.85rem;">Official Website URL</label>
                                <input type="text" class="form-control bg-dark text-white border-secondary" @bind="state.Website" @bind:after="RenderCanvas" placeholder="https://www.clickyourhospital.com" style="border-radius: 8px;" />
                            </div>
                            <div class="col-6">
                                <label class="form-label text-secondary fw-semibold" style="font-size: 0.85rem;">Clinic / Chamber Address</label>
                                <input type="text" class="form-control bg-dark text-white border-secondary" @bind="state.Address" @bind:after="RenderCanvas" placeholder="Clinic Address" style="border-radius: 8px;" />
                            </div>
                        </div>
                    </div>
                }

                <!-- TAB 3: MULTIPLE PHOTOS & OVERLAYS -->
                @if (activeTab == "images")
                {
                    <div class="tab-pane-content fade-in">
                        <div class="p-3 mb-3 rounded-3" style="background: rgba(0, 242, 254, 0.08); border: 1px dashed rgba(0, 242, 254, 0.35);">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="fw-bold text-white" style="font-size: 0.9rem;">
                                    <i class="bi bi-image-fill text-info me-1"></i> Add Doctor Photo / Badges / QR
                                </span>
                                <span class="badge bg-info text-dark">Multiple Support</span>
                            </div>
                            <p class="text-secondary mb-2" style="font-size: 0.78rem;">
                                Apni device se images upload karein. Har photo canvas par aayegi aur aap use **mouse se drag** karke kahin bhi fit kar sakte hain!
                            </p>
                            
                            <label class="btn btn-outline-info btn-sm w-100 py-2 d-flex align-items-center justify-content-center gap-2" style="border-radius: 8px; cursor: pointer;">
                                <i class="bi bi-cloud-arrow-up-fill fs-6"></i>
                                <span>Upload Images (+ Add)</span>
                                <InputFile OnChange="HandleOverlayImagesUpload" multiple accept="image/*" style="display: none;" />
                            </label>
                        </div>

                        <!-- List of Added Overlays -->
                        @if (!state.OverlayImages.Any())
                        {
                            <div class="text-center py-4 text-secondary" style="font-size: 0.82rem;">
                                <i class="bi bi-images fs-3 d-block mb-1 text-muted"></i>
                                Koi extra image add nahi hui hai. Upar se doctor photo ya clinic badge upload karein.
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-2">
                                @for (int i = 0; i < state.OverlayImages.Count; i++)
                                {
                                    var idx = i;
                                    var img = state.OverlayImages[idx];

                                    <div class="p-2 rounded-3" style="background: rgba(7, 13, 30, 0.7); border: 1px solid rgba(255, 255, 255, 0.08);">
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <img src="@img.ImageUrl" style="width: 38px; height: 38px; object-fit: cover; border-radius: @(img.IsCircle ? "50%" : "6px"); border: 1px solid #00f2fe;" />
                                                <div>
                                                    <div class="text-white fw-semibold" style="font-size: 0.82rem;">@img.Name</div>
                                                    <div class="text-secondary" style="font-size: 0.7rem;">Pos: X: @((int)img.X), Y: @((int)img.Y)</div>
                                                </div>
                                            </div>

                                            <div class="d-flex align-items-center gap-2">
                                                <button type="button" class="btn btn-sm @(img.IsCircle ? "btn-info text-dark" : "btn-outline-secondary")" @onclick="() => ToggleImageCircle(idx)" title="Toggle Circle or Square shape" style="font-size: 0.72rem; padding: 2px 8px;">
                                                    @(img.IsCircle ? "Circle" : "Square")
                                                </button>

                                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveOverlayImage(idx)" title="Remove Image" style="padding: 2px 8px;">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </div>

                                        <div class="d-flex align-items-center gap-2">
                                            <span class="text-secondary" style="font-size: 0.72rem;">Size:</span>
                                            <input type="range" class="form-range" min="80" max="380" step="10" @bind="img.Width" @bind:after="() => OnImageSizeChanged(idx)" />
                                            <span class="text-info" style="font-size: 0.75rem; width: 45px;">@((int)img.Width)px</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                <!-- TAB 4: BRANDING & FIXED LOGO -->
                @if (activeTab == "branding")
                {
                    <div class="tab-pane-content fade-in">
                        <div class="p-3 mb-3 rounded-3" style="background: rgba(0, 242, 254, 0.08); border: 1px dashed rgba(0, 242, 254, 0.35);">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="fw-bold text-white" style="font-size: 0.9rem;">
                                    <i class="bi bi-shield-lock-fill text-info me-1"></i> Company Fixed Branding
                                </span>
                                <span class="badge bg-info text-dark">Automated</span>
                            </div>
                            <p class="text-secondary mb-2" style="font-size: 0.78rem;">
                                Official transparent vector logo automatically bottom position par embed hota hai.
                            </p>
                            <img src="@state.LogoUrl" alt="CYH Logo" style="height: 38px; background: rgba(7, 13, 30, 0.8); padding: 4px 10px; border-radius: 20px; border: 1px solid rgba(0, 242, 254, 0.3);" />
                        </div>

                        <!-- Logo Placement Selector -->
                        <div class="mb-3">
                            <label class="form-label text-secondary fw-semibold" style="font-size: 0.85rem;">Logo Position</label>
                            <div class="row g-2">
                                <div class="col-4">
                                    <button type="button" class="btn w-100 py-2 @(state.LogoPosition == "bottom-left" ? "btn-info text-dark fw-bold" : "btn-outline-secondary")" @onclick='() => SetLogoPosition("bottom-left")' style="font-size: 0.8rem; border-radius: 8px;">
                                        Bottom Left
                                    </button>
                                </div>
                                <div class="col-4">
                                    <button type="button" class="btn w-100 py-2 @(state.LogoPosition == "bottom-center" ? "btn-info text-dark fw-bold" : "btn-outline-secondary")" @onclick='() => SetLogoPosition("bottom-center")' style="font-size: 0.8rem; border-radius: 8px;">
                                        Bottom Center
                                    </button>
                                </div>
                                <div class="col-4">
                                    <button type="button" class="btn w-100 py-2 @(state.LogoPosition == "bottom-right" ? "btn-info text-dark fw-bold" : "btn-outline-secondary")" @onclick='() => SetLogoPosition("bottom-right")' style="font-size: 0.8rem; border-radius: 8px;">
                                        Bottom Right
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Logo Size & Padding Sliders -->
                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="form-label text-secondary fw-semibold d-flex justify-content-between" style="font-size: 0.85rem;">
                                    <span>Logo Scale</span>
                                    <span class="text-info">@state.LogoSizePercent%</span>
                                </label>
                                <input type="range" class="form-range" min="8" max="22" step="1" @bind="state.LogoSizePercent" @bind:after="RenderCanvas" />
                            </div>
                            <div class="col-6">
                                <label class="form-label text-secondary fw-semibold d-flex justify-content-between" style="font-size: 0.85rem;">
                                    <span>Bottom Offset</span>
                                    <span class="text-info">@state.LogoPaddingBottom px</span>
                                </label>
                                <input type="range" class="form-range" min="15" max="70" step="5" @bind="state.LogoPaddingBottom" @bind:after="RenderCanvas" />
                            </div>
                        </div>

                        <!-- Micro Tagline Text -->
                        <div class="mb-3">
                            <label class="form-label text-secondary fw-semibold" style="font-size: 0.85rem;">Footer Micro Tagline</label>
                            <input type="text" class="form-control bg-dark text-white border-secondary" @bind="state.LogoBadgeText" @bind:after="RenderCanvas" placeholder="e.g. CYH DOCTORHUB OFFICIAL BRANDING" style="border-radius: 8px;" />
                        </div>
                    </div>
                }

                <!-- TAB 5: STYLES & COLORS -->
                @if (activeTab == "styles")
                {
                    <div class="tab-pane-content fade-in">
                        <div class="mb-3">
