@code {
    [SupplyParameterFromQuery]
    public int? Id { get; set; }

    private string activeTab = "content";
    private bool isGenerating = false;
    private bool isSaving = false;
    private string savingMode = "";
    private string? statusMessage;

    // Toast Popup Notification State
    private ToastNotificationDTO? activePopup;
    private CancellationTokenSource? popupCts;

    private void ShowPopup(string title, string message, string type = "save")
    {
        popupCts?.Cancel();
        popupCts = new CancellationTokenSource();
        var token = popupCts.Token;

        activePopup = new ToastNotificationDTO
        {
            Title = title,
            Message = message,
            Type = type
        };
        StateHasChanged();

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(4000, token);
                if (!token.IsCancellationRequested)
                {
                    await InvokeAsync(() =>
                    {
                        activePopup = null;
                        StateHasChanged();
                    });
                }
            }
            catch { }
        });
    }

    private void DismissPopup()
    {
        popupCts?.Cancel();
        activePopup = null;
        StateHasChanged();
    }

    private BannerGenerateRequest aiRequest = new();
    private BannerCustomizationState state = new();
    private CurrentUserDTO? currentUser;
    private DotNetObjectReference<BannerDesign>? dotNetRef;

    private bool IsPublished => state.Status == "Published";
    private int? loadedId;

    protected override async Task OnInitializedAsync()
    {
        currentUser = await AuthService.GetOrRestoreCurrentUserAsync();
        if (currentUser != null && !currentUser.IsActive && currentUser.Role == "Doctor")
        {
            NavigationManager.NavigateTo("doctor/profile");
            return;
        }

        var relPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).ToLowerInvariant();
        if (currentUser?.Role == "Doctor" && !relPath.StartsWith("doctor"))
        {
            var q = Id.HasValue ? $"?id={Id.Value}" : "";
            NavigationManager.NavigateTo($"doctor/banner-design{q}");
            return;
        }
        if (currentUser?.Role == "Admin" && !relPath.StartsWith("admin"))
        {
            var q = Id.HasValue ? $"?id={Id.Value}" : "";
            NavigationManager.NavigateTo($"admin/banner-design{q}");
            return;
        }

        dotNetRef = DotNetObjectReference.Create(this);

        await LoadBannerRecordAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Id != loadedId)
        {
            await LoadBannerRecordAsync();
        }
    }

    private async Task LoadBannerRecordAsync()
    {
        loadedId = Id;
        if (Id.HasValue && Id.Value > 0)
        {
            var existingRecord = await BannerRepo.GetBannerByIdAsync(Id.Value);
            if (existingRecord != null)
            {
                if (!string.IsNullOrWhiteSpace(existingRecord.ConfigJson))
                {
                    try
                    {
                        var loadedState = System.Text.Json.JsonSerializer.Deserialize<BannerCustomizationState>(existingRecord.ConfigJson);
                        if (loadedState != null)
                        {
                            state = loadedState;
                        }
                    }
                    catch { }
                }
                state.Id = existingRecord.Id;
                state.Status = existingRecord.Status;
                state.Heading = existingRecord.Heading;
                state.DoctorName = existingRecord.DoctorName;
                state.HospitalName = existingRecord.HospitalName;
                state.TemplateType = existingRecord.TemplateType;
                state.AspectRatio = existingRecord.AspectRatio;
                state.PrimaryColor = existingRecord.PrimaryColor;
                state.BackgroundImageUrl = existingRecord.BackgroundImageUrl;
                aiRequest.AspectRatio = existingRecord.AspectRatio;
                aiRequest.TemplateType = existingRecord.TemplateType;

                statusMessage = $"Loaded #{state.Id} '{state.Heading}' in {state.Status.ToUpper()} mode.";
                await RenderCanvas();
                return;
            }
        }

        if (currentUser != null)
        {
            try
            {
                DoctorProfile? doc = null;
                if (currentUser.DoctorProfileId.HasValue)
                {
                    doc = await DoctorRepo.GetByIdAsync(currentUser.DoctorProfileId.Value);
                }
                if (doc == null && !string.IsNullOrEmpty(currentUser.UserId))
                {
                    doc = await DoctorRepo.GetByUserIdAsync(currentUser.UserId);
                }

                if (doc != null)
                {
                    state.DoctorName = !string.IsNullOrWhiteSpace(doc.DisplayName) ? doc.DisplayName : doc.FullName;
                    if (!string.IsNullOrWhiteSpace(doc.Qualifications) && !state.DoctorName.Contains(doc.Qualifications))
                    {
                        state.DoctorName += $", {doc.Qualifications}";
                    }
                    if (!string.IsNullOrWhiteSpace(doc.Specialization))
                    {
                        state.Specialization = doc.Specialization;
                    }
                    if (!string.IsNullOrWhiteSpace(doc.ClinicName))
                    {
                        state.HospitalName = doc.ClinicName;
                    }
                    if (!string.IsNullOrWhiteSpace(doc.MobileNo))
                    {
                        state.ContactPhone = doc.MobileNo;
                    }
                    if (!string.IsNullOrWhiteSpace(doc.ClinicAddress))
                    {
                        state.Address = doc.ClinicAddress;
                    }
                    if (!string.IsNullOrWhiteSpace(doc.WebsiteUrl))
                    {
                        state.Website = doc.WebsiteUrl;
                    }
                    if (!string.IsNullOrWhiteSpace(doc.ProfilePic))
                    {
                        if (!state.OverlayImages.Any(x => x.Name == "Doctor Profile Photo"))
                        {
                            state.OverlayImages.Add(new BannerOverlayImage
                            {
                                Name = "Doctor Profile Photo",
                                ImageUrl = doc.ProfilePic,
                                X = 780,
                                Y = 400,
                                Width = 220,
                                Height = 220,
                                IsCircle = true,
                                IsVisible = true
                            });
                        }
                    }
                }
                else
                {
                    if (!string.IsNullOrWhiteSpace(currentUser.FullName))
                    {
                        state.DoctorName = currentUser.Role == "Doctor" ? $"Dr. {currentUser.FullName}" : currentUser.FullName;
                    }
                    if (!string.IsNullOrWhiteSpace(currentUser.Department))
                    {
                        state.Specialization = currentUser.Department;
                    }
                }
            }
            catch { }
        }

        ApplyTemplatePreset(state.TemplateType);
        await RenderCanvas();
    }

    private async Task<bool> EnsureBannerStudioLoadedAsync()
    {
        for (int i = 0; i < 25; i++)
        {
            try
            {
                var isReady = await JSRuntime.InvokeAsync<bool>("eval", 
                    "typeof window.bannerStudio !== 'undefined' && typeof window.bannerStudio.init === 'function'");
                if (isReady) return true;
            }
            catch { }
            await Task.Delay(50);
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
                if (!document.getElementById('banner-studio-dynamic-script')) {
                    const s = document.createElement('script');
                    s.id = 'banner-studio-dynamic-script';
                    s.src = 'js/bannerStudio.js?v=" + DateTime.UtcNow.Ticks + @"';
                    document.head.appendChild(s);
                }
            ");
            await Task.Delay(150);
            return await JSRuntime.InvokeAsync<bool>("eval", 
                "typeof window.bannerStudio !== 'undefined' && typeof window.bannerStudio.init === 'function'");
        }
        catch
        {
            return false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (dotNetRef != null)
        {
            try
            {
                var ready = await EnsureBannerStudioLoadedAsync();
                if (ready)
                {
                    await JSRuntime.InvokeVoidAsync("bannerStudio.init", "bannerCanvas", dotNetRef);
                    if (firstRender)
                    {
                        await RenderCanvas();
                    }
                }
                else
                {
                    Console.WriteLine("Warning: bannerStudio was not ready after retries.");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"bannerStudio.init error: {ex.Message}");
            }
        }
    }

    [JSInvokable]
    public void OnElementPositionChanged(string elementId, double x, double y)
    {
        if (state.Status == "Published")
        {
            state.Status = "Draft";
            statusMessage = "Banner un-locked to Draft mode for editing. New position updated!";
            StateHasChanged();
        }

        if (elementId == "heading")
        {
            state.HeadingX = x;
            state.HeadingY = y;
        }
        else if (elementId == "subtitle")
        {
            state.SubtitleX = x;
            state.SubtitleY = y;
        }
        else if (elementId == "doctorCard")
        {
            state.DoctorCardX = x;
            state.DoctorCardY = y;
        }
        else if (elementId == "badge")
        {
            state.BadgeX = x;
            state.BadgeY = y;
        }
        else if (elementId == "hospitalName")
        {
            state.HospitalNameX = x;
            state.HospitalNameY = y;
        }
        else if (elementId.StartsWith("overlay_"))
        {
            var overlayId = elementId.Substring("overlay_".Length);
            var overlay = state.OverlayImages.FirstOrDefault(o => o.Id == overlayId);
            if (overlay != null)
            {
                overlay.X = x;
                overlay.Y = y;
            }
        }
        StateHasChanged();
    }

    private void EnsureDraftMode()
    {
        if (state.Status == "Published")
        {
            state.Status = "Draft";
            statusMessage = "Editing enabled â€” banner converted to Draft mode.";
            ShowPopup("Draft Edit Active", "Banner draft mode mein unlock ho gaya hai. Ab aap text edit aur mouse drag kar sakte hain.", "edit");
        }
    }

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
    }

    private void SelectProvider(string provider)
    {
        EnsureDraftMode();
        aiRequest.Provider = provider;
    }

    private async Task SetAspectRatio(string ratio)
    {
        EnsureDraftMode();
        state.AspectRatio = ratio;
        aiRequest.AspectRatio = ratio;
        await RenderCanvas();
    }

    private async Task SetLogoPosition(string pos)
    {
        EnsureDraftMode();
        state.LogoPosition = pos;
        await RenderCanvas();
    }

    private async Task SetPrimaryColor(string hex)
    {
        EnsureDraftMode();
        state.PrimaryColor = hex;
        await RenderCanvas();
    }

    private async Task OnTemplateChanged()
    {
        EnsureDraftMode();
        ApplyTemplatePreset(state.TemplateType);
        await RenderCanvas();
    }

    private void ApplyTemplatePreset(string template)
    {
        aiRequest.TemplateType = template;
        switch (template)
        {
            case "Doctor":
                state.Heading = "Expert Medical Care & Consultation";
                state.Subtitle = "Book your priority appointment with our senior healthcare specialist.";
                state.BadgeText = "DOCTOR CONSULTATION";
                state.PrimaryColor = "#00f2fe";
                break;
            case "Hospital":
                state.Heading = "World-Class Healthcare Infrastructure";
                state.Subtitle = "24/7 Advanced Emergency, ICU, and Modular Surgical Suites.";
                state.BadgeText = "MULTISPECIALTY HOSPITAL";
                state.PrimaryColor = "#3b82f6";
                break;
            case "Clinic":
                state.Heading = "Comprehensive Family Health Clinic";
                state.Subtitle = "Compassionate care, diagnostic testing, and preventive health checks.";
                state.BadgeText = "CLINICAL EXCELLENCE";
                state.PrimaryColor = "#10b981";
                break;
            case "Lab":
                state.Heading = "Precision Pathology & Diagnostics";
                state.Subtitle = "Accurate NABL accredited diagnostic tests with same-day digital reports.";
                state.BadgeText = "DIAGNOSTICS & LAB";
                state.PrimaryColor = "#8b5cf6";
                break;
            case "Awareness":
                state.Heading = "World Heart Day: Protect Your Heart";
                state.Subtitle = "Regular cardiac checkups and healthy lifestyle reduce cardiac risk by 80%.";
                state.BadgeText = "HEALTH AWARENESS";
                state.PrimaryColor = "#f43f5e";
                break;
            case "Promotional":
                state.Heading = "Full Body Wellness Checkup Package";
                state.Subtitle = "70+ Vital Tests including Lipid, Liver, Kidney & Sugar Profile at 50% Off.";
                state.BadgeText = "SPECIAL HEALTH PACKAGE";
                state.PrimaryColor = "#f59e0b";
                break;
        }
    }

    private async Task HandleOverlayImagesUpload(InputFileChangeEventArgs e)
    {
        EnsureDraftMode();

        var files = e.GetMultipleFiles(5); // up to 5 images
        foreach (var file in files)
        {
            if (file.Size > 5 * 1024 * 1024) continue; // max 5MB per file

            var format = file.ContentType;
            var buffer = new byte[file.Size];
            await file.OpenReadStream(5 * 1024 * 1024).ReadExactlyAsync(buffer);
            var base64 = $"data:{format};base64,{Convert.ToBase64String(buffer)}";

            var initialY = 380 + (state.OverlayImages.Count * 30);
            var initialX = 100 + (state.OverlayImages.Count * 40);

            state.OverlayImages.Add(new BannerOverlayImage
            {
                Name = file.Name,
                ImageUrl = base64,
                X = initialX,
                Y = initialY,
                Width = 180,
                Height = 180,
                IsCircle = true,
                IsVisible = true
            });
        }

        await RenderCanvas();
        statusMessage = "Photo(s) added! Right preview canvas par mouse se drag karke position set karein.";
    }

    private async Task ToggleImageCircle(int index)
    {
        EnsureDraftMode();
        if (index < 0 || index >= state.OverlayImages.Count) return;
        state.OverlayImages[index].IsCircle = !state.OverlayImages[index].IsCircle;
        await RenderCanvas();
    }

    private async Task OnImageSizeChanged(int index)
    {
        EnsureDraftMode();
        if (index < 0 || index >= state.OverlayImages.Count) return;
        state.OverlayImages[index].Height = state.OverlayImages[index].Width; // keep 1:1 aspect
        await RenderCanvas();
    }

    private async Task RemoveOverlayImage(int index)
    {
        EnsureDraftMode();
        if (index < 0 || index >= state.OverlayImages.Count) return;
        state.OverlayImages.RemoveAt(index);
        await RenderCanvas();
    }

    private async Task ResetPositions()
    {
        EnsureDraftMode();
        state.HeadingX = null;
        state.HeadingY = null;
        state.SubtitleX = null;
        state.SubtitleY = null;
        state.DoctorCardX = null;
        state.DoctorCardY = null;
        state.BadgeX = null;
        state.BadgeY = null;
        state.HospitalNameX = null;
        state.HospitalNameY = null;
        await RenderCanvas();
        statusMessage = "Default auto-layout positions restored.";
        ShowPopup("Layout Reset", "Default auto-layout positions restore kar di gayi hain.", "delete");
    }

    private async Task UnlockForEditing()
    {
        state.Status = "Draft";
        if (state.Id > 0)
        {
            await BannerRepo.SaveDraftAsync(state, currentUser?.UserId);
        }
        await RenderCanvas();
        statusMessage = "Banner converted to Draft mode! Mouse drag and text editing are now UNLOCKED.";
        ShowPopup("Draft Mode Active", "Banner editing ke liye unlock ho gaya hai.", "edit");
    }

    private async Task SaveDraftAsync()
    {
        isSaving = true;
        savingMode = "draft";
        statusMessage = null;

        try
        {
            state.Status = "Draft";
            var savedId = await BannerRepo.SaveDraftAsync(state, currentUser?.UserId);
            if (savedId > 0)
            {
                state.Id = savedId;
                statusMessage = $"Banner draft #{savedId} saved successfully in SQL database! Mouse positions and photos saved.";
                ShowPopup("Draft Saved!", $"Banner draft #{savedId} SQL database mein successfully save ho gaya hai!", "save");
            }
            else
            {
                statusMessage = "Failed to save draft to database.";
                ShowPopup("Save Failed", "Draft database mein save nahi ho saka.", "error");
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error saving draft: {ex.Message}";
            ShowPopup("Save Error", ex.Message, "error");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private string GetListUrl()
    {
        var relPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).ToLowerInvariant();
        if (currentUser?.Role == "Doctor" || relPath.StartsWith("doctor")) return "doctor/banner-designs";
        if (currentUser?.Role == "Admin" || relPath.StartsWith("admin")) return "admin/banner-designs";
        return "banner-designs";
    }

    private async Task PublishBannerAsync()
    {
        isSaving = true;
        savingMode = "publish";
        statusMessage = null;

        try
        {
            state.Status = "Published";
            var savedId = await BannerRepo.SaveDraftAsync(state, currentUser?.UserId);
            if (savedId > 0)
            {
                state.Id = savedId;
                var pubSuccess = await BannerRepo.PublishBannerAsync(savedId, currentUser?.UserId);
                if (pubSuccess)
                {
                    await RenderCanvas();
                    statusMessage = $"🎉 Banner #{savedId} successfully Published & LOCKED! Download and Social Share are now active.";
                    ShowPopup("Banner Published!", $"🎉 Banner #{savedId} successfully publish ho gaya hai! HD Export aur Share ready hain.", "save");
                }
                else
                {
                    statusMessage = "Banner saved as draft, but could not update status to Published.";
                    ShowPopup("Publish Incomplete", "Status update failed in database.", "warning");
                }
            }
            else
            {
                statusMessage = "Failed to publish banner.";
                ShowPopup("Publish Failed", "Banner publish nahi ho saka.", "error");
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error publishing: {ex.Message}";
            ShowPopup("Publish Error", ex.Message, "error");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private async Task TriggerAiGeneration()
    {
        EnsureDraftMode();

        isGenerating = true;
        statusMessage = null;
        StateHasChanged();

        try
        {
            aiRequest.DoctorId = currentUser?.DoctorProfileId;
            aiRequest.UserId = currentUser?.UserId;
            aiRequest.DoctorName = state.DoctorName;

            var result = await BannerAiService.GenerateBannerAsync(aiRequest);
            if (result.Success)
            {
                state.BackgroundImageUrl = !string.IsNullOrEmpty(result.ImageBase64) 
                    ? result.ImageBase64 
                    : result.ImageUrl;

                await RenderCanvas();
                statusMessage = $"Background generated successfully with {result.ProviderUsed}!";
            }
            else
            {
                statusMessage = $"Generation error: {result.ErrorMessage}";
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            isGenerating = false;
            StateHasChanged();
        }
    }

    private async Task RenderCanvas()
    {
        try
        {
            var isReady = await JSRuntime.InvokeAsync<bool>("eval", 
                "typeof window.bannerStudio !== 'undefined' && typeof window.bannerStudio.renderBanner === 'function'");
            if (isReady)
            {
                await JSRuntime.InvokeVoidAsync("bannerStudio.renderBanner", "bannerCanvas", state);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error rendering canvas: {ex.Message}");
        }
    }

    private async Task DownloadBannerPng()
    {
        try
        {
            var filename = $"CYH_Banner_{state.TemplateType}_{DateTime.UtcNow:yyyyMMdd_HHmmss}.png";
            await JSRuntime.InvokeVoidAsync("bannerStudio.downloadBanner", "bannerCanvas", filename);
            statusMessage = "Banner downloaded successfully in high resolution PNG!";
            ShowPopup("PNG Downloaded", "High-Resolution PNG banner successfully download ho gaya hai!", "save");
        }
        catch (Exception ex)
        {
            statusMessage = $"Failed to download banner: {ex.Message}";
            ShowPopup("Download Error", ex.Message, "error");
        }
    }

    private async Task ShareOnSocialMedia()
    {
        try
        {
            var shareTitle = $"{state.Heading} â€” {state.HospitalName}";
            var shareText = $"{state.Heading}\n{state.Subtitle}\nConsult {state.DoctorName} at {state.HospitalName}.\nHelpline: {state.ContactPhone}";
            
            var res = await JSRuntime.InvokeAsync<ShareResult>("bannerStudio.shareBanner", "bannerCanvas", shareTitle, shareText);
            if (res.Success)
            {
                statusMessage = res.Message;
                ShowPopup("Shared Successfully", res.Message, "save");
            }
            else
            {
                statusMessage = res.Message;
                ShowPopup("Share Info", res.Message, "warning");
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Share error: {ex.Message}";
            ShowPopup("Share Error", ex.Message, "error");
        }
    }

    public void Dispose()
    {
        dotNetRef?.Dispose();
    }

    private class ShareResult
    {
        public bool Success { get; set; }
        public string Message { get; set; } = string.Empty;
    }
