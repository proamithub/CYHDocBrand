@page "/banner-design"
@page "/doctor/banner-design"
@page "/admin/banner-design"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable

@using CYHDocBrandModel.DTO
@using CYHDocBrandUI.Components.Common

@inject IBannerAiService BannerAiService
@inject IBannerRepository BannerRepo
@inject ICreditRepository CreditRepo
@inject IBannerTemplateRepository BannerTemplateRepo
@inject IDoctorRepository DoctorRepo
@inject IAuthService AuthService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<!-- Animated Floating Toast Popup -->
<ToastPopup Notification="activePopup" OnDismiss="DismissPopup" />

<div class="banner-studio-container fade-in">
    <!-- Studio Header & Action Bar -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge px-3 py-2" style="background: rgba(0, 242, 254, 0.15); border: 1px solid rgba(0, 242, 254, 0.4); color: #00f2fe; border-radius: 8px; font-weight: 700; letter-spacing: 0.5px;">
                    <i class="bi bi-stars me-1"></i> AI POWERED
                </span>
                
                @if (IsPublished)
                {
                    <span class="badge px-3 py-2" style="background: rgba(16, 185, 129, 0.2); border: 1px solid rgba(16, 185, 129, 0.5); color: #10b981; border-radius: 8px; font-weight: 700;">
                        <i class="bi bi-shield-check me-1"></i> PUBLISHED
                    </span>
                }
                else
                {
                    <span class="badge px-3 py-2" style="background: rgba(245, 158, 11, 0.2); border: 1px solid rgba(245, 158, 11, 0.5); color: #fbbf24; border-radius: 8px; font-weight: 700;">
                        <i class="bi bi-pencil-fill me-1"></i> DRAFT (EDIT ACTIVE)
                    </span>
                }

                @if (state.Id > 0)
                {
                    <span class="text-secondary" style="font-size: 0.8rem;">#ID: @state.Id</span>
                }
            </div>

            <h2 class="mt-2 mb-1 fw-bold text-white" style="letter-spacing: -0.5px;">
                Healthcare <span style="background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Banner Design Studio</span>
            </h2>
            <p class="text-secondary mb-0" style="font-size: 0.92rem;">
                Canvas mein Heading, Doctor Card, aur Photos ko drag / touch se move karke position set karein.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2 studio-header-actions">
            <NavLink href="@GetTemplatesUrl()" class="btn btn-outline-info d-flex align-items-center gap-2 px-3 py-2" style="border-radius: 10px;">
                <i class="bi bi-grid-1x2-fill"></i>
                <span>Template Gallery</span>
            </NavLink>

            <NavLink href="@GetListUrl()" class="btn btn-outline-secondary d-flex align-items-center gap-2 px-3 py-2" style="border-radius: 10px;">
                <i class="bi bi-collection-fill text-info"></i>
                <span>My Banners</span>
            </NavLink>

            <!-- Save Draft -->
            <button type="button" class="btn btn-outline-warning d-flex align-items-center gap-2 px-3 py-2 fw-semibold" @onclick="SaveDraftAsync" disabled="@isSaving" style="border-radius: 10px;">
                @if (isSaving && savingMode == "draft")
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>Saving Draft...</span>
                }
                else
                {
                    <i class="bi bi-save2"></i>
                    <span>@(state.Id > 0 ? "Save Changes" : "Save & Create Banner")</span>
                }
            </button>

            <!-- Final Publish Button -->
            <button type="button" class="btn btn-success d-flex align-items-center gap-2 px-3 py-2 fw-semibold" @onclick="PublishBannerAsync" disabled="@isSaving" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); border: none; border-radius: 10px;">
                @if (isSaving && savingMode == "publish")
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>Publishing...</span>
                }
                else
                {
                    <i class="bi bi-send-check-fill"></i>
                    <span>Publish Banner</span>
                }
            </button>

            <!-- Reset Drag Positions -->
            <button type="button" class="btn btn-outline-secondary d-flex align-items-center gap-1 px-2 py-2" @onclick="ResetPositions" title="Reset mouse drag positions to default layout" style="border-radius: 10px;">
                <i class="bi bi-crosshair"></i>
                <span class="d-none d-lg-inline">Reset Layout</span>
            </button>
        </div>
    </div>

    <!-- Published or Admin Status Alert Banner -->
    @if (IsPublished)
    {
        <div class="alert alert-success d-flex flex-wrap align-items-center justify-content-between p-3 rounded-4 mb-4 shadow" style="background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.4); color: #ecfdf5;">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-success bg-opacity-25 p-2 rounded-circle text-success">
                    <i class="bi bi-shield-lock-fill fs-3"></i>
                </div>
                <div>
                    <h5 class="fw-bold text-white mb-0">Banner Published &amp; Locked</h5>
                    <div class="small text-white-50">
                        Ye banner final publish ho chuka hai aur locked hai. Text, positioning aur images सुरक्षित hain. High-Resolution PNG download aur share active hain.
                    </div>
                </div>
            </div>
            <div class="d-flex gap-2 mt-2 mt-md-0">
                <button type="button" class="btn btn-info fw-bold d-flex align-items-center gap-2 px-3 py-2" @onclick="DownloadBannerPng" style="background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%); border: none; border-radius: 10px; color: #070d1e;">
                    <i class="bi bi-download"></i>
                    <span>Download HD PNG</span>
                </button>
                <button type="button" class="btn btn-outline-success d-flex align-items-center gap-2 px-3 py-2" @onclick="ShareOnSocialMedia" style="border-radius: 10px;">
                    <i class="bi bi-share-fill"></i>
                    <span>Share</span>
                </button>
            </div>
        </div>
    }
    else if (IsAdmin)
    {
        <div class="alert alert-info d-flex align-items-center justify-content-between p-3 rounded-4 mb-4" style="background: rgba(0, 242, 254, 0.1); border: 1px solid rgba(0, 242, 254, 0.3);">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-eye-fill fs-4 text-info"></i>
                <div>
                    <strong class="text-white">Admin Inspection Mode (Read-Only)</strong>
                    <div class="small text-white-50">Aap specialist banner ka live canvas inspect kar rahe hain. Editing ya saving available nahi hai.</div>
                </div>
            </div>
            <button type="button" class="btn btn-info btn-sm fw-bold" @onclick="DownloadBannerPng">
                <i class="bi bi-download me-1"></i> Download HD PNG
            </button>
        </div>
    }

    <!-- Main 2-Column Grid Layout (Mobile: Canvas on Top, Controls Below) -->
    <div class="row g-4">
        <!-- LEFT COLUMN: EDITABLE CONTROLS & TABS (5 Cols) -->
        <div class="col-xl-5 col-lg-6 col-12 order-2 order-lg-1">
            <div class="glass-panel p-3 p-md-4 rounded-4" style="background: rgba(14, 25, 48, 0.7); backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.08);">
                
                <!-- Tab Navigation Pill Bar -->
                <ul class="nav nav-pills nav-fill p-1 rounded-3 mb-4" style="background: rgba(7, 13, 30, 0.65); border: 1px solid rgba(255, 255, 255, 0.06); pointer-events: auto;">
                    <li class="nav-item">
                        <button class="nav-link py-2 @(activeTab == "ai" ? "active" : "")" @onclick='() => SetActiveTab("ai")' style="font-size: 0.85rem; font-weight: 600; border-radius: 8px;">
                            <i class="bi bi-cpu-fill me-1"></i> AI & Presets
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link py-2 @(activeTab == "content" ? "active" : "")" @onclick='() => SetActiveTab("content")' style="font-size: 0.85rem; font-weight: 600; border-radius: 8px;">
                            <i class="bi bi-pencil-square me-1"></i> Content
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link py-2 @(activeTab == "images" ? "active" : "")" @onclick='() => SetActiveTab("images")' style="font-size: 0.85rem; font-weight: 600; border-radius: 8px;">
                            <i class="bi bi-images me-1"></i> Photos (@state.OverlayImages.Count)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link py-2 @(activeTab == "branding" ? "active" : "")" @onclick='() => SetActiveTab("branding")' style="font-size: 0.85rem; font-weight: 600; border-radius: 8px;">
                            <i class="bi bi-shield-check me-1"></i> Branding
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link py-2 @(activeTab == "styles" ? "active" : "")" @onclick='() => SetActiveTab("styles")' style="font-size: 0.85rem; font-weight: 600; border-radius: 8px;">
                            <i class="bi bi-palette-fill me-1"></i> Styles
                        </button>
                    </li>
                </ul>

                <!-- TAB 1: AI PROVIDER & PRESETS -->
                @if (activeTab == "ai")
                {
                    <div class="tab-pane-content fade-in">
                        <div class="mb-3">
                            <label class="form-label text-secondary fw-semibold" style="font-size: 0.85rem;">
                                <i class="bi bi-robot text-info me-1"></i> AI Image Provider
                            </label>
                            <div class="row g-2">
                                <div class="col-4">
                                    <div class="provider-card p-2 text-center rounded-3 @(aiRequest.Provider == "Gemini" ? "active-provider" : "")" @onclick='() => SelectProvider("Gemini")'>
                                        <i class="bi bi-google fs-4 d-block mb-1 text-info"></i>
                                        <span class="fw-bold" style="font-size: 0.82rem;">Gemini</span>
                                        <div class="text-secondary" style="font-size: 0.7rem;">Imagen 3</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="provider-card p-2 text-center rounded-3 @(aiRequest.Provider == "OpenAI" ? "active-provider" : "")" @onclick='() => SelectProvider("OpenAI")'>
                                        <i class="bi bi-openai fs-4 d-block mb-1 text-success"></i>
                                        <span class="fw-bold" style="font-size: 0.82rem;">OpenAI</span>
                                        <div class="text-secondary" style="font-size: 0.7rem;">DALL-E 3</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="provider-card p-2 text-center rounded-3 @(aiRequest.Provider == "Custom" ? "active-provider" : "")" @onclick='() => SelectProvider("Custom")'>
                                        <i class="bi bi-sliders fs-4 d-block mb-1 text-warning"></i>
                                        <span class="fw-bold" style="font-size: 0.82rem;">Custom API</span>
                                        <div class="text-secondary" style="font-size: 0.7rem;">Preset Mock</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Image Dimensions / Aspect Ratio -->
                        <div class="mb-3">
                            <label class="form-label text-secondary fw-semibold" style="font-size: 0.85rem;">
                                <i class="bi bi-aspect-ratio text-info me-1"></i> Dimensions & Aspect Ratio
                            </label>
                            <div class="row g-2">
                                <div class="col-3">
                                    <div class="ratio-box p-2 text-center rounded-3 @(state.AspectRatio == "1:1" ? "active-ratio" : "")" @onclick='() => SetAspectRatio("1:1")'>
                                        <div class="ratio-icon mx-auto square-box"></div>
                                        <div class="fw-bold mt-1" style="font-size: 0.82rem;">1:1</div>
                                        <div class="text-secondary" style="font-size: 0.68rem;">Square</div>
                                    </div>
                                </div>
                                <div class="col-3">
                                    <div class="ratio-box p-2 text-center rounded-3 @(state.AspectRatio == "4:5" ? "active-ratio" : "")" @onclick='() => SetAspectRatio("4:5")'>
                                        <div class="ratio-icon mx-auto portrait-box"></div>
                                        <div class="fw-bold mt-1" style="font-size: 0.82rem;">4:5</div>
                                        <div class="text-secondary" style="font-size: 0.68rem;">Portrait</div>
                                    </div>
                                </div>
                                <div class="col-3">
                                    <div class="ratio-box p-2 text-center rounded-3 @(state.AspectRatio == "9:16" ? "active-ratio" : "")" @onclick='() => SetAspectRatio("9:16")'>
                                        <div class="ratio-icon mx-auto story-box"></div>
                                        <div class="fw-bold mt-1" style="font-size: 0.82rem;">9:16</div>
                                        <div class="text-secondary" style="font-size: 0.68rem;">Story/Reel</div>
                                    </div>
                                </div>
                                <div class="col-3">
                                    <div class="ratio-box p-2 text-center rounded-3 @(state.AspectRatio == "16:9" ? "active-ratio" : "")" @onclick='() => SetAspectRatio("16:9")'>
                                        <div class="ratio-icon mx-auto landscape-box"></div>
                                        <div class="fw-bold mt-1" style="font-size: 0.82rem;">16:9</div>
                                        <div class="text-secondary" style="font-size: 0.68rem;">Landscape</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Template Presets -->
                        <div class="mb-3">
                            <label class="form-label text-secondary fw-semibold" style="font-size: 0.85rem;">
                                <i class="bi bi-collection text-info me-1"></i> Medical Category Template
                            </label>
                            <select class="form-select bg-dark text-white border-secondary" @bind="state.TemplateType" @bind:after="OnTemplateChanged" style="border-radius: 8px;">
                                <option value="Doctor">Doctor Profile & OPD Consultation</option>
                                <option value="Hospital">Hospital Facility & Multispecialty</option>
                                <option value="Clinic">Specialty Clinic & Diagnostics</option>
                                <option value="Lab">Pathology & Advanced Diagnostics Lab</option>
                                <option value="Awareness">Health Awareness & Disease Prevention</option>
                                <option value="Promotional">Promotional Checkup Camp / Health Package</option>
                            </select>
                        </div>

                        <!-- Trigger AI Generation Button -->
                        <div class="mb-3">
                            <button type="button" class="btn btn-outline-info w-100 py-2 d-flex align-items-center justify-content-center gap-2 fw-semibold" @onclick="TriggerAiGeneration" disabled="@(isGenerating || IsPublished || IsAdmin)" style="border-radius: 8px;">
                                @if (isGenerating)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    <span>Synthesizing Background with AI...</span>
                                }
                                else
                                {
                                    <i class="bi bi-magic"></i>
                                    <span>Generate AI Background</span>
                                }
                            </button>
                        </div>

                        <!-- Custom Background Image Upload (Smart Quality-Preserving Compression) -->
                        <div class="p-3 mb-3 rounded-3" style="background: rgba(14, 25, 48, 0.85); border: 1px solid rgba(0, 242, 254, 0.25);">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="fw-bold text-white d-flex align-items-center gap-2" style="font-size: 0.88rem;">
                                    <i class="bi bi-image-fill text-info"></i>
                                    <span>Custom Background Image</span>
                                </span>
                                <span class="badge bg-success bg-opacity-20 text-success border border-success" style="font-size: 0.7rem;">
                                    Smart HD Compression
                                </span>
                            </div>
                            <p class="text-secondary mb-3" style="font-size: 0.78rem;">
                                Device se koi bhi photo select karein. High visual quality maintain rakhte hue file size auto-compress ho jayegi.
                            </p>

                            @if (!string.IsNullOrWhiteSpace(state.BackgroundImageUrl))
                            {
                                <div class="p-2 mb-3 rounded-2 d-flex align-items-center justify-content-between" style="background: rgba(3, 8, 20, 0.7); border: 1px solid rgba(0, 242, 254, 0.2);">
                                    <div class="d-flex align-items-center gap-2 text-truncate">
                                        <img src="@state.BackgroundImageUrl" style="width: 44px; height: 44px; object-fit: cover; border-radius: 6px; border: 1px solid #00f2fe;" />
                                        <div class="text-truncate">
                                            <div class="text-white fw-semibold small text-truncate">
                                                @(string.IsNullOrWhiteSpace(state.BackgroundImageFileName) ? "Active Background" : state.BackgroundImageFileName)
                                            </div>
                                            <div class="text-info" style="font-size: 0.72rem;">
                                                @(string.IsNullOrWhiteSpace(bgCompressionInfo) ? (state.BackgroundImageSizeBytes.HasValue ? $"{Math.Round((double)state.BackgroundImageSizeBytes.Value / 1024)} KB (HD)" : "HD Compressed") : bgCompressionInfo)
                                            </div>
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-outline-danger btn-sm p-1 px-2" @onclick="RemoveCustomBackground" title="Revert to Default">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            }

                            <label class="btn btn-info w-100 d-flex align-items-center justify-content-center gap-2 py-2 fw-semibold" style="background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%); border: none; border-radius: 8px; color: #070d1e; cursor: pointer;">
                                @if (isCompressingBg)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                    <span>Compressing HD Image...</span>
                                }
                                else
                                {
                                    <i class="bi bi-cloud-arrow-up-fill"></i>
                                    <span>Change Background Image</span>
                                }
                                <InputFile OnChange="HandleCustomBackgroundUpload" accept="image/*" disabled="@isCompressingBg" style="display: none;" />
                            </label>
                        </div>
                    </div>
                }

                <!-- TAB 2: EDITABLE CONTENT -->
                @if (activeTab == "content")
                {
                    <div class="tab-pane-content fade-in">
                        <!-- Language Switcher Pill Bar (English / Hindi) -->
                        <div class="p-2 mb-3 rounded-3 d-flex align-items-center justify-content-between" style="background: rgba(14, 25, 48, 0.9); border: 1px solid rgba(0, 242, 254, 0.3);">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-translate text-info fs-5"></i>
                                <div>
                                    <div class="fw-bold text-white" style="font-size: 0.84rem;">Banner Language / भाषा</div>
                                    <div class="text-secondary" style="font-size: 0.7rem;">English &amp; Hindi (Devanagari) Fonts</div>
                                </div>
                            </div>
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn @(state.Language == "en" ? "btn-info text-dark fw-bold" : "btn-outline-secondary text-white")" style="font-size: 0.76rem; padding: 4px 10px;" @onclick='() => SetLanguage("en")'>
                                    🇬🇧 English
                                </button>
                                <button type="button" class="btn @(state.Language == "hi" ? "btn-info text-dark fw-bold" : "btn-outline-secondary text-white")" style="font-size: 0.76rem; padding: 4px 10px;" @onclick='() => SetLanguage("hi")'>
                                    🇮🇳 हिन्दी
                                </button>
                            </div>
                        </div>

                        <!-- 1-Click Ready Medical Slogans (Language Adaptive) -->
                        <div class="p-2 mb-3 rounded-2" style="background: rgba(15, 23, 42, 0.65); border: 1px dashed rgba(255, 255, 255, 0.12);">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <small class="text-info fw-bold" style="font-size: 0.76rem;">
                                    <i class="bi bi-stars me-1"></i> @(state.Language == "hi" ? "1-क्लिक लोकप्रिय हिन्दी स्लोगन" : "1-Click Popular Medical Slogans")
                                </small>
                                <span class="badge bg-dark text-secondary" style="font-size: 0.68rem;">Quick Insert</span>
                            </div>
                            <div class="d-flex flex-wrap gap-1" style="max-height: 96px; overflow-y: auto;">
                                @if (state.Language == "hi")
                                {
                                    <button type="button" class="btn btn-xs btn-outline-info text-start py-1 px-2" style="font-size: 0.72rem; border-radius: 6px;" @onclick='() => ApplyPresetSlogan("विश्व हृदय दिवस: स्वस्थ दिल, खुशहाल जीवन", "हर धड़कन अनमोल है। नियमित कार्डियक चेकअप से दिल को सुरक्षित रखें।", "कार्डियक केयर")'>
                                        ❤️ दिल की सुरक्षा
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-info text-start py-1 px-2" style="font-size: 0.72rem; border-radius: 6px;" @onclick='() => ApplyPresetSlogan("निःशुल्क स्वास्थ्य जांच एवं परामर्श शिविर", "रविवार विशेष: बीपी, शुगर, ईसीजी व अनुभवी डॉक्टरों द्वारा परामर्श।", "फ्री हेल्थ कैंप")'>
                                        🏥 फ्री हेल्थ कैंप
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-info text-start py-1 px-2" style="font-size: 0.72rem; border-radius: 6px;" @onclick='() => ApplyPresetSlogan("दांतों की संपूर्ण देखभाल एवं सुरक्षित मुस्कान", "दांतों के दर्द, रूट कैनाल एवं डेंटल इंप्लांट्स का आधुनिक व दर्द-रहित इलाज।", "दंत चिकित्सा")'>
                                        🦷 डेंटल केयर
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-info text-start py-1 px-2" style="font-size: 0.72rem; border-radius: 6px;" @onclick='() => ApplyPresetSlogan("बच्चों का संपूर्ण टीकाकरण एवं पोषण परामर्श", "मौसम के बदलाव में बच्चों की विशेष देखभाल। अनुभवी शिशु रोग विशेषज्ञ द्वारा परामर्श।", "शिशु रोग ओपीडी")'>
                                        👶 बाल स्वास्थ्य
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-info text-start py-1 px-2" style="font-size: 0.72rem; border-radius: 6px;" @onclick='() => ApplyPresetSlogan("जोड़ों व रीढ़ के दर्द से पाएं तुरंत राहत", "आधुनिक ऑर्थोपेडिक व आर्थराइटिस केयर। बिना रुकावट फिर से चलें-फिरें।", "हड्डी व जोड़ रोग")'>
                                        🦴 हड्डी व जोड़
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-info text-start py-1 px-2" style="font-size: 0.72rem; border-radius: 6px;" @onclick='() => ApplyPresetSlogan("डायबिटीज एवं हाई बीपी पर रखें पूरा नियंत्रण", "संतुलित खान-पान, नियमित जांच और सही दवाओं से स्वस्थ जीवन जीएं।", "डायबिटीज क्लीनिक")'>
