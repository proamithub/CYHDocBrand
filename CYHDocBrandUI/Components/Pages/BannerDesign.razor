                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-xs btn-outline-info text-start py-1 px-2" style="font-size: 0.72rem; border-radius: 6px;" @onclick='() => ApplyPresetSlogan("World Heart Day: Keep Your Heart Young & Healthy", "Regular preventive cardiac screenings protect your heart for a healthier tomorrow.", "CARDIAC CARE")'>
                                        ❤️ Healthy Heart
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-info text-start py-1 px-2" style="font-size: 0.72rem; border-radius: 6px;" @onclick='() => ApplyPresetSlogan("Free Multi-Specialty Health Screening Camp", "Complimentary BP, blood sugar checkup and one-on-one specialist consultation.", "HEALTH CAMP")'>
                                        🏥 Free Camp
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-info text-start py-1 px-2" style="font-size: 0.72rem; border-radius: 6px;" @onclick='() => ApplyPresetSlogan("Advanced Dental Care & Complete Smile Makeover", "Painless root canals, precision dental implants and cosmetic teeth whitening.", "DENTAL CLINIC")'>
                                        🦷 Dental Clinic
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-info text-start py-1 px-2" style="font-size: 0.72rem; border-radius: 6px;" @onclick='() => ApplyPresetSlogan("Expert Pediatric Care & Timely Child Vaccination", "Compassionate childcare, developmental milestone tracking and seasonal wellness checkups.", "PEDIATRICS")'>
                                        👶 Child Care
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-info text-start py-1 px-2" style="font-size: 0.72rem; border-radius: 6px;" @onclick='() => ApplyPresetSlogan("Say Goodbye to Chronic Joint & Spine Pain", "Advanced orthopedic arthritis management and minimally invasive joint treatments.", "ORTHOPEDICS")'>
                                        🦴 Orthopedics
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-info text-start py-1 px-2" style="font-size: 0.72rem; border-radius: 6px;" @onclick='() => ApplyPresetSlogan("Comprehensive Diabetes & Hypertension Control", "Holistic sugar control, metabolic monitoring and tailored medical lifestyle coaching.", "DIABETES CARE")'>
                                        🩸 Diabetes Care
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-info text-start py-1 px-2" style="font-size: 0.72rem; border-radius: 6px;" @onclick='() => ApplyPresetSlogan("Immediate 24x7 Emergency & Critical Care", "Round-the-clock intensive care, ventilator support and fast emergency resuscitation.", "24x7 TRAUMA")'>
                                        🚨 Emergency 24x7
                                    </button>
                                }
                            </div>
                        </div>

                        <!-- Main Heading & Font Size / Style -->
                        <div class="mb-3">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <label class="form-label text-secondary fw-semibold mb-0" style="font-size: 0.85rem;">Main Heading / Topic</label>
                                <span class="badge bg-dark border border-secondary text-info" style="font-size: 0.72rem;">Font: @(state.HeadingFontSize)px</span>
                            </div>
                            <input type="text" class="form-control bg-dark text-white border-secondary mb-2" @bind="state.Heading" @bind:after="RenderCanvas" placeholder="@(state.Language == "hi" ? "उदा. विश्व हृदय दिवस: स्वस्थ दिल, खुशहाल जीवन" : "e.g. World Heart Day Awareness")" style="border-radius: 8px;" />
                            
                            <!-- Heading Font Sizing & Typography Row -->
                            <div class="row g-2 align-items-center mb-1">
                                <div class="col-7">
                                    <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="state.HeadingFontFamily" @bind:after="RenderCanvas" style="border-radius: 8px; font-size: 0.76rem;">
                                        <optgroup label="🇮🇳 Hindi &amp; Bilingual (हिंदी)">
                                            <option value="Noto Sans Devanagari">Noto Sans Devanagari (स्पष्ट एवं आधुनिक)</option>
                                            <option value="Poppins">Poppins (बोल्ड एवं स्टाइलिश)</option>
                                            <option value="Mukta">Mukta (आधुनिक देवनागरी)</option>
                                            <option value="Rozha One">Rozha One (रॉयल हेडिंग)</option>
                                            <option value="Hind">Hind (साफ और सुपाठ्य)</option>
                                            <option value="Yatra One">Yatra One (पोस्टर डिस्प्ले)</option>
                                        </optgroup>
                                        <optgroup label="🇬🇧 English Typography">
                                            <option value="Poppins">Poppins (Modern Bold)</option>
                                            <option value="Inter">Inter (Clean Tech)</option>
                                            <option value="Montserrat">Montserrat (Impactful)</option>
                                            <option value="Playfair Display">Playfair Display (Luxury Serif)</option>
                                            <option value="Merriweather">Merriweather (Classic Trust)</option>
                                        </optgroup>
                                    </select>
                                </div>
                                <div class="col-5 d-flex align-items-center gap-1">
                                    <input type="range" class="form-range flex-grow-1" min="32" max="80" step="2" @bind="state.HeadingFontSize" @bind:after="RenderCanvas" />
                                    <span class="text-info fw-bold small" style="min-width: 36px; font-size: 0.74rem;">@(state.HeadingFontSize)px</span>
                                </div>
                            </div>
                        </div>

                        <!-- Subtitle / Description & Font Size Control -->
                        <div class="mb-3">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <label class="form-label text-secondary fw-semibold mb-0" style="font-size: 0.85rem;">Subtitle / Description</label>
                                <span class="badge bg-dark border border-secondary text-info" style="font-size: 0.72rem;">Font: @(state.SubtitleFontSize)px</span>
                            </div>
                            <textarea class="form-control bg-dark text-white border-secondary mb-2" rows="2" @bind="state.Subtitle" @bind:after="RenderCanvas" placeholder="Brief clinical message or advice" style="border-radius: 8px; font-size: 0.85rem;"></textarea>
                            
                            <!-- Subtitle Font Sizing Box -->
                            <div class="p-2 rounded-2 mb-2" style="background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(0, 242, 254, 0.2);">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <small class="text-secondary fw-semibold" style="font-size: 0.76rem;">Subtitle Font Size:</small>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" class="btn btn-xs @(state.SubtitleFontSize == 20 ? "btn-info text-dark fw-bold" : "btn-outline-secondary text-white")" style="font-size: 0.7rem; padding: 2px 7px;" @onclick='() => SetSubtitleSize(20)'>Small</button>
                                        <button type="button" class="btn btn-xs @(state.SubtitleFontSize == 28 ? "btn-info text-dark fw-bold" : "btn-outline-secondary text-white")" style="font-size: 0.7rem; padding: 2px 7px;" @onclick='() => SetSubtitleSize(28)'>Medium</button>
                                        <button type="button" class="btn btn-xs @(state.SubtitleFontSize == 36 ? "btn-info text-dark fw-bold" : "btn-outline-secondary text-white")" style="font-size: 0.7rem; padding: 2px 7px;" @onclick='() => SetSubtitleSize(36)'>Large</button>
                                        <button type="button" class="btn btn-xs @(state.SubtitleFontSize == 46 ? "btn-info text-dark fw-bold" : "btn-outline-secondary text-white")" style="font-size: 0.7rem; padding: 2px 7px;" @onclick='() => SetSubtitleSize(46)'>XL</button>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <input type="range" class="form-range flex-grow-1" min="16" max="54" step="2" @bind="state.SubtitleFontSize" @bind:after="RenderCanvas" />
                                    <span class="text-info fw-bold small" style="min-width: 42px;">@(state.SubtitleFontSize)px</span>
                                </div>
                                <div class="row g-2 align-items-center mb-1">
                                    <div class="col-6">
                                        <label class="text-secondary mb-0" style="font-size: 0.72rem;">Subtitle Font Style:</label>
                                        <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="state.SubtitleFontFamily" @bind:after="RenderCanvas" style="border-radius: 8px; font-size: 0.75rem;">
                                            <optgroup label="🇮🇳 Hindi &amp; Bilingual">
                                                <option value="Noto Sans Devanagari">Noto Sans Devanagari</option>
                                                <option value="Poppins">Poppins</option>
                                                <option value="Mukta">Mukta</option>
                                                <option value="Hind">Hind</option>
                                            </optgroup>
                                            <optgroup label="🇬🇧 English Typography">
                                                <option value="Poppins">Poppins</option>
                                                <option value="Inter">Inter</option>
                                                <option value="Montserrat">Montserrat</option>
                                                <option value="Merriweather">Merriweather</option>
                                            </optgroup>
                                        </select>
                                    </div>
                                    <div class="col-6">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <label class="text-secondary mb-0" style="font-size: 0.72rem;">Line Spacing:</label>
                                            <span class="text-secondary small">@(state.SubtitleLineHeight)px</span>
                                        </div>
                                        <input type="range" class="form-range" min="22" max="65" step="2" @bind="state.SubtitleLineHeight" @bind:after="RenderCanvas" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Doctor Card Size, Font & Spacing Section -->
                        <div class="p-3 mb-3 rounded-3" style="background: rgba(14, 25, 48, 0.85); border: 1px solid rgba(0, 242, 254, 0.25);">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <div class="fw-bold text-white d-flex align-items-center gap-2" style="font-size: 0.88rem;">
                                    <i class="bi bi-person-badge-fill text-info"></i>
                                    <span>Doctor Card Size &amp; Typography</span>
                                </div>
                                <span class="badge bg-info bg-opacity-20 text-info border border-info border-opacity-50" style="font-size: 0.7rem;">Interactive Drag Active</span>
                            </div>

                            <!-- Card Overall Scale / Size -->
                            <div class="mb-2">
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <small class="text-secondary" style="font-size: 0.76rem;">Card Overall Scale / Size:</small>
                                    <span class="text-info fw-bold small">@((int)(state.DoctorCardScale * 100))%</span>
                                </div>
                                <input type="range" class="form-range" min="0.6" max="1.4" step="0.05" @bind="state.DoctorCardScale" @bind:after="RenderCanvas" />
                            </div>

                            <!-- Doctor Name Font Size & Spec Font Size -->
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <div class="d-flex align-items-center justify-content-between mb-1">
                                        <small class="text-secondary" style="font-size: 0.74rem;">Name Font:</small>
                                        <span class="text-info fw-semibold" style="font-size: 0.74rem;">@(state.DoctorNameFontSize)px</span>
                                    </div>
                                    <input type="range" class="form-range" min="20" max="52" step="2" @bind="state.DoctorNameFontSize" @bind:after="RenderCanvas" />
                                </div>
                                <div class="col-6">
                                    <div class="d-flex align-items-center justify-content-between mb-1">
                                        <small class="text-secondary" style="font-size: 0.74rem;">Dept Font:</small>
                                        <span class="text-info fw-semibold" style="font-size: 0.74rem;">@(state.DoctorSpecFontSize)px</span>
                                    </div>
                                    <input type="range" class="form-range" min="14" max="36" step="1" @bind="state.DoctorSpecFontSize" @bind:after="RenderCanvas" />
                                </div>
                            </div>

                            <!-- Doctor Card Font Family Selector -->
                            <div class="mb-2">
                                <label class="text-secondary mb-1" style="font-size: 0.76rem;">Doctor Card Font Style:</label>
                                <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="state.DoctorCardFontFamily" @bind:after="RenderCanvas" style="border-radius: 8px; font-size: 0.8rem;">
                                    <optgroup label="🇮🇳 Hindi &amp; Bilingual (हिंदी)">
                                        <option value="Noto Sans Devanagari">Noto Sans Devanagari (सर्वश्रेष्ठ स्पष्टता)</option>
                                        <option value="Poppins">Poppins (बोल्ड एवं मॉडर्न)</option>
                                        <option value="Mukta">Mukta (सॉफ्ट देवनागरी)</option>
                                        <option value="Hind">Hind (साफ और सुपाठ्य)</option>
                                    </optgroup>
                                    <optgroup label="🇬🇧 English Typography">
                                        <option value="Poppins">Poppins (Bold Geometric Professional)</option>
                                        <option value="Inter">Inter (Modern Clean Healthcare)</option>
                                        <option value="Montserrat">Montserrat (Executive Prestige)</option>
                                        <option value="Playfair Display">Playfair Display (Luxury Clinic Aesthetic)</option>
                                        <option value="Merriweather">Merriweather (Classic Trust)</option>
                                    </optgroup>
                                </select>
                            </div>

                            <!-- Corner Radius & Padding -->
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <div class="d-flex align-items-center justify-content-between mb-1">
                                        <small class="text-secondary" style="font-size: 0.74rem;">Card Padding:</small>
                                        <span class="text-secondary" style="font-size: 0.74rem;">@(state.DoctorCardPadding)px</span>
                                    </div>
                                    <input type="range" class="form-range" min="10" max="36" step="2" @bind="state.DoctorCardPadding" @bind:after="RenderCanvas" />
                                </div>
                                <div class="col-6">
                                    <div class="d-flex align-items-center justify-content-between mb-1">
                                        <small class="text-secondary" style="font-size: 0.74rem;">Corner Curve:</small>
                                        <span class="text-secondary" style="font-size: 0.74rem;">@(state.DoctorCardBorderRadius)px</span>
                                    </div>
                                    <input type="range" class="form-range" min="0" max="36" step="2" @bind="state.DoctorCardBorderRadius" @bind:after="RenderCanvas" />
                                </div>
                            </div>

                            <!-- Accent Bar Toggle & Reset -->
                            <div class="d-flex align-items-center justify-content-between pt-2 border-top border-secondary border-opacity-25">
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" id="accentBarCheck" @bind="state.ShowDoctorCardAccentBar" @bind:after="RenderCanvas">
                                    <label class="form-check-label text-secondary small" for="accentBarCheck">Accent Bar</label>
                                </div>
                                <button type="button" class="btn btn-outline-secondary btn-sm py-1 px-2" style="font-size: 0.75rem;" @onclick="ResetDoctorCardPositions">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Card Size
                                </button>
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-7">
                                <label class="form-label text-secondary fw-semibold" style="font-size: 0.85rem;">Doctor Name & Degree</label>
                                <input type="text" class="form-control bg-dark text-white border-secondary" @bind="state.DoctorName" @bind:after="RenderCanvas" style="border-radius: 8px;" />
                            </div>
                            <div class="col-5">
                                <label class="form-label text-secondary fw-semibold" style="font-size: 0.85rem;">Category Badge</label>
                                <input type="text" class="form-control bg-dark text-white border-secondary" @bind="state.BadgeText" @bind:after="RenderCanvas" style="border-radius: 8px;" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-secondary fw-semibold" style="font-size: 0.85rem;">Specialization / Department</label>
                            <input type="text" class="form-control bg-dark text-white border-secondary" @bind="state.Specialization" @bind:after="RenderCanvas" style="border-radius: 8px;" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-secondary fw-semibold" style="font-size: 0.85rem;">Hospital / Clinic Name</label>
                            <input type="text" class="form-control bg-dark text-white border-secondary" @bind="state.HospitalName" @bind:after="RenderCanvas" style="border-radius: 8px;" />
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label text-secondary fw-semibold" style="font-size: 0.85rem;">Contact / OPD Booking</label>
                                <input type="text" class="form-control bg-dark text-white border-secondary" @bind="state.ContactPhone" @bind:after="RenderCanvas" style="border-radius: 8px;" />
                            </div>
                            <div class="col-6">
                                <label class="form-label text-secondary fw-semibold" style="font-size: 0.85rem;">Emergency Helpline</label>
                                <input type="text" class="form-control bg-dark text-white border-secondary" @bind="state.EmergencyPhone" @bind:after="RenderCanvas" style="border-radius: 8px;" />
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label text-secondary fw-semibold" style="font-size: 0.85rem;">Official Website URL</label>
                                <input type="text" class="form-control bg-dark text-white border-secondary" @bind="state.Website" @bind:after="RenderCanvas" placeholder="https://www.clickyourhospital.com" style="border-radius: 8px;" />
                            </div>
                            <div class="col-6">
                                <label class="form-label text-secondary fw-semibold" style="font-size: 0.85rem;">Clinic / Chamber Address</label>
                                <input type="text" class="form-control bg-dark text-white border-secondary" @bind="state.Address" @bind:after="RenderCanvas" placeholder="Clinic Address" style="border-radius: 8px;" />
                            </div>
                        </div>
                    </div>
                }

                <!-- TAB 3: MULTIPLE PHOTOS & OVERLAYS -->
                @if (activeTab == "images")
                {
                    <div class="tab-pane-content fade-in">
                        <div class="p-3 mb-3 rounded-3" style="background: rgba(0, 242, 254, 0.08); border: 1px dashed rgba(0, 242, 254, 0.35);">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="fw-bold text-white" style="font-size: 0.9rem;">
                                    <i class="bi bi-image-fill text-info me-1"></i> Add Doctor Photo / Badges / QR
                                </span>
                                <span class="badge bg-info text-dark">Multiple Support</span>
                            </div>
                            <p class="text-secondary mb-2" style="font-size: 0.78rem;">
                                Apni device se images upload karein. Har photo canvas par aayegi aur aap use **mouse se drag** karke kahin bhi fit kar sakte hain!
                            </p>
                            
                            <label class="btn btn-outline-info btn-sm w-100 py-2 d-flex align-items-center justify-content-center gap-2" style="border-radius: 8px; cursor: pointer;">
                                <i class="bi bi-cloud-arrow-up-fill fs-6"></i>
                                <span>Upload Images (+ Add)</span>
                                <InputFile OnChange="HandleOverlayImagesUpload" multiple accept="image/*" style="display: none;" />
                            </label>
                        </div>

                        <!-- List of Added Overlays -->
                        @if (!state.OverlayImages.Any())
                        {
                            <div class="text-center py-4 text-secondary" style="font-size: 0.82rem;">
                                <i class="bi bi-images fs-3 d-block mb-1 text-muted"></i>
                                Koi extra image add nahi hui hai. Upar se doctor photo ya clinic badge upload karein.
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-2">
                                @for (int i = 0; i < state.OverlayImages.Count; i++)
                                {
                                    var idx = i;
                                    var img = state.OverlayImages[idx];

                                    <div class="p-2 rounded-3" style="background: rgba(7, 13, 30, 0.7); border: 1px solid rgba(255, 255, 255, 0.08);">
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <img src="@img.ImageUrl" style="width: 38px; height: 38px; object-fit: cover; border-radius: @(img.IsCircle ? "50%" : "6px"); border: 1px solid #00f2fe;" />
                                                <div>
                                                    <div class="text-white fw-semibold" style="font-size: 0.82rem;">@img.Name</div>
                                                    <div class="text-secondary" style="font-size: 0.7rem;">Pos: X: @((int)img.X), Y: @((int)img.Y)</div>
                                                </div>
                                            </div>

                                            <div class="d-flex align-items-center gap-2">
                                                <button type="button" class="btn btn-sm @(img.IsCircle ? "btn-info text-dark" : "btn-outline-secondary")" @onclick="() => ToggleImageCircle(idx)" title="Toggle Circle or Square shape" style="font-size: 0.72rem; padding: 2px 8px;">
                                                    @(img.IsCircle ? "Circle" : "Square")
                                                </button>

                                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveOverlayImage(idx)" title="Remove Image" style="padding: 2px 8px;">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </div>

                                        <div class="d-flex align-items-center gap-2">
                                            <span class="text-secondary" style="font-size: 0.72rem;">Size:</span>
                                            <input type="range" class="form-range" min="80" max="380" step="10" @bind="img.Width" @bind:after="() => OnImageSizeChanged(idx)" />
                                            <span class="text-info" style="font-size: 0.75rem; width: 45px;">@((int)img.Width)px</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                <!-- TAB 4: BRANDING & FIXED LOGO -->
                @if (activeTab == "branding")
                {
                    <div class="tab-pane-content fade-in">
                        <div class="p-3 mb-3 rounded-3" style="background: rgba(0, 242, 254, 0.08); border: 1px dashed rgba(0, 242, 254, 0.35);">
