    private bool isCompressingBg = false;
    private string? bgCompressionInfo;

    private async Task HandleCustomBackgroundUpload(InputFileChangeEventArgs e)
    {
        EnsureDraftMode();
        var file = e.File;
        if (file == null) return;

        isCompressingBg = true;
        bgCompressionInfo = "Reading & compressing background image in HD quality...";
        StateHasChanged();

        try
        {
            const long maxRawSize = 25 * 1024 * 1024;
            if (file.Size > maxRawSize)
            {
                ShowPopup("File Too Large", "Kripya 25 MB se choti image select karein.", "warning");
                return;
            }

            // Step 1: Pre-scale safely on client side using Blazor RequestImageFileAsync
            // Scales large camera images to max 1920x1920 in browser before WebSocket transmission,
            // avoiding SignalR message size overflow on mobile/slow networks while maintaining 100% full HD sharpness.
            IBrowserFile uploadFile = file;
            var format = file.ContentType;
            if (string.IsNullOrWhiteSpace(format)) format = "image/jpeg";

            try
            {
                uploadFile = await file.RequestImageFileAsync("image/jpeg", 1920, 1920);
                format = "image/jpeg";
            }
            catch
            {
                uploadFile = file;
            }

            var buffer = new byte[uploadFile.Size];
            await uploadFile.OpenReadStream(maxRawSize).ReadExactlyAsync(buffer);
            var rawBase64 = $"data:{format};base64,{Convert.ToBase64String(buffer)}";

            await EnsureBannerStudioLoadedAsync();

            CompressionResult? compResult = null;
            try
            {
                compResult = await JSRuntime.InvokeAsync<CompressionResult>("bannerStudio.compressBackgroundImage", rawBase64, file.Name);
            }
            catch (Exception compEx)
            {
                Console.WriteLine($"JS compression notice: {compEx.Message}");
            }

            if (compResult != null && compResult.Success && !string.IsNullOrEmpty(compResult.DataUrl))
            {
                state.BackgroundImageUrl = compResult.DataUrl;
                state.BackgroundStyle = "ai-image";
                state.BackgroundImageFileName = compResult.FileName;
                state.BackgroundImageSizeBytes = compResult.SizeBytes;

                var origKb = Math.Round((double)file.Size / 1024);
                bgCompressionInfo = $"✅ Compressed: {compResult.SizeFormatted} (Original: {origKb} KB, HD Quality)";
                ShowPopup("Background Updated", $"Background image compress ho gayi! Size: {compResult.SizeFormatted} (HD quality preserved).", "save");
                await RenderCanvas();
            }
            else
            {
                state.BackgroundImageUrl = rawBase64;
                state.BackgroundStyle = "ai-image";
                state.BackgroundImageFileName = file.Name;
                state.BackgroundImageSizeBytes = uploadFile.Size;
                var safeKb = Math.Round((double)uploadFile.Size / 1024);
                bgCompressionInfo = $"✅ Active Background: {safeKb} KB (HD Quality)";
                ShowPopup("Background Updated", $"Background image set ho gayi! Size: {safeKb} KB.", "save");
                await RenderCanvas();
            }
        }
        catch (Exception ex)
        {
            ShowPopup("Upload Error", ex.Message, "error");
        }
        finally
        {
            isCompressingBg = false;
            StateHasChanged();
        }
    }

