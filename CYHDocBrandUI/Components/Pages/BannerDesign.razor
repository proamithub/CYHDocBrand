                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-info text-start py-1 px-2" style="font-size: 0.72rem; border-radius: 6px;" @onclick='() => ApplyPresetSlogan("शुभ दीपावली: उत्तम स्वास्थ्य और खुशहाली की शुभकामनाएं", "खुशियों का यह पावन पर्व आपके और आपके परिवार के लिए उत्तम स्वास्थ्य और समृद्धि लाए।", "हार्दिक शुभकामनाएं")'>
