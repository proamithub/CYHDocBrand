    private async Task PublishBannerAsync()
    {
        if (IsPublished || IsAdmin) return;
        isSaving = true;
        savingMode = "publish";
        statusMessage = null;

        try
        {
            state.Status = "Published";
            if (string.IsNullOrWhiteSpace(state.Heading))
            {
                state.Heading = state.Language == "hi" ? "स्वास्थ्य परामर्श एवं उपचार" : "Specialist Medical Care";
            }
            if (string.IsNullOrWhiteSpace(state.DoctorName))
            {
                state.DoctorName = currentUser != null && !string.IsNullOrWhiteSpace(currentUser.FullName)
                    ? (currentUser.Role == "Doctor" ? $"Dr. {currentUser.FullName}" : currentUser.FullName)
                    : "Dr. Specialist, MD";
            }

            var effectiveUserId = currentUser?.Role == "Admin" ? null : currentUser?.UserId;
            var savedId = await BannerRepo.SaveDraftAsync(state, effectiveUserId);
            if (savedId > 0)
            {
                state.Id = savedId;
                loadedId = savedId;

                var relPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).ToLowerInvariant();
                var prefix = (currentUser?.Role == "Doctor" || relPath.StartsWith("doctor")) ? "doctor/" : 
                             ((currentUser?.Role == "Admin" || relPath.StartsWith("admin")) ? "admin/" : "");
                var encId = UrlEncryptionHelper.EncryptId(savedId);
                NavigationManager.NavigateTo($"{prefix}banner-design?id={encId}", replace: true);

                // Credit System Validation & Deduction
                int doctorProfileId = 0;
                if (currentUser?.Role == "Doctor")
                {
                    if (currentUser.DoctorProfileId.HasValue && currentUser.DoctorProfileId.Value > 0)
                    {
                        doctorProfileId = currentUser.DoctorProfileId.Value;
                    }
                    else if (!string.IsNullOrEmpty(currentUser.UserId))
                    {
                        var docProf = await DoctorRepo.GetByUserIdAsync(currentUser.UserId);
                        if (docProf != null) doctorProfileId = docProf.Id;
                    }

                    if (doctorProfileId > 0)
                    {
                        // Determine whether it's AI banner or Template
                        string creditCode = (!string.IsNullOrEmpty(RawEncryptedTemplateId) || state.TemplateType == "Template")
                            ? "TEMPLATE_PUBLISH"
                            : "AI_BANNER_PUBLISH";

                        var (credOk, credMsg, remaining) = await CreditRepo.DeductCreditOnPublishAsync(
                            doctorProfileId, 
                            creditCode, 
                            savedId.ToString(), 
                            $"Published banner #{savedId}: {state.Heading}");

                        if (!credOk)
                        {
                            statusMessage = credMsg;
                            ShowPopup("Insufficient Credits", credMsg, "warning");
                            isSaving = false;
                            return;
                        }
                    }
                }

                var pubSuccess = await BannerRepo.PublishBannerAsync(savedId, effectiveUserId);
                if (pubSuccess)
                {
                    await RenderCanvas();
                    statusMessage = $"🎉 Banner #{savedId} successfully Published & LOCKED! Download and Social Share are now active.";
                    ShowPopup("Banner Published!", $"🎉 Banner #{savedId} successfully publish ho gaya hai! 1 Credit deduct hua. HD Export aur Share ready hain.", "save");
                }
                else
                {
                    statusMessage = "Banner saved as draft, but could not update status to Published.";
                    ShowPopup("Publish Incomplete", "Status update failed in database.", "warning");
                }
            }
            else
            {
                statusMessage = "Failed to publish banner.";
                ShowPopup("Publish Failed", "Banner publish nahi ho saka.", "error");
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error publishing: {ex.Message}";
            ShowPopup("Publish Error", ex.Message, "error");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private async Task TriggerAiGeneration()
    {
        EnsureDraftMode();

        isGenerating = true;
        statusMessage = null;
        StateHasChanged();

        try
        {
            aiRequest.DoctorId = currentUser?.DoctorProfileId;
            aiRequest.UserId = currentUser?.UserId;
            aiRequest.DoctorName = state.DoctorName;

            var result = await BannerAiService.GenerateBannerAsync(aiRequest);
            if (result.Success)
            {
                var bgUrl = !string.IsNullOrEmpty(result.ImageBase64) 
                    ? result.ImageBase64 
                    : result.ImageUrl;

                if (!string.IsNullOrEmpty(bgUrl) && bgUrl.StartsWith("data:image"))
                {
                    try
                    {
                        await EnsureBannerStudioLoadedAsync();
                        var comp = await JSRuntime.InvokeAsync<CompressionResult>("bannerStudio.compressBackgroundImage", bgUrl, "ai-background.jpg");
                        if (comp != null && comp.Success && !string.IsNullOrEmpty(comp.DataUrl))
                        {
                            bgUrl = comp.DataUrl;
                            state.BackgroundImageSizeBytes = comp.SizeBytes;
                        }
                    }
                    catch { }
                }

                state.BackgroundImageUrl = bgUrl;
                state.BackgroundStyle = "ai-image";
                state.BackgroundImageFileName = $"AI-Background-{DateTime.Now:yyyyMMddHHmmss}.jpg";

                await RenderCanvas();
                statusMessage = $"Background generated successfully with {result.ProviderUsed}!";
            }
            else
            {
                statusMessage = $"Generation error: {result.ErrorMessage}";
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            isGenerating = false;
            StateHasChanged();
        }
    }

    private async Task RenderCanvas()
    {
        try
        {
            var isReady = await JSRuntime.InvokeAsync<bool>("eval", 
                "typeof window.bannerStudio !== 'undefined' && typeof window.bannerStudio.renderBanner === 'function'");
            if (isReady)
            {
                await JSRuntime.InvokeVoidAsync("bannerStudio.renderBanner", "bannerCanvas", state);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error rendering canvas: {ex.Message}");
        }
    }

    private async Task DownloadBannerPng()
    {
        try
        {
            await EnsureBannerStudioLoadedAsync();
            var filename = $"CYH_Banner_{state.TemplateType}_{DateTime.UtcNow:yyyyMMdd_HHmmss}.png";
            await JSRuntime.InvokeVoidAsync("bannerStudio.downloadBanner", "bannerCanvas", filename);
            statusMessage = "Banner downloaded successfully in high resolution PNG!";
            ShowPopup("PNG Downloaded", "High-Resolution PNG banner successfully download ho gaya hai!", "save");
        }
        catch (Exception ex)
        {
            statusMessage = $"Failed to download banner: {ex.Message}";
            ShowPopup("Download Error", ex.Message, "error");
        }
    }

    private async Task ShareOnSocialMedia()
    {
        try
        {
            await EnsureBannerStudioLoadedAsync();
            var shareTitle = $"{state.Heading} — {state.HospitalName}";
            var shareText = $"{state.Heading}\n{state.Subtitle}\nConsult {state.DoctorName} at {state.HospitalName}.\nHelpline: {state.ContactPhone}";
            
            var res = await JSRuntime.InvokeAsync<ShareResult>("bannerStudio.shareBanner", "bannerCanvas", shareTitle, shareText);
            if (res.Success)
            {
                statusMessage = res.Message;
                ShowPopup("Shared Successfully", res.Message, "save");
            }
            else
            {
                statusMessage = res.Message;
                ShowPopup("Share Info", res.Message, "warning");
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Share error: {ex.Message}";
            ShowPopup("Share Error", ex.Message, "error");
        }
    }

    public void Dispose()
    {
        dotNetRef?.Dispose();
    }

    private class ShareResult
    {
        public bool Success { get; set; }
        public string Message { get; set; } = string.Empty;
    }
}
