@page "/"
@page "/login"
@layout AuthLayout
@implements IDisposable
@inject IAuthService AuthService
@inject IOtpService OtpService
@inject IDoctorRepository DoctorRepo
@inject NavigationManager NavigationManager

<div class="glass-panel p-3 p-sm-4 p-md-5 position-relative overflow-hidden" style="border: 1px solid rgba(255, 255, 255, 0.12); box-shadow: 0 20px 50px rgba(0, 0, 0, 0.65), 0 0 35px rgba(0, 242, 254, 0.15);">
    <div class="position-absolute top-0 start-0 w-100" style="height: 3px; background: linear-gradient(90deg, #00f2fe, #4facfe, #8b5cf6);"></div>

    <div class="text-center mb-4">
        <div class="mb-3 text-center">
            <img src="images/branding/cyh-logo.png" alt="CYH Care Aisi Family Jaisi" style="max-height: 84px; max-width: 230px; object-fit: contain; filter: drop-shadow(0 6px 16px rgba(0, 242, 254, 0.35));" />
        </div>
        <h2 class="fw-bold mb-1 text-white" style="letter-spacing: -0.5px;">CYH Doctor Portal</h2>
        <hr />
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger py-2 px-3 small d-flex align-items-center gap-2 mb-3" style="background: rgba(244, 63, 94, 0.15); border: 1px solid rgba(244, 63, 94, 0.35); color: #fda4af; border-radius: 10px;">
            <i class="bi bi-exclamation-octagon-fill fs-6 flex-shrink-0"></i>
            <span>@ErrorMessage</span>
        </div>
    }

    <!-- Login Mode Tabs: Email vs Mobile OTP -->
    <div class="d-flex p-1 mb-4 rounded-3" style="background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(255, 255, 255, 0.1);">
        <button type="button" 
                class="btn flex-fill py-2 text-center rounded-2 border-0 fw-semibold"
                style="@(LoginMode == "email" ? "background: linear-gradient(135deg, #00f2fe, #4facfe); color: #04101e !important; box-shadow: 0 4px 15px rgba(0, 242, 254, 0.35);" : "background: transparent; color: #94a3b8;") transition: all 0.25s ease;"
                @onclick='() => SetLoginMode("email")'>
            <i class="bi bi-envelope-at-fill me-1"></i> Email &amp; Password
        </button>
        <button type="button" 
                class="btn flex-fill py-2 text-center rounded-2 border-0 fw-semibold"
                style="@(LoginMode == "mobile" ? "background: linear-gradient(135deg, #00f2fe, #4facfe); color: #04101e !important; box-shadow: 0 4px 15px rgba(0, 242, 254, 0.35);" : "background: transparent; color: #94a3b8;") transition: all 0.25s ease;"
                @onclick='() => SetLoginMode("mobile")'>
            <i class="bi bi-phone-vibrate-fill me-1"></i> Mobile &amp; OTP
        </button>
    </div>

    <!-- ========================================== -->
    <!-- TAB 1: EMAIL & PASSWORD LOGIN               -->
    <!-- ========================================== -->
    @if (LoginMode == "email")
    {
        <div class="mb-3">
            <label class="form-label d-flex align-items-center gap-1 mb-2" style="font-size: 0.86rem; font-weight: 600; color: #f1f5f9; letter-spacing: 0.3px;">
                <i class="bi bi-envelope-fill text-info" style="font-size: 0.95rem;"></i>
                <span>Email Address</span>
            </label>
            <div class="position-relative">
                <i class="bi bi-envelope position-absolute" style="left: 14px; top: 50%; transform: translateY(-50%); font-size: 1rem; color: #38bdf8;"></i>
                <input type="email" class="glass-input" style="padding-left: 2.6rem;" @bind="Email" placeholder="Enter your email address" autocomplete="off" />
            </div>
        </div>

        <div class="mb-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <label class="form-label d-flex align-items-center gap-1 mb-0" style="font-size: 0.86rem; font-weight: 600; color: #f1f5f9; letter-spacing: 0.3px;">
                    <i class="bi bi-shield-lock-fill text-info" style="font-size: 0.95rem;"></i>
                    <span>Password</span>
                </label>
            </div>
            <div class="position-relative">
                <i class="bi bi-lock position-absolute" style="left: 14px; top: 50%; transform: translateY(-50%); font-size: 1rem; color: #38bdf8;"></i>
                <input type="@(ShowPassword ? "text" : "password")" class="glass-input" style="padding-left: 2.6rem; padding-right: 2.75rem;" @bind="Password" placeholder="Enter your password" @onkeyup="HandleKeyUp" autocomplete="off" />
                <button type="button" 
                        class="btn position-absolute p-0 border-0" 
                        style="right: 14px; top: 50%; transform: translateY(-50%); color: #00f2fe; background: transparent; z-index: 10; display: flex; align-items: center; justify-content: center; cursor: pointer; width: 30px; height: 30px; border-radius: 6px; transition: all 0.2s ease;"
                        title="@(ShowPassword ? "Hide password" : "Show password")"
                        @onclick="TogglePasswordVisibility">
                    @if (ShowPassword)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="#00f2fe" viewBox="0 0 16 16">
                            <path d="m10.79 12.912-1.614-1.615a3.5 3.5 0 0 1-4.474-4.474l-2.06-2.06C.938 6.278 0 8 0 8s3 5.5 8 5.5a7 7 0 0 0 2.79-.588M5.21 3.088A7 7 0 0 1 8 2.5c5 0 8 5.5 8 5.5s-.939 1.721-2.641 3.238l-2.062-2.062a3.5 3.5 0 0 0-4.474-4.474z"/>
                            <path d="M5.525 7.646a2.5 2.5 0 0 0 2.829 2.829zm4.95.708-2.829-2.83a2.5 2.5 0 0 1 2.829 2.829zm3.171 5.95L1.354 1.96 2.06 1.253l12.354 12.354z"/>
                        </svg>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="#00f2fe" viewBox="0 0 16 16">
                            <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
                            <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
                        </svg>
                    }
                </button>
            </div>
        </div>

        <div class="d-flex align-items-center justify-content-between mb-4" style="font-size: 0.88rem;">
            <label class="d-flex align-items-center gap-2 mb-0" style="cursor: pointer; color: #e2e8f0; font-weight: 500;">
                <input type="checkbox" class="form-check-input bg-dark border-secondary" checked />
                <span>Keep me signed in</span>
            </label>
            <a href="javascript:void(0)" class="text-decoration-none" style="color: #00f2fe; font-weight: 600;">Need Help?</a>
        </div>

        <button class="glass-btn-primary w-100 justify-content-center py-2 fs-6" @onclick="HandleLogin" disabled="@IsLoading" style="border-radius: 12px; height: 46px;">
            @if (IsLoading)
            {
                <span class="spinner-border spinner-border-sm me-2"></span>
                <span>Signing In...</span>
            }
            else
            {
                <i class="bi bi-box-arrow-in-right me-2"></i>
                <span>Sign In Workspace</span>
            }
        </button>
    }
    else
    {
        <!-- ========================================== -->
        <!-- TAB 2: MOBILE & OTP LOGIN                  -->
        <!-- ========================================== -->
        @if (!OtpSent)
        {
            <!-- Step 1: Enter Mobile Number -->
            <div class="mb-3">
                <label class="form-label d-flex align-items-center gap-1 mb-2" style="font-size: 0.86rem; font-weight: 600; color: #f1f5f9; letter-spacing: 0.3px;">
                    <i class="bi bi-phone-fill text-info" style="font-size: 0.95rem;"></i>
                    <span>Registered Mobile Number</span>
                </label>
                <div class="input-group">
                    <span class="input-group-text border-0 px-3 fw-bold" style="background: rgba(15, 23, 42, 0.85); color: #00f2fe; border-radius: 12px 0 0 12px; border: 1px solid rgba(255, 255, 255, 0.12); border-right: none; font-size: 0.95rem;">
                        🇮🇳 +91
                    </span>
                    <input type="tel" maxlength="10" class="glass-input @(!string.IsNullOrEmpty(MobileValidationError) ? "border-danger" : "")" style="border-radius: 0 12px 12px 0 !important; font-size: 1.05rem; letter-spacing: 1px;" 
                           @bind="MobileNumber" @bind:event="oninput" @onkeyup="HandleMobileKeyUp" placeholder="10-digit mobile number" autocomplete="off" />
                </div>
                @if (!string.IsNullOrEmpty(MobileValidationError))
                {
                    <div class="text-danger small mt-1 d-flex align-items-center gap-1" style="font-size: 0.8rem; font-weight: 500;">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <span>@MobileValidationError</span>
                    </div>
                }

            </div>

            <button class="glass-btn-primary w-100 justify-content-center py-2 fs-6 mb-3" @onclick="HandleSendOtp" disabled="@IsSendingOtp" style="border-radius: 12px; height: 46px;">
                @if (IsSendingOtp)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>Sending Real OTP via SMS...</span>
                }
                else
                {
                    <i class="bi bi-chat-left-dots-fill me-2"></i>
                    <span>Get Login OTP via SMS</span>
                }
            </button>
        }
        else
        {
            <!-- Step 2: Enter & Verify OTP -->
            <div class="alert p-3 mb-3 d-flex align-items-center justify-content-between" style="background: rgba(0, 242, 254, 0.08); border: 1px solid rgba(0, 242, 254, 0.3); border-radius: 12px; color: #e0f2fe;">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill text-info fs-5 flex-shrink-0"></i>
                    <div>
                        <div class="small fw-semibold">OTP Sent to @MaskedPhone</div>
                        <div class="text-secondary" style="font-size: 0.75rem;">Enter the 6-digit verification code sent via SMS</div>
                    </div>
                </div>
                <button type="button" class="btn btn-sm btn-link text-info text-decoration-none p-0 fw-semibold" @onclick="ResetOtpState" title="Change Mobile Number">
                    Change
                </button>
            </div>

            <div class="mb-3">
                <div class="mb-2">
                    <label class="form-label d-flex align-items-center gap-1 mb-0" style="font-size: 0.86rem; font-weight: 600; color: #f1f5f9;">
                        <i class="bi bi-key-fill text-info"></i>
                        <span>Enter 6-Digit OTP</span>
                    </label>
                </div>
                <div class="position-relative">
                    <input type="text" maxlength="6" class="glass-input text-center fw-bold fs-3 @(!string.IsNullOrEmpty(OtpValidationError) ? "border-danger" : "")" 
                           style="letter-spacing: 12px; height: 52px; color: #00f2fe;" 
                           @bind="EnteredOtp" @bind:event="oninput" @onkeyup="HandleOtpKeyUp" placeholder="······" autocomplete="one-time-code" />
                </div>
                @if (!string.IsNullOrEmpty(OtpValidationError))
                {
                    <div class="text-danger small mt-2 text-center d-flex align-items-center justify-content-center gap-1" style="font-size: 0.82rem; font-weight: 500;">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <span>@OtpValidationError</span>
                    </div>
                }
            </div>

            <div class="d-flex align-items-center justify-content-between mb-3" style="font-size: 0.84rem;">
                <span class="text-secondary">
                    @if (CountdownSeconds > 0)
                    {
                        <span><i class="bi bi-clock me-1 text-info"></i>Resend OTP in <strong class="text-info">@(CountdownSeconds)s</strong></span>
                    }
                    else
                    {
                        <button type="button" class="btn btn-link p-0 text-info text-decoration-none fw-semibold" @onclick="HandleSendOtp" disabled="@IsSendingOtp">
                            <i class="bi bi-arrow-clockwise me-1"></i>Resend OTP
                        </button>
                    }
                </span>
            </div>

            <button class="glass-btn-primary w-100 justify-content-center py-2 fs-6 mb-3" @onclick="HandleVerifyOtp" disabled="@IsVerifyingOtp" style="border-radius: 12px; height: 46px;">
                @if (IsVerifyingOtp)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>Validating OTP &amp; Signing In...</span>
                }
                else
                {
                    <i class="bi bi-check2-circle me-2 fs-5"></i>
                    <span>Verify OTP &amp; Sign In</span>
                }
            </button>
        }
    }

    <!-- Footer: Doctor Registration Link -->
    <div class="mt-4 pt-3 text-center border-top" style="border-color: rgba(255, 255, 255, 0.12) !important;">
        <span style="color: #94a3b8; font-size: 0.88rem;">New specialist doctor joining CYH?</span>
        <button type="button" class="btn btn-link p-0 ms-1 fw-bold text-decoration-none" style="color: #00f2fe; font-size: 0.9rem;" @onclick="OpenRegisterModal">
            <i class="bi bi-person-plus-fill me-1"></i>Doctor Registration
        </button>
    </div>
</div>

<!-- ================================================================================== -->
<!-- Doctor Registration Popup Modal (pending admin approval)                            -->
<!-- ================================================================================== -->
@if (ShowRegisterModal)
{
    <div class="modal-backdrop fade show" style="background-color: rgba(3, 7, 18, 0.88); backdrop-filter: blur(8px); z-index: 1050;"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index: 1055; overflow-y: auto;">
        <div class="modal-dialog modal-dialog-centered modal-lg my-4">
            <div class="modal-content text-white" style="background: #091226; border: 1px solid rgba(0, 242, 254, 0.35); border-radius: 18px; box-shadow: 0 25px 60px rgba(0, 0, 0, 0.85), 0 0 35px rgba(0, 242, 254, 0.2);">
                <!-- Modal Header -->
                <div class="modal-header border-bottom d-flex align-items-center justify-content-between p-4" style="border-color: rgba(255, 255, 255, 0.1) !important; background: rgba(0, 242, 254, 0.04);">
                    <div class="d-flex align-items-center gap-3">
                        <div style="width: 44px; height: 44px; border-radius: 12px; background: linear-gradient(135deg, #00f2fe, #4facfe); color: #070d1e; display: flex; align-items: center; justify-content: center; font-size: 1.35rem; font-weight: bold;">
                            <i class="bi bi-person-vcard-fill"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold text-white mb-0">Specialist Doctor Registration</h5>
                            <span class="small" style="color: #94a3b8;">Join CYH Medical Specialist Network</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseRegisterModal" aria-label="Close"></button>
                </div>

                <!-- Status Banner: Inactive / Pending Approval Notice -->
                <div class="px-4 pt-3">
                    <div class="alert mb-0 d-flex align-items-start gap-2 p-3" style="background: rgba(245, 158, 11, 0.12); border: 1px solid rgba(245, 158, 11, 0.35); border-radius: 12px; color: #fbbf24;">
                        <i class="bi bi-shield-exclamation fs-5 flex-shrink-0 mt-1"></i>
                        <div class="small">
                            <strong style="color: #fde047;">Approval Required Notice:</strong>
                            Upon registration, your doctor profile is created in an <strong style="color: #ffffff;">INACTIVE (Pending Approval)</strong> state.
                            After submission, you can log in to view and complete your <strong style="color: #ffffff;">Profile</strong>. All other workspace tools will unlock once the <strong style="color: #ffffff;">Admin</strong> activates your account.
                        </div>
                    </div>
                </div>

                <!-- Modal Body: Registration Form -->
                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(RegisterErrorMessage))
                    {
                        <div class="alert alert-danger py-2 px-3 small d-flex align-items-center gap-2 mb-3" style="background: rgba(244, 63, 94, 0.15); border: 1px solid rgba(244, 63, 94, 0.35); color: #fda4af; border-radius: 10px;">
                            <i class="bi bi-exclamation-octagon-fill fs-6 flex-shrink-0"></i>
                            <span>@RegisterErrorMessage</span>
                        </div>
                    }

                    <div class="row g-3">
                        <!-- Full Name -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-light mb-1">
                                Full Name <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="glass-input" @bind="RegModel.FullName" placeholder="e.g. Dr. Rajesh Kumar" />
                        </div>

                        <!-- Specialization -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-light mb-1">
                                Medical Specialization <span class="text-danger">*</span>
                            </label>
                            <select class="glass-input" @bind="RegModel.Specialization" style="background: #0f1c3f; color: #ffffff;">
                                <option value="Cardiology">Cardiology &amp; Heart Care</option>
                                <option value="Neurology">Neurology &amp; Brain</option>
                                <option value="Orthopedics">Orthopedics &amp; Joint Surgery</option>
                                <option value="Pediatrics">Pediatrics &amp; Child Health</option>
                                <option value="Gynecology">Gynecology &amp; Obstetrics</option>
                                <option value="Dermatology">Dermatology &amp; Cosmetology</option>
                                <option value="Ophthalmology">Ophthalmology &amp; Eye Care</option>
                                <option value="General Medicine">General Medicine &amp; Diabetology</option>
                                <option value="Gastroenterology">Gastroenterology</option>
                                <option value="ENT">ENT (Ear, Nose, Throat)</option>
                                <option value="Pulmonology">Pulmonology &amp; Chest</option>
                                <option value="Oncology">Oncology &amp; Cancer Care</option>
                            </select>
                        </div>

                        <!-- Email -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-light mb-1">
                                Official / Login Email <span class="text-danger">*</span>
                            </label>
                            <input type="email" class="glass-input" @bind="RegModel.Email" placeholder="doctor@hospital.com" />
                        </div>

                        <!-- Phone Number -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-light mb-1 d-flex justify-content-between">
                                <span>Mobile / WhatsApp (10 Digits) <span class="text-danger">*</span></span>
                                <span class="text-info" style="font-size: 0.75rem;">10 digits only</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text border-0 px-2 fw-semibold" style="background: rgba(15, 23, 42, 0.85); color: #00f2fe; border-radius: 10px 0 0 10px; border: 1px solid rgba(255, 255, 255, 0.12); border-right: none; font-size: 0.88rem;">
                                    ðŸ‡®ðŸ‡³ +91
                                </span>
                                <input type="tel" maxlength="10" class="glass-input" style="border-radius: 0 10px 10px 0 !important;" 
                                       @bind="RegModel.PhoneNumber" @bind:event="oninput" placeholder="10-digit mobile number" />
                            </div>
                        </div>

                        <!-- Medical License Number -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-light mb-1">
                                Medical Registration / License No. <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="glass-input" @bind="RegModel.LicenseNumber" placeholder="e.g. MCI-2018-98421" />
                        </div>

                        <!-- Experience Years -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-light mb-1">
                                Years of Experience
                            </label>
                            <input type="number" min="0" max="60" class="glass-input" @bind="RegModel.ExperienceYears" />
                        </div>

                        <!-- Consultation Fee -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-light mb-1">
                                Consultation Fee (₹)
                            </label>
                            <input type="number" step="50" min="0" class="glass-input" @bind="RegModel.ConsultationFee" />
                        </div>

                        <!-- Available Days -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-light mb-1">
                                Available Days
                            </label>
                            <input type="text" class="glass-input" @bind="RegModel.AvailableDays" placeholder="e.g. Mon - Sat" />
                        </div>

                        <!-- Available Hours -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-light mb-1">
                                Available Hours
                            </label>
                            <input type="text" class="glass-input" @bind="RegModel.AvailableHours" placeholder="e.g. 09:00 AM - 05:00 PM" />
                        </div>

                        <!-- Password -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-light mb-1">
                                Account Password <span class="text-danger">*</span>
                            </label>
                            <input type="password" class="glass-input" @bind="RegModel.Password" placeholder="Min 6 characters" />
                        </div>

                        <!-- Confirm Password -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-light mb-1">
                                Confirm Password <span class="text-danger">*</span>
                            </label>
                            <input type="password" class="glass-input" @bind="RegModel.ConfirmPassword" placeholder="Re-enter password" />
                        </div>

                        <!-- Bio / Summary -->
                        <div class="col-12">
                            <label class="form-label small fw-semibold text-light mb-1">
                                Professional Summary / Clinical Bio
                            </label>
                            <textarea class="glass-input" rows="2" @bind="RegModel.Bio" placeholder="Brief about your clinical specialties, degrees, and hospital attachments..."></textarea>
                        </div>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="modal-footer border-top p-3 d-flex justify-content-between" style="border-color: rgba(255, 255, 255, 0.1) !important; background: rgba(0, 242, 254, 0.02);">
                    <button type="button" class="glass-btn-secondary" @onclick="CloseRegisterModal" disabled="@IsRegistering">
                        Cancel
                    </button>
                    <button type="button" class="glass-btn-primary" @onclick="HandleDoctorRegistration" disabled="@IsRegistering" style="background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%); color: #070d1e; font-weight: 700;">
                        @if (IsRegistering)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Registering...</span>
                        }
                        else
                        {
                            <i class="bi bi-send-check-fill me-1"></i>
                            <span>Submit Registration (Pending Approval)</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Floating Toast Notification Popup -->
<ToastPopup Notification="ActivePopup" OnDismiss="DismissPopup" />

@code {
    private string LoginMode = "email"; // "email" or "mobile"

    // Email Mode State
    private string Email = "";
    private string Password = "";
    private bool ShowPassword = false;
    private string? ErrorMessage;
    private bool IsLoading;

    // Mobile OTP Mode State
    private string MobileNumber = "";
    private string EnteredOtp = "";
    private string? MaskedPhone;
    private bool OtpSent = false;
    private bool IsSendingOtp = false;
    private bool IsVerifyingOtp = false;
    private int CountdownSeconds = 0;
    private System.Threading.Timer? countdownTimer;
    private string? MobileValidationError;
    private string? OtpValidationError;

    // Doctor Registration Modal state
    private bool ShowRegisterModal = false;
    private bool IsRegistering = false;
    private string? RegisterErrorMessage;
    private DoctorRegistrationDTO RegModel = new();

    // Floating Popup
    private ToastNotificationDTO? ActivePopup;
    private CancellationTokenSource? popupCts;

    private void SetLoginMode(string mode)
    {
        LoginMode = mode;
        ErrorMessage = null;
        MobileValidationError = null;
        OtpValidationError = null;
    }



    private void ResetOtpState()
    {
        OtpSent = false;
        EnteredOtp = "";
        CountdownSeconds = 0;
        countdownTimer?.Dispose();
        countdownTimer = null;
        ErrorMessage = null;
        MobileValidationError = null;
        OtpValidationError = null;
    }

    private async Task HandleSendOtp()
    {
        ErrorMessage = null;
        MobileValidationError = null;

        if (string.IsNullOrWhiteSpace(MobileNumber))
        {
            ErrorMessage = "Please enter your 10-digit mobile number.";
            MobileValidationError = "Mobile number is required.";
            ShowPopup("Mobile Required", ErrorMessage, "error");
            return;
        }

        var cleaned = new string(MobileNumber.Where(char.IsDigit).ToArray());
        if (cleaned.Length != 10)
        {
            ErrorMessage = "Please enter a valid 10-digit mobile number.";
            MobileValidationError = "Exact 10 digits required.";
            ShowPopup("Invalid Mobile", ErrorMessage, "error");
            return;
        }

        if (!System.Text.RegularExpressions.Regex.IsMatch(cleaned, @"^[6-9]\d{9}$"))
        {
            ErrorMessage = "Mobile number must start with 6, 7, 8, or 9.";
            MobileValidationError = "Must start with 6, 7, 8, or 9.";
            ShowPopup("Invalid Mobile", ErrorMessage, "error");
            return;
        }

        IsSendingOtp = true;
        try
        {
            var result = await OtpService.SendOtpAsync(cleaned);
            if (result.Success)
            {
                OtpSent = true;
                MaskedPhone = result.MaskedPhone;
                EnteredOtp = "";
                OtpValidationError = null;
                StartCountdown(60);
                ShowPopup("OTP Sent Successfully", result.Message ?? "OTP sent to your registered mobile number.", "save");
            }
            else
            {
                ErrorMessage = result.ErrorMessage ?? "Failed to send OTP. Please check the number.";
                MobileValidationError = ErrorMessage;
                ShowPopup("OTP Error", ErrorMessage, "error");
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
            MobileValidationError = ex.Message;
            ShowPopup("OTP Error", ex.Message, "error");
        }
        finally
        {
            IsSendingOtp = false;
        }
    }

    private async Task HandleVerifyOtp()
    {
        ErrorMessage = null;
        OtpValidationError = null;

        if (string.IsNullOrWhiteSpace(EnteredOtp))
        {
            ErrorMessage = "Please enter the 6-digit OTP code. OTP cannot be blank.";
            OtpValidationError = "OTP code is required.";
            ShowPopup("OTP Required", ErrorMessage, "error");
            return;
        }

        var cleanedOtp = new string(EnteredOtp.Where(char.IsDigit).ToArray());
        if (cleanedOtp.Length != 6)
        {
            ErrorMessage = "Please enter a valid 6-digit OTP code.";
            OtpValidationError = "Exact 6 digits required.";
            ShowPopup("Invalid OTP", ErrorMessage, "error");
            return;
        }

        IsVerifyingOtp = true;
        try
        {
            var result = await AuthService.LoginWithPhoneOtpAsync(MobileNumber, cleanedOtp);
            if (result.Success && result.User != null)
            {
                countdownTimer?.Dispose();
                countdownTimer = null;

                NavigateUserAfterLogin(result.User);
            }
            else
            {
                ErrorMessage = result.ErrorMessage ?? "Invalid or expired OTP. Please enter valid OTP.";
                OtpValidationError = ErrorMessage;
                ShowPopup("Verification Failed", ErrorMessage, "error");
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
            OtpValidationError = ex.Message;
            ShowPopup("Login Error", ex.Message, "error");
        }
        finally
        {
            IsVerifyingOtp = false;
        }
    }

    private void StartCountdown(int seconds)
    {
        CountdownSeconds = seconds;
        countdownTimer?.Dispose();
        countdownTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() =>
            {
                if (CountdownSeconds > 0)
                {
                    CountdownSeconds--;
                    StateHasChanged();
                }
                else
                {
                    countdownTimer?.Dispose();
                    countdownTimer = null;
                    StateHasChanged();
                }
            });
        }, null, 1000, 1000);
    }

