@page "/"
@page "/login"
@layout AuthLayout
@implements IDisposable
@inject IAuthService AuthService
@inject IDoctorRepository DoctorRepo
@inject NavigationManager NavigationManager

<div class="glass-panel p-3 p-sm-4 p-md-5 position-relative overflow-hidden" style="border: 1px solid rgba(255, 255, 255, 0.12); box-shadow: 0 20px 50px rgba(0, 0, 0, 0.65), 0 0 35px rgba(0, 242, 254, 0.15);">
    <div class="position-absolute top-0 start-0 w-100" style="height: 3px; background: linear-gradient(90deg, #00f2fe, #4facfe, #8b5cf6);"></div>

    <div class="text-center mb-4">
        <div class="cyh-brand-logo mx-auto mb-3" style="width: 58px; height: 58px; font-size: 1.8rem; border-radius: 14px; box-shadow: 0 0 25px rgba(0, 242, 254, 0.5);">
            <i class="bi bi-heart-pulse-fill"></i>
        </div>
        <h2 class="fw-bold mb-1 text-white" style="letter-spacing: -0.5px;">CYH Doctor Portal</h2>
        <div class="small text-secondary">Hospital &amp; Clinical Brand Workspace</div>
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger py-2 px-3 small d-flex align-items-center gap-2 mb-3" style="background: rgba(244, 63, 94, 0.15); border: 1px solid rgba(244, 63, 94, 0.35); color: #fda4af; border-radius: 10px;">
            <i class="bi bi-exclamation-octagon-fill fs-6"></i>
            <span>@ErrorMessage</span>
        </div>
    }

    <div class="mb-3">
        <label class="form-label d-flex align-items-center gap-1 mb-2" style="font-size: 0.86rem; font-weight: 600; color: #f1f5f9; letter-spacing: 0.3px;">
            <i class="bi bi-envelope-fill text-info" style="font-size: 0.95rem;"></i>
            <span>Email Address</span>
        </label>
        <div class="position-relative">
            <i class="bi bi-envelope position-absolute" style="left: 14px; top: 50%; transform: translateY(-50%); font-size: 1rem; color: #38bdf8;"></i>
            <input type="email" class="glass-input" style="padding-left: 2.6rem;" @bind="Email" placeholder="Enter your email address" autocomplete="off" />
        </div>
    </div>

    <div class="mb-3">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <label class="form-label d-flex align-items-center gap-1 mb-0" style="font-size: 0.86rem; font-weight: 600; color: #f1f5f9; letter-spacing: 0.3px;">
                <i class="bi bi-shield-lock-fill text-info" style="font-size: 0.95rem;"></i>
                <span>Password</span>
            </label>
        </div>
        <div class="position-relative">
            <i class="bi bi-lock position-absolute" style="left: 14px; top: 50%; transform: translateY(-50%); font-size: 1rem; color: #38bdf8;"></i>
            <input type="@(ShowPassword ? "text" : "password")" class="glass-input" style="padding-left: 2.6rem; padding-right: 2.75rem;" @bind="Password" placeholder="Enter your password" @onkeyup="HandleKeyUp" autocomplete="off" />
            <button type="button" 
                    class="btn position-absolute p-0 border-0" 
                    style="right: 14px; top: 50%; transform: translateY(-50%); color: #00f2fe; background: transparent; z-index: 10; display: flex; align-items: center; justify-content: center; cursor: pointer; width: 30px; height: 30px; border-radius: 6px; transition: all 0.2s ease;"
                    title="@(ShowPassword ? "Hide password" : "Show password")"
                    @onclick="TogglePasswordVisibility">
                @if (ShowPassword)
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="#00f2fe" viewBox="0 0 16 16">
                        <path d="m10.79 12.912-1.614-1.615a3.5 3.5 0 0 1-4.474-4.474l-2.06-2.06C.938 6.278 0 8 0 8s3 5.5 8 5.5a7 7 0 0 0 2.79-.588M5.21 3.088A7 7 0 0 1 8 2.5c5 0 8 5.5 8 5.5s-.939 1.721-2.641 3.238l-2.062-2.062a3.5 3.5 0 0 0-4.474-4.474z"/>
                        <path d="M5.525 7.646a2.5 2.5 0 0 0 2.829 2.829zm4.95.708-2.829-2.83a2.5 2.5 0 0 1 2.829 2.829zm3.171 5.95L1.354 1.96 2.06 1.253l12.354 12.354z"/>
                    </svg>
                }
                else
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="#00f2fe" viewBox="0 0 16 16">
                        <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
                        <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
                    </svg>
                }
            </button>
        </div>
    </div>

    <div class="d-flex align-items-center justify-content-between mb-4" style="font-size: 0.88rem;">
        <label class="d-flex align-items-center gap-2 mb-0" style="cursor: pointer; color: #e2e8f0; font-weight: 500;">
            <input type="checkbox" class="form-check-input bg-dark border-secondary" checked />
            <span>Keep me signed in</span>
        </label>
        <a href="javascript:void(0)" class="text-decoration-none" style="color: #00f2fe; font-weight: 600;">Need Help?</a>
    </div>

    <button class="glass-btn-primary w-100 justify-content-center py-2 fs-6" @onclick="HandleLogin" disabled="@IsLoading" style="border-radius: 12px; height: 46px;">
        @if (IsLoading)
        {
            <span class="spinner-border spinner-border-sm me-2"></span>
            <span>Signing In...</span>
        }
        else
        {
            <i class="bi bi-box-arrow-in-right me-2"></i>
            <span>Sign In Workspace</span>
        }
    </button>

    <!-- Footer: Doctor Registration Link -->
    <div class="mt-4 pt-3 text-center border-top" style="border-color: rgba(255, 255, 255, 0.12) !important;">
        <span style="color: #94a3b8; font-size: 0.88rem;">New specialist doctor joining CYH?</span>
        <button type="button" class="btn btn-link p-0 ms-1 fw-bold text-decoration-none" style="color: #00f2fe; font-size: 0.9rem;" @onclick="OpenRegisterModal">
            <i class="bi bi-person-plus-fill me-1"></i>Doctor Registration
        </button>
    </div>
</div>

<!-- ================================================================================== -->
<!-- Doctor Registration Popup Modal (par active nahi hoga - pending admin approval) -->
<!-- ================================================================================== -->
@if (ShowRegisterModal)
{
    <div class="modal-backdrop fade show" style="background-color: rgba(3, 7, 18, 0.88); backdrop-filter: blur(8px); z-index: 1050;"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index: 1055; overflow-y: auto;">
        <div class="modal-dialog modal-dialog-centered modal-lg my-4">
            <div class="modal-content text-white" style="background: #091226; border: 1px solid rgba(0, 242, 254, 0.35); border-radius: 18px; box-shadow: 0 25px 60px rgba(0, 0, 0, 0.85), 0 0 35px rgba(0, 242, 254, 0.2);">
                <!-- Modal Header -->
                <div class="modal-header border-bottom d-flex align-items-center justify-content-between p-4" style="border-color: rgba(255, 255, 255, 0.1) !important; background: rgba(0, 242, 254, 0.04);">
                    <div class="d-flex align-items-center gap-3">
                        <div style="width: 44px; height: 44px; border-radius: 12px; background: linear-gradient(135deg, #00f2fe, #4facfe); color: #070d1e; display: flex; align-items: center; justify-content: center; font-size: 1.35rem; font-weight: bold;">
                            <i class="bi bi-person-vcard-fill"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold text-white mb-0">Specialist Doctor Registration</h5>
                            <span class="small" style="color: #94a3b8;">Join CYH DoctorHub Medical Specialist Network</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseRegisterModal" aria-label="Close"></button>
                </div>

                <!-- Status Banner: Inactive / Pending Approval Notice -->
                <div class="px-4 pt-3">
                    <div class="alert mb-0 d-flex align-items-start gap-2 p-3" style="background: rgba(245, 158, 11, 0.12); border: 1px solid rgba(245, 158, 11, 0.35); border-radius: 12px; color: #fbbf24;">
                        <i class="bi bi-shield-exclamation fs-5 flex-shrink-0 mt-1"></i>
                        <div class="small">
                            <strong style="color: #fde047;">Approval Required Notice:</strong>
                            Upon registration, your doctor profile is created in an <strong style="color: #ffffff;">INACTIVE (Pending Approval)</strong> state.
                            After submission, you can log in to view and complete your <strong style="color: #ffffff;">Profile</strong>. All other workspace tools (AI Banner Studio, OPD Schedule, Colleagues) will unlock once the <strong style="color: #ffffff;">Hospital Admin</strong> activates your account.
                        </div>
                    </div>
                </div>

                <!-- Modal Body: Registration Form -->
                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(RegisterErrorMessage))
                    {
                        <div class="alert alert-danger py-2 px-3 small d-flex align-items-center gap-2 mb-3" style="background: rgba(244, 63, 94, 0.15); border: 1px solid rgba(244, 63, 94, 0.35); color: #fda4af; border-radius: 10px;">
                            <i class="bi bi-exclamation-octagon-fill fs-6"></i>
                            <span>@RegisterErrorMessage</span>
                        </div>
                    }

                    <div class="row g-3">
                        <!-- Full Name -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-light mb-1">
                                <i class="bi bi-person-fill text-info me-1"></i>Full Name (with Dr. prefix) *
                            </label>
                            <input type="text" class="glass-input" @bind="RegModel.FullName" placeholder="Dr. Rajesh Kumar" />
                        </div>

                        <!-- Email -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-light mb-1">
                                <i class="bi bi-envelope-fill text-info me-1"></i>Official / Login Email *
                            </label>
                            <input type="email" class="glass-input" @bind="RegModel.Email" placeholder="dr.rajesh@cyhdoctorhub.com" />
                        </div>

                        <!-- Password -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-light mb-1">
                                <i class="bi bi-lock-fill text-info me-1"></i>Password * (Min 6 chars)
                            </label>
                            <input type="password" class="glass-input" @bind="RegModel.Password" placeholder="••••••••" />
                        </div>

                        <!-- Confirm Password -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-light mb-1">
                                <i class="bi bi-check2-circle text-info me-1"></i>Confirm Password *
                            </label>
                            <input type="password" class="glass-input" @bind="RegModel.ConfirmPassword" placeholder="••••••••" />
                        </div>

                        <!-- Mobile Number -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-light mb-1">
                                <i class="bi bi-telephone-fill text-info me-1"></i>Mobile Number *
                            </label>
                            <input type="tel" class="glass-input" @bind="RegModel.PhoneNumber" placeholder="+91 98765 43210" />
                        </div>

                        <!-- Specialization -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-light mb-1">
                                <i class="bi bi-hospital-fill text-info me-1"></i>Specialization / Department *
                            </label>
                            <select class="glass-input" @bind="RegModel.Specialization" style="background: #0f172a; color: #f1f5f9;">
                                <option value="Cardiology">Cardiology / Cardiologist</option>
                                <option value="Neurology">Neurology / Neurologist</option>
                                <option value="General Medicine">General Medicine / Physician</option>
                                <option value="Pediatrics">Pediatrics / Child Specialist</option>
                                <option value="Orthopedics">Orthopedics / Bone Specialist</option>
                                <option value="Dermatology">Dermatology / Skin Care</option>
                                <option value="Gynecology & Obstetrics">Gynecology &amp; Obstetrics</option>
                                <option value="ENT Specialist">ENT (Ear, Nose &amp; Throat)</option>
                                <option value="Ophthalmology">Ophthalmology / Eye Care</option>
                                <option value="Oncology">Oncology / Cancer Care</option>
                                <option value="Psychiatry">Psychiatry / Mental Health</option>
                                <option value="General Surgery">General &amp; Laparoscopic Surgery</option>
                                <option value="Dental Surgery">Dental Surgery / Dentist</option>
                                <option value="Radiology">Radiology &amp; Imaging</option>
                            </select>
                        </div>

                        <!-- License Number -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-light mb-1">
                                <i class="bi bi-card-heading text-info me-1"></i>Medical Registration / License No. *
                            </label>
                            <input type="text" class="glass-input" @bind="RegModel.LicenseNumber" placeholder="MCI-DEL-2024-5412" />
                        </div>

                        <!-- Experience Years -->
                        <div class="col-12 col-md-3">
                            <label class="form-label small fw-semibold text-light mb-1">
                                <i class="bi bi-award-fill text-info me-1"></i>Experience (Years)
                            </label>
                            <input type="number" class="glass-input" @bind="RegModel.ExperienceYears" min="0" max="60" />
                        </div>

                        <!-- Consultation Fee -->
                        <div class="col-12 col-md-3">
                            <label class="form-label small fw-semibold text-light mb-1">
                                <i class="bi bi-currency-rupee text-info me-1"></i>Consultation Fee (₹)
                            </label>
                            <input type="number" class="glass-input" @bind="RegModel.ConsultationFee" min="0" step="50" />
                        </div>

                        <!-- Available Days -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-light mb-1">
                                <i class="bi bi-calendar-week-fill text-info me-1"></i>Available Days
                            </label>
                            <input type="text" class="glass-input" @bind="RegModel.AvailableDays" placeholder="Mon - Sat" />
                        </div>

                        <!-- Available Hours -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-light mb-1">
                                <i class="bi bi-clock-fill text-info me-1"></i>Available Hours
                            </label>
                            <input type="text" class="glass-input" @bind="RegModel.AvailableHours" placeholder="09:00 AM - 05:00 PM" />
                        </div>

                        <!-- Bio -->
                        <div class="col-12">
                            <label class="form-label small fw-semibold text-light mb-1">
                                <i class="bi bi-card-text text-info me-1"></i>Brief Professional Bio
                            </label>
                            <textarea class="glass-input" rows="2" @bind="RegModel.Bio" placeholder="Specializing in advanced patient care, diagnosis, and preventive treatment..."></textarea>
                        </div>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="modal-footer border-top p-3 d-flex justify-content-between" style="border-color: rgba(255, 255, 255, 0.1) !important; background: rgba(0, 242, 254, 0.02);">
                    <button type="button" class="glass-btn-secondary" @onclick="CloseRegisterModal" disabled="@IsRegistering">
                        Cancel
                    </button>
                    <button type="button" class="glass-btn-primary" @onclick="HandleDoctorRegistration" disabled="@IsRegistering" style="background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%); color: #070d1e; font-weight: 700;">
                        @if (IsRegistering)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Registering...</span>
                        }
                        else
                        {
                            <i class="bi bi-send-check-fill me-1"></i>
                            <span>Submit Registration (Pending Approval)</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Floating Toast Notification Popup -->
<ToastPopup Notification="ActivePopup" OnDismiss="DismissPopup" />

@code {
    private string Email = "";
    private string Password = "";
    private bool ShowPassword = false;
    private string? ErrorMessage;
    private bool IsLoading;

    // Doctor Registration Modal state
    private bool ShowRegisterModal = false;
    private bool IsRegistering = false;
    private string? RegisterErrorMessage;
    private DoctorRegistrationDTO RegModel = new();

    // Floating Popup
    private ToastNotificationDTO? ActivePopup;
    private CancellationTokenSource? popupCts;

    private void TogglePasswordVisibility()
    {
        ShowPassword = !ShowPassword;
    }

    private void OpenRegisterModal()
    {
        RegModel = new DoctorRegistrationDTO
        {
            FullName = "Dr. ",
            Specialization = "Cardiology",
            AvailableDays = "Mon - Sat",
            AvailableHours = "09:00 AM - 05:00 PM",
            ExperienceYears = 5,
            ConsultationFee = 500m
        };
        RegisterErrorMessage = null;
        ShowRegisterModal = true;
    }

    private void CloseRegisterModal()
    {
        ShowRegisterModal = false;
        RegisterErrorMessage = null;
    }

    private async Task HandleDoctorRegistration()
    {
        RegisterErrorMessage = null;

        // Validation
        if (string.IsNullOrWhiteSpace(RegModel.FullName) || RegModel.FullName.Trim() == "Dr." || RegModel.FullName.Trim() == "Dr")
        {
            RegisterErrorMessage = "Please enter the doctor's full name (e.g. Dr. Rajesh Kumar).";
            ShowPopup("Validation Error", RegisterErrorMessage, "error");
            return;
        }

        if (string.IsNullOrWhiteSpace(RegModel.Email) || !RegModel.Email.Contains("@"))
        {
            RegisterErrorMessage = "Please enter a valid official/login email address.";
            ShowPopup("Invalid Email", RegisterErrorMessage, "error");
            return;
        }

        if (string.IsNullOrWhiteSpace(RegModel.Password) || RegModel.Password.Length < 6)
        {
            RegisterErrorMessage = "Password must be at least 6 characters.";
            ShowPopup("Weak Password", RegisterErrorMessage, "warning");
            return;
        }

        if (RegModel.Password != RegModel.ConfirmPassword)
        {
            RegisterErrorMessage = "Passwords do not match. Please re-enter.";
            ShowPopup("Password Mismatch", RegisterErrorMessage, "error");
            return;
        }

        if (string.IsNullOrWhiteSpace(RegModel.PhoneNumber))
        {
            RegisterErrorMessage = "Mobile number is required for specialist doctor contact.";
            ShowPopup("Mobile Number Required", RegisterErrorMessage, "error");
            return;
        }

        if (string.IsNullOrWhiteSpace(RegModel.LicenseNumber))
        {
            RegisterErrorMessage = "Medical License / Registration number is required.";
            ShowPopup("License Number Required", RegisterErrorMessage, "error");
            return;
        }

        IsRegistering = true;
        try
        {
            var result = await DoctorRepo.RegisterDoctorAsync(RegModel);
            if (result.Success)
            {
                var registeredEmail = RegModel.Email.Trim();
                var registeredName = RegModel.FullName.Trim();

                ShowRegisterModal = false;
                Email = registeredEmail;
                Password = "";

                ShowPopup(
                    "Registration Submitted!",
                    $"{registeredName}, your account is created in PENDING APPROVAL state. You can sign in to view your Profile. Other tools will unlock once Hospital Admin activates your account.",
                    "save"
                );
            }
            else
            {
                RegisterErrorMessage = result.ErrorMessage ?? "Registration failed. Please check the details.";
                ShowPopup("Registration Failed", RegisterErrorMessage, "error");
            }
        }
        catch (Exception ex)
        {
            RegisterErrorMessage = ex.Message;
            ShowPopup("Registration Error", ex.Message, "error");
        }
        finally
        {
            IsRegistering = false;
        }
    }

    private async Task HandleLogin()
    {
        ErrorMessage = null;
        IsLoading = true;

        try
        {
            var result = await AuthService.LoginAsync(Email, Password);
            if (result.Success && result.User != null)
            {
                if (result.User.Role == "Admin")
                {
                    NavigationManager.NavigateTo("admin/dashboard");
                }
                else
                {
                    // If doctor is NOT active: Only Profile is unlocked; navigate straight to Profile
                    if (!result.User.IsActive)
                    {
                        NavigationManager.NavigateTo("doctor/profile");
                    }
                    else
                    {
                        NavigationManager.NavigateTo("doctor/dashboard");
                    }
                }
            }
            else
            {
                ErrorMessage = result.ErrorMessage ?? "Invalid credentials. Please verify and try again.";
                ShowPopup("Login Failed", ErrorMessage, "error");
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
            ShowPopup("Login Error", ex.Message, "error");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleLogin();
        }
    }

    private void ShowPopup(string title, string message, string type = "save")
    {
        popupCts?.Cancel();
        popupCts?.Dispose();
        popupCts = new CancellationTokenSource();

        ActivePopup = new ToastNotificationDTO
        {
            Title = title,
            Message = message,
            Type = type
        };
        StateHasChanged();

        var token = popupCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(5500, token);
                if (!token.IsCancellationRequested)
                {
                    await InvokeAsync(() =>
                    {
                        ActivePopup = null;
                        StateHasChanged();
                    });
                }
            }
            catch (TaskCanceledException) { }
        }, token);
    }

    private void DismissPopup()
    {
        popupCts?.Cancel();
        ActivePopup = null;
    }
    public void Dispose()
    {
        popupCts?.Cancel();
        popupCts?.Dispose();
    }
}
