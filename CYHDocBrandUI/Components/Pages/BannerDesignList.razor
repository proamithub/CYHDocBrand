@page "/banner-designs"
@page "/doctor/banner-designs"
@page "/admin/banner-designs"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable

@using CYHDocBrandModel.DTO
@using CYHDocBrandModel.Common
@using CYHDocBrandData.Entities
@using CYHDocBrandUI.Components.Common
@using CYHDocBrandRepo.Utilities
@using CYHDocBrandRepo.IRepository

@inject IBannerRepository BannerRepo
@inject ICreditRepository CreditRepo
@inject IDoctorRepository DoctorRepo
@inject IBannerScheduleRepository ScheduleRepo
@inject IMediaPlatformRepository MediaPlatformRepo
@inject ISocialAccountRepository SocialAccountRepo
@inject IAuthService AuthService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<!-- Animated Floating Toast Popup -->
<ToastPopup Notification="activePopup" OnDismiss="DismissPopup" />

<div class="banner-list-container fade-in">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge px-3 py-2" style="background: rgba(0, 242, 254, 0.15); border: 1px solid rgba(0, 242, 254, 0.4); color: #00f2fe; border-radius: 8px; font-weight: 700;">
                    <i class="bi bi-collection-play-fill me-1"></i>
                    @(IsAdmin ? "ADMIN INSPECTION & AUDIT" : "CLINICAL BRANDING LIBRARY")
                </span>
                <span class="text-secondary" style="font-size: 0.85rem;">CYH Creative Studio</span>
            </div>
            <h2 class="mt-2 mb-1 fw-bold text-white" style="letter-spacing: -0.5px;">
                @(IsAdmin ? "Specialist Banner Designs (Doctor-Wise)" : "My Banner Designs Library")
            </h2>
            <p class="text-secondary mb-0" style="font-size: 0.92rem;">
                @(IsAdmin
                    ? "Admin Read-Only Portal: Inspect specialist banners doctor-wise. Banners are protected from modification. Deletion available."
                    : "Manage your Draft and Published banners. Published banners are locked and finalized for patient brand safety.")
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <NavLink href="@GetCreditHistoryUrl()" class="btn btn-outline-info d-flex align-items-center gap-2 px-3 py-2" style="border-radius: 10px;">
                <i class="bi bi-clock-history"></i>
                <span>Credit History</span>
            </NavLink>
            @if (!IsAdmin)
            {
                <NavLink href="@GetCreateUrl()" class="btn btn-info d-flex align-items-center gap-2 px-4 py-2 fw-bold" style="background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%); border: none; border-radius: 10px; color: #070d1e;">
                    <i class="bi bi-plus-lg fs-6"></i>
                    <span>Create New Banner</span>
                </NavLink>
            }
        </div>
    </div>

    <!-- Stat Counter Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4 col-12">
            <div class="glass-panel p-3 rounded-4 d-flex align-items-center justify-content-between" style="background: rgba(14, 25, 48, 0.65); border: 1px solid rgba(255, 255, 255, 0.08);">
                <div>
                    <div class="text-secondary" style="font-size: 0.8rem; font-weight: 600;">TOTAL BANNERS</div>
                    <h3 class="fw-bold text-white mb-0 mt-1">@banners.Count</h3>
                </div>
                <div class="stat-icon-circle bg-info bg-opacity-10 text-info">
                    <i class="bi bi-images fs-4"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-12">
            <div class="glass-panel p-3 rounded-4 d-flex align-items-center justify-content-between" style="background: rgba(14, 25, 48, 0.65); border: 1px solid rgba(255, 255, 255, 0.08);">
                <div>
                    <div class="text-warning" style="font-size: 0.8rem; font-weight: 600;">IN DRAFT</div>
                    <h3 class="fw-bold text-warning mb-0 mt-1">@banners.Count(b => b.Status == "Draft")</h3>
                </div>
                <div class="stat-icon-circle bg-warning bg-opacity-10 text-warning">
                    <i class="bi bi-pencil-square fs-4"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-12">
            <div class="glass-panel p-3 rounded-4 d-flex align-items-center justify-content-between" style="background: rgba(14, 25, 48, 0.65); border: 1px solid rgba(255, 255, 255, 0.08);">
                <div>
                    <div class="text-success" style="font-size: 0.8rem; font-weight: 600;">FINAL PUBLISHED &amp; LOCKED</div>
                    <h3 class="fw-bold text-success mb-0 mt-1">@banners.Count(b => b.Status == "Published")</h3>
                </div>
                <div class="stat-icon-circle bg-success bg-opacity-10 text-success">
                    <i class="bi bi-check2-all fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Bar & Doctor-wise Dropdown (Admin) -->
    <div class="glass-panel p-3 rounded-4 mb-4" style="background: rgba(14, 25, 48, 0.65); border: 1px solid rgba(255, 255, 255, 0.08);">
        <div class="row g-3 align-items-center">
            <!-- Filter Pills -->
            <div class="col-12 @(IsAdmin ? "col-lg-4" : "col-md-6")">
                <div class="d-flex gap-2 flex-wrap">
                    <button type="button" class="btn btn-sm px-3 py-2 rounded-3 @(currentStatusFilter == "All" ? "btn-info text-dark fw-bold" : "btn-outline-secondary text-white")" @onclick='() => SetFilter("All")'>
                        All (@banners.Count)
                    </button>
                    <button type="button" class="btn btn-sm px-3 py-2 rounded-3 @(currentStatusFilter == "Draft" ? "btn-warning text-dark fw-bold" : "btn-outline-secondary text-white")" @onclick='() => SetFilter("Draft")'>
                        Drafts (@banners.Count(b => b.Status == "Draft"))
                    </button>
                    <button type="button" class="btn btn-sm px-3 py-2 rounded-3 @(currentStatusFilter == "Published" ? "btn-success text-white fw-bold" : "btn-outline-secondary text-white")" @onclick='() => SetFilter("Published")'>
                        Published (@banners.Count(b => b.Status == "Published"))
                    </button>
                </div>
            </div>

            @if (IsAdmin)
            {
                <!-- Doctor-Wise Filter Dropdown (ADMIN ONLY) -->
                <div class="col-12 col-lg-4">
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-warning small text-nowrap fw-bold"><i class="bi bi-person-badge me-1"></i>Doctor:</span>
                        <select class="form-select bg-dark border-secondary text-white small"
                                @bind="selectedDoctorNameFilter" @bind:after="ApplySearch">
                            <option value="">All Specialists (@AvailableDoctorNames.Count)</option>
                            @foreach (var docName in AvailableDoctorNames)
                            {
                                <option value="@docName">@docName</option>
                            }
                        </select>
                    </div>
                </div>
            }

            <!-- Search input -->
            <div class="col-12 @(IsAdmin ? "col-lg-4" : "col-md-6")">
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-secondary">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" class="form-control bg-dark text-white border-secondary" placeholder="Search by heading, doctor name..." @bind="searchQuery" @bind:event="oninput" @bind:after="ApplySearch" />
                    @if (!string.IsNullOrEmpty(searchQuery))
                    {
                        <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Banners Grid -->
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-info" style="width: 3rem; height: 3rem;" role="status"></div>
            <p class="text-secondary mt-3">Loading banner designs from database...</p>
        </div>
    }
    else if (!filteredBanners.Any())
    {
        <div class="glass-panel text-center py-5 rounded-4" style="background: rgba(14, 25, 48, 0.4); border: 1px dashed rgba(255, 255, 255, 0.15);">
            <i class="bi bi-images text-secondary" style="font-size: 3.5rem;"></i>
            <h4 class="text-white mt-3 fw-bold">No Banners Found</h4>
            <p class="text-secondary mb-3" style="max-width: 450px; margin: 0 auto; font-size: 0.9rem;">
                @(string.IsNullOrEmpty(searchQuery) && string.IsNullOrEmpty(selectedDoctorNameFilter)
                    ? "Abhi koi banner available nahi hai."
                    : "Filter criteria se match karta hua koi banner nahi mila.")
            </p>
            @if (!IsAdmin)
            {
                <NavLink href="@GetCreateUrl()" class="btn btn-info px-4 py-2 fw-semibold" style="background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%); border: none; border-radius: 10px; color: #070d1e;">
                    <i class="bi bi-magic me-1"></i> Create First Banner
                </NavLink>
            }
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in filteredBanners)
            {
                <div class="col-xl-4 col-md-6 col-12">
                    <div class="glass-panel rounded-4 h-100 d-flex flex-column banner-card overflow-hidden" style="background: rgba(14, 25, 48, 0.7); border: 1px solid rgba(255, 255, 255, 0.08);">
                        <!-- Thumbnail Header with badges -->
                        <div class="banner-thumbnail-header p-3 position-relative cursor-pointer"
                             style="background: @(string.IsNullOrWhiteSpace(item.BackgroundImageUrl) ? "linear-gradient(135deg, rgba(7, 13, 30, 0.9) 0%, rgba(11, 22, 44, 0.95) 100%)" : $"linear-gradient(180deg, rgba(7, 13, 30, 0.7) 0%, rgba(11, 22, 44, 0.95) 100%), url('{item.BackgroundImageUrl}') center/cover no-repeat"); min-height: 150px; border-bottom: 1px solid rgba(255, 255, 255, 0.06); cursor: pointer;"
                             @onclick="() => OpenPhotoModal(item)" title="Click to view full photo">
                            <div class="d-flex justify-content-between align-items-start">
                                <!-- Status Badge -->
                                @if (item.Status == "Published")
                                {
                                    <span class="badge px-3 py-1 rounded-pill" style="background: rgba(16, 185, 129, 0.2); border: 1px solid rgba(16, 185, 129, 0.5); color: #10b981; font-weight: 700; font-size: 0.75rem;">
                                        <i class="bi bi-shield-lock-fill me-1"></i> PUBLISHED &amp; LOCKED
                                    </span>
                                }
                                else
                                {
                                    <span class="badge px-3 py-1 rounded-pill" style="background: rgba(245, 158, 11, 0.2); border: 1px solid rgba(245, 158, 11, 0.5); color: #fbbf24; font-weight: 700; font-size: 0.75rem;">
                                        <i class="bi bi-pencil-fill me-1"></i> DRAFT
                                    </span>
                                }

                                <div class="d-flex gap-1">
                                    <span class="badge bg-dark text-info border border-secondary" style="font-size: 0.72rem;">@item.AspectRatio</span>
                                    <span class="badge bg-dark text-secondary border border-secondary" style="font-size: 0.72rem;">@item.TemplateType</span>
                                </div>
                            </div>

                            <div class="mt-3">
                                <h5 class="fw-bold text-white text-truncate mb-1" title="@item.Heading">@item.Heading</h5>
                                <div class="text-info text-truncate fw-semibold" style="font-size: 0.85rem;">
                                    <i class="bi bi-person-fill me-1"></i> @item.DoctorName
                                </div>
                            </div>
                        </div>

                        <!-- Card Body -->
                        <div class="p-3 flex-grow-1 d-flex flex-column justify-content-between">
                            <p class="text-secondary small mb-3 text-truncate-2" style="font-size: 0.82rem; min-height: 38px;">
                                @(string.IsNullOrWhiteSpace(item.Subtitle) ? "No subtitle provided." : item.Subtitle)
                            </p>

                            <div class="d-flex align-items-center justify-content-between text-secondary pt-2 border-top border-secondary border-opacity-25" style="font-size: 0.75rem;">
                                <span><i class="bi bi-clock me-1"></i> @item.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</span>
                                <span class="badge bg-dark text-secondary">#@item.Id</span>
                            </div>
                        </div>

                        <!-- Card Footer Action Buttons -->
                        <div class="p-3 pt-0 d-flex gap-2">
                            @if (IsAdmin)
                            {
                                <!-- ADMIN CONTROLS: VIEW PHOTO + DELETE ONLY (NO EDIT / NO SAVE / NO PUBLISH) -->
                                <button type="button" class="btn btn-outline-info flex-grow-1 d-flex align-items-center justify-content-center gap-1 py-2"
                                        @onclick="() => OpenPhotoModal(item)" style="border-radius: 8px; font-size: 0.85rem; font-weight: 600;">
                                    <i class="bi bi-eye-fill"></i>
                                    <span>View Photo</span>
                                </button>

                                <button type="button" class="btn btn-outline-danger d-flex align-items-center justify-content-center px-3 py-2"
                                        @onclick="() => ConfirmDeleteBanner(item.Id, item.Heading)" title="Delete this banner permanently (Admin privilege)" style="border-radius: 8px; font-size: 0.85rem;">
                                    <i class="bi bi-trash"></i>
                                </button>
                            }
                            else
                            {
                                <!-- DOCTOR CONTROLS -->
                                @if (item.Status == "Published")
                                {
                                    <!-- PUBLISHED BANNER IS LOCKED: Cannot be edited -->
                                    <button type="button" class="btn btn-outline-success flex-grow-1 d-flex align-items-center justify-content-center gap-1 py-2"
                                            @onclick="() => OpenPhotoModal(item)" style="border-radius: 8px; font-size: 0.85rem; font-weight: 600;">
                                        <i class="bi bi-eye-fill"></i>
                                        <span>View Photo</span>
                                    </button>

                                    <!-- Schedule Post Button -->
                                    <button type="button" class="btn btn-outline-info d-flex align-items-center justify-content-center px-3 py-2"
                                            @onclick="() => OpenScheduleModal(item)" title="Schedule this banner on Facebook &amp; Instagram"
                                            style="border-radius: 8px; font-size: 0.85rem;">
                                        <i class="bi bi-calendar2-plus-fill"></i>
                                    </button>

                                    <!-- Delete is locked for Doctor on published banners -->
                                    <button type="button" class="btn btn-outline-secondary d-flex align-items-center justify-content-center px-3 py-2 disabled"
                                            disabled title="Published banner locked hai. Sirf Admin hi published banner delete kar sakta hai."
                                            style="border-radius: 8px; font-size: 0.85rem; opacity: 0.5; cursor: not-allowed; border-color: rgba(255,255,255,0.2);">
                                        <i class="bi bi-lock-fill text-warning"></i>
                                    </button>
                                }
                                else
                                {
                                    <!-- DRAFT BANNER: Doctor can Edit & Quick Publish -->
                                    <button type="button" class="btn btn-outline-info flex-grow-1 d-flex align-items-center justify-content-center gap-1 py-2"
                                            @onclick="() => EditBanner(item.Id)" style="border-radius: 8px; font-size: 0.85rem; font-weight: 600;">
                                        <i class="bi bi-pencil-square"></i>
                                        <span>Edit &amp; Customize</span>
                                    </button>

                                    <button type="button" class="btn btn-outline-success d-flex align-items-center justify-content-center gap-1 px-3 py-2"
                                            @onclick="() => QuickPublish(item.Id)" title="Publish this draft banner" style="border-radius: 8px; font-size: 0.85rem;">
                                        <i class="bi bi-send-check"></i>
                                    </button>

                                    <button type="button" class="btn btn-outline-danger d-flex align-items-center justify-content-center px-3 py-2"
                                            @onclick="() => ConfirmDeleteBanner(item.Id, item.Heading)" title="Delete draft banner" style="border-radius: 8px; font-size: 0.85rem;">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- PHOTO VIEW MODAL (अगर फोटो खोलना हो तो - FULL BRANDED COMPOSITE PREVIEW & HD DOWNLOAD) -->
    @if (viewingBanner != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0, 0, 0, 0.88); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); z-index: 1070;" @onclick="ClosePhotoModal">
            <div class="modal-dialog modal-dialog-centered modal-lg" @onclick:stopPropagation>
                <div class="modal-content text-white" style="background: #0b1426; border: 1px solid rgba(0, 242, 254, 0.35); border-radius: 18px; box-shadow: 0 20px 60px rgba(0, 0, 0, 0.7); overflow: hidden;">
                    <div class="modal-header border-secondary border-opacity-25 pb-3">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="badge @(viewingBanner.Status == "Published" ? "bg-success" : "bg-warning text-dark")">
                                    <i class="bi @(viewingBanner.Status == "Published" ? "bi-shield-lock-fill" : "bi-pencil-fill") me-1"></i>
                                    @(viewingBanner.Status == "Published" ? "FINAL PUBLISHED & LOCKED" : "DRAFT")
                                </span>
                                <span class="badge bg-secondary">@viewingBanner.AspectRatio • 1080p HD</span>
                                <span class="badge bg-secondary">@viewingBanner.TemplateType</span>
                            </div>
                            <h5 class="modal-title fw-bold text-white mb-0">@viewingBanner.Heading</h5>
                            <div class="small text-info mt-1"><i class="bi bi-person-badge me-1"></i>Specialist: <strong>@viewingBanner.DoctorName</strong></div>
                        </div>
                        <button type="button" class="btn-close btn-close-white" @onclick="ClosePhotoModal"></button>
                    </div>

                    <div class="modal-body p-4 text-center">
                        <!-- High-Res Composite Banner Canvas Preview -->
                        <div class="p-2 rounded-3 mx-auto shadow-lg position-relative overflow-hidden mb-3 d-flex align-items-center justify-content-center"
                             style="max-width: 540px; background: #050a17; border: 2px solid rgba(0, 242, 254, 0.25); min-height: 380px;">
                            
                            @if (isRenderingModalCanvas)
                            {
                                <div class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center" style="background: rgba(7, 13, 30, 0.75); z-index: 5;">
                                    <div class="spinner-border text-info mb-2" role="status"></div>
                                    <small class="text-secondary">Rendering High-Resolution Composite Banner...</small>
                                </div>
                            }

                            <canvas id="viewModalCanvas" class="shadow-lg rounded-2" style="max-width: 100%; max-height: 520px; width: auto; height: auto; object-fit: contain;"></canvas>
                        </div>

                        @if (!string.IsNullOrEmpty(viewingBanner.Subtitle))
                        {
                            <div class="p-3 rounded-2 text-start small mb-2" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
                                <span class="text-white-50 d-block mb-1 fw-bold">Subtitle / Description:</span>
                                <span class="text-light">@viewingBanner.Subtitle</span>
                            </div>
                        }

                        <div class="d-flex justify-content-between small text-white-50 pt-2 border-top border-secondary border-opacity-25">
                            <span>Banner ID: #@viewingBanner.Id</span>
                            <span>Updated: @viewingBanner.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</span>
                            @if (viewingBanner.PublishedAt.HasValue)
                            {
                                <span class="text-success"><i class="bi bi-shield-check me-1"></i>Published: @viewingBanner.PublishedAt.Value.ToLocalTime().ToString("dd MMM yyyy")</span>
                            }
                        </div>
                    </div>

                    <div class="modal-footer border-secondary border-opacity-25 justify-content-between">
                        <div>
                            @if (IsAdmin)
                            {
                                <button type="button" class="btn btn-outline-danger btn-sm"
                                        @onclick="() => { ClosePhotoModal(); ConfirmDeleteBanner(viewingBanner.Id, viewingBanner.Heading); }">
                                    <i class="bi bi-trash-fill me-1"></i> Delete Banner
                                </button>
                            }
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-warning btn-sm fw-semibold" @onclick="DownloadModalBannerPng">
                                <i class="bi bi-download me-1"></i> Download HD PNG
                            </button>
                            <button type="button" class="btn btn-outline-success btn-sm fw-semibold" @onclick="ShareModalBanner">
                                <i class="bi bi-share-fill me-1"></i> Share
                            </button>
                            <button type="button" class="btn btn-primary btn-sm fw-semibold" @onclick="OpenScheduleModalFromView" style="background: linear-gradient(135deg, #1877f2 0%, #0d6efd 100%); border: none;">
                                <i class="bi bi-calendar2-plus me-1"></i> Schedule Post
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ClosePhotoModal">Close</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    <!-- Delete Confirmation Modal -->
    @if (pendingDeleteId.HasValue)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0, 0, 0, 0.75); backdrop-filter: blur(5px); -webkit-backdrop-filter: blur(5px); z-index: 1080;">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content glass-panel" style="background: rgba(14, 25, 48, 0.95); border: 1px solid rgba(239, 68, 68, 0.4); border-radius: 16px;">
                    <div class="modal-header border-secondary border-opacity-25 pb-2">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-triangle-fill text-danger fs-4"></i>
                            <h5 class="modal-title text-white fw-bold mb-0">Confirm Banner Deletion</h5>
                        </div>
                        <button type="button" class="btn-close btn-close-white" @onclick="CancelDelete"></button>
                    </div>
                    <div class="modal-body p-4 text-center">
                        <p class="text-white fs-6 mb-2">Kya aap waqai is banner ko SQL database se delete karna chahte hain?</p>
                        <p class="text-warning fw-semibold mb-0" style="font-size: 0.9rem;">"@pendingDeleteTitle"</p>
                        <p class="text-secondary small mt-2">Ye action permanent hai aur isse undo nahi kiya ja sakta.</p>
                    </div>
                    <div class="modal-footer border-secondary border-opacity-25 justify-content-center gap-2 pt-2">
                        <button type="button" class="btn btn-outline-secondary px-4 py-2" @onclick="CancelDelete" style="border-radius: 8px;">Cancel</button>
                        <button type="button" class="btn btn-danger px-4 py-2 fw-semibold" @onclick="ExecuteDelete" style="border-radius: 8px;">
                            <i class="bi bi-trash-fill me-1"></i> Delete Permanently
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Schedule Post Modal -->
    @if (schedulingBanner != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0, 0, 0, 0.85); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); z-index: 1085;">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content glass-panel" style="background: rgba(14, 25, 48, 0.98); border: 1px solid rgba(0, 242, 254, 0.35); border-radius: 18px;">
                    <div class="modal-header border-bottom border-secondary border-opacity-25 px-4 py-3">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-broadcast-pin text-info fs-4"></i>
                            <div>
                                <h5 class="modal-title text-white fw-bold mb-0">Schedule Social Media Post</h5>
                                <span class="text-secondary small">Auto-publish this banner at a chosen date and time</span>
                            </div>
                        </div>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseScheduleModal"></button>
                    </div>

                    <div class="modal-body p-4">
                        <!-- Banner Preview Strip -->
                        <div class="d-flex align-items-center gap-3 p-3 rounded-3 mb-4 bg-dark border border-secondary border-opacity-25">
                            @if (!string.IsNullOrEmpty(schedulingBanner.BackgroundImageUrl))
                            {
                                <img src="@schedulingBanner.BackgroundImageUrl" alt="Thumbnail" class="rounded-2" style="width: 60px; height: 60px; object-fit: cover;" />
                            }
                            else
                            {
