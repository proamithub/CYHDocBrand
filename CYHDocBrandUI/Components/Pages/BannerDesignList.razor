                            }
                            <div>
                                <h6 class="text-white fw-bold mb-1">@schedulingBanner.Heading</h6>
                                <div class="text-secondary small">
                                    <i class="bi bi-hospital me-1"></i>@(schedulingBanner.HospitalName ?? "CYH Hospital") &bull;
                                    <span class="text-info">@schedulingBanner.DoctorName</span>
                                </div>
                            </div>
                        </div>
                        <!-- --- Target Platforms (Dynamic from DB) --- -->
                        <div class="mb-4">
                            <label class="form-label text-white fw-bold small mb-2 d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-share-fill me-1 text-info"></i> Target Platforms</span>
                                @if (activePlatforms.Count == 0)
                                {
                                    <span class="badge" style="background:rgba(245,158,11,0.15);border:1px solid rgba(245,158,11,0.4);color:#fbbf24;font-size:0.72rem;"><i class="bi bi-exclamation-triangle me-1"></i>Admin se platforms activate karwayein</span>
                                }
                                else
                                {
                                    <span class="badge" style="background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.4);color:#10b981;font-size:0.72rem;"><i class="bi bi-check2-circle me-1"></i>@activePlatforms.Count Platform Active</span>
                                }
                            </label>

                            @if (isLoadingPlatforms)
                            {
                                <div class="text-center py-3">
                                    <div class="spinner-border spinner-border-sm text-info"></div>
                                    <span class="text-secondary small ms-2">Platforms load ho rahe hain...</span>
                                </div>
                            }
                            else if (activePlatforms.Count == 0)
                            {
                                <div class="p-3 rounded-3 text-center" style="background:rgba(245,158,11,0.08);border:1px dashed rgba(245,158,11,0.35);">
                                    <i class="bi bi-share text-warning" style="font-size:2rem;"></i>
                                    <div class="text-warning small mt-2 fw-bold">Koi active platform nahi mila</div>
                                    <div class="text-secondary" style="font-size:0.8rem;">Admin Panel ? Media & Social API Settings se platforms activate karein.</div>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex flex-column gap-2">
                                    @foreach (var platform in activePlatforms)
                                    {
                                        var isSelected = selectedPlatforms.Contains(platform.PlatformCode);
                                        var platformCode = platform.PlatformCode;
                                        <div class="p-3 rounded-3 border d-flex align-items-center justify-content-between"
                                             style="cursor:pointer; transition:all 0.2s ease; border-color:@(isSelected ? platform.ColorHex : "rgba(255,255,255,0.1)") !important; background:@(isSelected ? $"rgba({HexToScheduleRgb(platform.ColorHex)},0.1)" : "rgba(0,0,0,0.2)");"
                                             @onclick="() => TogglePlatformSelection(platformCode)">
                                            <div class="d-flex align-items-center gap-3">
                                                <input class="form-check-input mt-0" type="checkbox"
                                                       checked="@isSelected"
                                                       @onchange="() => TogglePlatformSelection(platformCode)"
                                                       @onclick:stopPropagation="true"
                                                       style="width:1.25rem;height:1.25rem;border-color:@platform.ColorHex;" />
                                                <div>
                                                    <div class="text-white fw-bold d-flex align-items-center gap-2">
                                                        <i class="bi @platform.IconClass fs-5" style="color:@platform.ColorHex;"></i>
                                                        @platform.PlatformName
                                                        @if (!platform.AllowGlobalFallback)
                                                        {
                                                            <span class="badge" style="background:rgba(139,92,246,0.15);border:1px solid rgba(139,92,246,0.4);color:#a78bfa;font-size:0.65rem;">
                                                                <i class="bi bi-person-check-fill me-1"></i>Doctor Account Required
                                                            </span>
                                                        }
                                                        else if (platform.HasGlobalApiConfigured)
                                                        {
                                                            <span class="badge" style="background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.35);color:#10b981;font-size:0.65rem;">
                                                                <i class="bi bi-arrow-repeat me-1"></i>Global API Ready
                                                            </span>
                                                        }
                                                    </div>
                                                    <div class="text-secondary small">@platform.Category � Scheduled banner post hoga</div>
                                                </div>
                                            </div>
                                            <i class="bi @(isSelected ? "bi-check-circle-fill" : "bi-circle") fs-5" style="color:@(isSelected ? platform.ColorHex : "#64748b");"></i>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Date & Time Picker (On-Click Calendar & Clock Popup) -->
                        <div class="mb-4">
                            <label class="form-label text-white fw-bold small mb-2 d-flex align-items-center justify-content-between">
                                <span>
                                    <i class="bi bi-calendar2-event-fill me-1 text-info fs-6"></i> Schedule Date &amp; Time
                                </span>
                                <span class="badge bg-info bg-opacity-15 text-info border border-info border-opacity-30 px-2 py-1" style="font-size: 0.72rem;">
                                    Click box to open picker
                                </span>
                            </label>

                            <div class="input-group input-group-lg" style="cursor: pointer;" @onclick="OpenDatePickerPopup">
                                <span class="input-group-text bg-dark border-secondary text-info px-3" style="border-color: rgba(0, 242, 254, 0.45) !important;">
                                    <i class="bi bi-calendar-check fs-5"></i>
                                </span>
                                <input id="scheduleFlatpickrInput" type="text" 
                                       class="form-control bg-dark text-white border-secondary fw-bold px-3 py-2" 
                                       placeholder="Click karein date aur time select karne ke liye..." 
                                       style="cursor: pointer; border-color: rgba(0, 242, 254, 0.45) !important; font-size: 0.95rem;" 
                                       readonly />
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-2 px-1">
                                <span class="text-secondary small" style="font-size: 0.78rem;">
                                    <i class="bi bi-cursor-fill text-info me-1"></i>Box par click karne par calendar &amp; time popup khulega
                                </span>
                                <span class="text-info small fw-bold" style="font-size: 0.82rem;">
                                    <i class="bi bi-clock-history me-1 text-warning"></i>@scheduleDateTime.ToString("ddd, dd MMM yyyy — hh:mm tt") IST
                                </span>
                            </div>
                        </div>

                        <!-- Post Caption -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label text-white fw-bold small mb-0">
                                    <i class="bi bi-chat-text-fill me-1 text-info"></i> Post Caption &amp; Hashtags
                                </label>
                                <span class="text-secondary small">Visible on Facebook &amp; Instagram post</span>
                            </div>
                            <textarea class="form-control bg-dark text-white border-secondary small" rows="4" @bind="scheduleCaption" placeholder="Write caption for this post..."></textarea>
                        </div>
                    </div>

                    <div class="modal-footer border-top border-secondary border-opacity-25 px-4 py-3 d-flex justify-content-between">
                        <NavLink href="doctor/schedules" class="text-secondary small text-decoration-none">
                            <i class="bi bi-list-check me-1"></i> View All Scheduled Posts
                        </NavLink>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-secondary px-4" @onclick="CloseScheduleModal">Cancel</button>
                            <button type="button" class="btn btn-info px-4 fw-bold" @onclick="ConfirmCreateScheduleAsync" disabled="@isSubmittingSchedule" style="background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%); border: none; color: #070d1e;">
                                @if (isSubmittingSchedule)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    <span>Scheduling...</span>
                                }
                                else
                                {
                                    <i class="bi bi-check-circle-fill me-1"></i>
                                    <span>Confirm &amp; Schedule</span>
                                }
