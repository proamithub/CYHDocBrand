@code {
    private CurrentUserDTO? currentUser;
    private bool IsAdmin => currentUser?.Role == "Admin";

    private List<BannerDesignRecordDTO> banners = new();
    private List<BannerDesignRecordDTO> filteredBanners = new();
    private List<string> AvailableDoctorNames = new();

    private string currentStatusFilter = "All";
    private string searchQuery = string.Empty;
    private string selectedDoctorNameFilter = string.Empty;

    private bool isLoading = true;
    private string? feedbackMessage;
    private ToastNotificationDTO? activePopup;

    private int? pendingDeleteId;
    private string pendingDeleteTitle = string.Empty;



    protected override async Task OnInitializedAsync()
    {
        currentUser = await AuthService.GetOrRestoreCurrentUserAsync();
        if (currentUser == null)
        {
            NavigationManager.NavigateTo("login");
            return;
        }

        await LoadBannersAsync();
    }

    private async Task LoadBannersAsync()
    {
        isLoading = true;
        try
        {
            var filterUserId = IsAdmin ? null : currentUser?.UserId;
            banners = await BannerRepo.GetAllBannersAsync(filterUserId);

            // Populate distinct doctor names for Admin dropdown
            AvailableDoctorNames = banners
                .Select(b => b.DoctorName)
                .Where(name => !string.IsNullOrWhiteSpace(name))
                .Distinct()
                .OrderBy(n => n)
                .ToList();

            ApplyFilters();
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Error loading banners: {ex.Message}";
            ShowPopup("Error Loading Banners", ex.Message, "error");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetFilter(string status)
    {
        currentStatusFilter = status;
        ApplyFilters();
    }

    private void ApplySearch()
    {
        ApplyFilters();
    }

    private void ClearSearch()
    {
        searchQuery = string.Empty;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        var result = banners.AsEnumerable();

        if (currentStatusFilter != "All")
        {
            result = result.Where(b => b.Status.Equals(currentStatusFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(selectedDoctorNameFilter))
        {
            result = result.Where(b => string.Equals(b.DoctorName, selectedDoctorNameFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var q = searchQuery.Trim().ToLower();
            result = result.Where(b => 
                (b.Heading?.ToLower().Contains(q) ?? false) ||
                (b.DoctorName?.ToLower().Contains(q) ?? false) ||
                (b.TemplateType?.ToLower().Contains(q) ?? false) ||
                (b.Subtitle?.ToLower().Contains(q) ?? false)
            );
        }

        filteredBanners = result.ToList();
    }

    private void EditBanner(int id)
    {
        var relPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).ToLowerInvariant();
        var prefix = (currentUser?.Role == "Doctor" || relPath.StartsWith("doctor")) ? "doctor/" : 
                     (IsAdmin ? "admin/" : "");
        var encId = UrlEncryptionHelper.EncryptId(id);
        NavigationManager.NavigateTo($"{prefix}banner-design?id={encId}");
    }

    private BannerDesignRecordDTO? viewingBanner;
    private BannerCustomizationState? viewingBannerState;
    private bool isRenderingModalCanvas = false;

    private async Task OpenPhotoModal(BannerDesignRecordDTO item)
    {
        viewingBanner = item;
        viewingBannerState = item.GetConfigState();
        isRenderingModalCanvas = true;
        StateHasChanged();
    }

    private void ClosePhotoModal()
    {
        viewingBanner = null;
        viewingBannerState = null;
        isRenderingModalCanvas = false;
    }

    private async Task<bool> EnsureBannerStudioLoadedAsync()
    {
        try
        {
            return await JSRuntime.InvokeAsync<bool>("eval", @"
                new Promise((resolve) => {
                    if (typeof window.bannerStudio !== 'undefined' && typeof window.bannerStudio.renderBanner === 'function') {
                        return resolve(true);
                    }
                    const existing = document.getElementById('banner-studio-dynamic-script');
                    if (existing) existing.remove();
                    const s = document.createElement('script');
                    s.id = 'banner-studio-dynamic-script';
                    s.src = 'js/bannerStudio.js?v=' + Date.now();
                    s.onload = () => resolve(typeof window.bannerStudio !== 'undefined' && typeof window.bannerStudio.renderBanner === 'function');
                    s.onerror = () => resolve(false);
                    document.head.appendChild(s);
                })
            ");
        }
        catch
        {
            return false;
        }
    }

    private DotNetObjectReference<BannerDesignList>? dotNetHelper;
    private bool shouldInitDatePicker = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetHelper = DotNetObjectReference.Create(this);
        }

        if (shouldInitDatePicker && schedulingBanner != null)
        {
            shouldInitDatePicker = false;
            try
            {
                await JSRuntime.InvokeVoidAsync("cyhDatePicker.init", "scheduleFlatpickrInput", scheduleDateTime.ToString("yyyy-MM-dd HH:mm"), dotNetHelper);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error initializing flatpickr: {ex.Message}");
            }
        }

        if (viewingBannerState != null && isRenderingModalCanvas)
        {
            try
            {
                var ready = await EnsureBannerStudioLoadedAsync();
                if (ready)
                {
                    await JSRuntime.InvokeVoidAsync("bannerStudio.renderBanner", "viewModalCanvas", viewingBannerState);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error rendering viewModalCanvas: {ex.Message}");
            }
            finally
            {
                isRenderingModalCanvas = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task DownloadModalBannerPng()
    {
        if (viewingBanner == null || viewingBannerState == null) return;
        try
        {
            await EnsureBannerStudioLoadedAsync();
            var fileName = $"CYH_Banner_{viewingBanner.Id}_{IndianTimeHelper.Now:yyyyMMdd_HHmmss}.png";
            await JSRuntime.InvokeVoidAsync("bannerStudio.downloadBanner", "viewModalCanvas", fileName);
            ShowPopup("Download Started", "HD composite banner PNG download in progress...", "save");
        }
        catch (Exception ex)
        {
            ShowPopup("Download Error", ex.Message, "error");
        }
    }

    private async Task ShareModalBanner()
    {
        if (viewingBanner == null || viewingBannerState == null) return;
        try
        {
            await EnsureBannerStudioLoadedAsync();
            var shareTitle = $"{viewingBannerState.Heading} — {viewingBannerState.HospitalName}";
            var shareText = $"{viewingBannerState.Heading}\n{viewingBannerState.Subtitle}\nConsult {viewingBannerState.DoctorName} at {viewingBannerState.HospitalName}.\nHelpline: {viewingBannerState.ContactPhone}";
            await JSRuntime.InvokeAsync<object>("bannerStudio.shareBanner", "viewModalCanvas", shareTitle, shareText);
        }
        catch { }
    }

    // ── Social Media Scheduling State & Methods (100% Without API) ──
    private BannerDesignRecordDTO? schedulingBanner;
    private List<MediaPlatformDTO> activePlatforms = new();
    private HashSet<string> selectedPlatforms = new();
    private bool isLoadingPlatforms = false;
    private DateTime scheduleDateTime = IndianTimeHelper.Now.AddHours(1);
    private string scheduleCaption = string.Empty;
    private bool isSubmittingSchedule = false;

    [JSInvokable]
    public void OnDateSelectedFromPicker(string isoDate)
    {
        if (DateTime.TryParse(isoDate, out var dt))
        {
            scheduleDateTime = dt;
            InvokeAsync(StateHasChanged);
        }
    }

    private async Task OpenDatePickerPopup()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("cyhDatePicker.open", "scheduleFlatpickrInput");
        }
        catch { }
    }

    private void OpenScheduleModal(BannerDesignRecordDTO item)
    {
        schedulingBanner = item;
        var state = item.GetConfigState();

        scheduleCaption = $"{item.Heading}\n\n{(state.Subtitle ?? "")}\n\nFor expert consultations, visit {item.HospitalName ?? "CYH Hospital"} or contact {state.ContactPhone}.\n\n#Healthcare #Doctor #{item.DoctorName.Replace(" ", "")} #Wellness";
        scheduleDateTime = IndianTimeHelper.Now.AddHours(1);

        // Load active platforms dynamically from DB
        isLoadingPlatforms = true;
        selectedPlatforms = new HashSet<string>();
        StateHasChanged();
        _ = Task.Run(async () =>
        {
            activePlatforms = await MediaPlatformRepo.GetActiveAsync();
            // Default select all active platforms (Google excluded unless doctor account found)
            foreach (var p in activePlatforms)
            {
                if (p.AllowGlobalFallback || p.HasGlobalApiConfigured)
                    selectedPlatforms.Add(p.PlatformCode);
            }
            isLoadingPlatforms = false;
            await InvokeAsync(StateHasChanged);
        });
        shouldInitDatePicker = true;
        StateHasChanged();
    }

    public void Dispose()
    {
        dotNetHelper?.Dispose();
    }

    private void OpenScheduleModalFromView()
    {
        if (viewingBanner != null)
        {
            var banner = viewingBanner;
            ClosePhotoModal();
            OpenScheduleModal(banner);
        }
    }

    private void CloseScheduleModal()
    {
        schedulingBanner = null;
        selectedPlatforms.Clear();
        activePlatforms.Clear();
    }

    private void TogglePlatformSelection(string platformCode)
    {
        if (selectedPlatforms.Contains(platformCode))
            selectedPlatforms.Remove(platformCode);
        else
            selectedPlatforms.Add(platformCode);
    }

    private static string HexToScheduleRgb(string hex)
    {
        hex = hex.TrimStart('#');
        if (hex.Length == 6)
        {
            var r = Convert.ToInt32(hex[..2], 16);
            var g = Convert.ToInt32(hex[2..4], 16);
            var b = Convert.ToInt32(hex[4..6], 16);
            return $"{r},{g},{b}";
        }
        return "255,255,255";
    }

    private async Task ConfirmCreateScheduleAsync()
    {
        if (schedulingBanner == null) return;

        var selected = selectedPlatforms.ToList();

        if (selected.Count == 0)
        {
            ShowPopup("Select Platform", "Please select at least one platform to schedule this banner.", "warning");
            return;
        }

        if (scheduleDateTime <= IndianTimeHelper.Now.AddMinutes(1))
        {
            ShowPopup("Invalid Time", "Schedule time must be in the future (at least 2 minutes ahead).", "error");
            return;
        }

        isSubmittingSchedule = true;
        StateHasChanged();

        try
        {
            int? docId = currentUser?.DoctorProfileId;
            if (!docId.HasValue && !string.IsNullOrEmpty(schedulingBanner.UserId))
            {
                var doc = await DoctorRepo.GetByUserIdAsync(schedulingBanner.UserId);
                if (doc != null) docId = doc.Id;
            }

            var req = new CreateBannerScheduleRequest
            {
                BannerDesignId = schedulingBanner.Id,
                DoctorId = docId,
                UserId = schedulingBanner.UserId ?? currentUser?.UserId,
                DoctorName = schedulingBanner.DoctorName,
                HospitalName = schedulingBanner.HospitalName,
                BannerHeading = schedulingBanner.Heading,
                ImageUrl = schedulingBanner.BackgroundImageUrl,
                Caption = scheduleCaption,
                SelectedPlatforms = selected,
                ScheduledAt = scheduleDateTime // Saved in Indian Standard Time (IST)
            };

            var id = await ScheduleRepo.CreateScheduleAsync(req, currentUser?.FullName);
            if (id > 0)
            {
                ShowPopup("Banner Scheduled!", $"Banner scheduled successfully! Post scheduled for {scheduleDateTime:dd MMM, hh:mm tt} IST.", "save");
                CloseScheduleModal();
            }
            else
            {
                ShowPopup("Scheduling Failed", "Failed to save schedule. Please try again.", "error");
            }
        }
        catch (Exception ex)
        {
            ShowPopup("Error", ex.Message, "error");
        }
        finally
        {
            isSubmittingSchedule = false;
            StateHasChanged();
        }
    }

    private string GetCreditHistoryUrl()
    {
        var relPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).ToLowerInvariant();
        if (currentUser?.Role == "Doctor" || relPath.StartsWith("doctor")) return "doctor/credit-history";
        if (IsAdmin || relPath.StartsWith("admin")) return "admin/credit-history";
        return "credit-history";
    }

    private string GetCreateUrl()
    {
        var relPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).ToLowerInvariant();
        if (currentUser?.Role == "Doctor" || relPath.StartsWith("doctor")) return "doctor/banner-design";
        if (IsAdmin || relPath.StartsWith("admin")) return "admin/banner-design";
        return "banner-design";
    }

    private async Task QuickPublish(int id)
    {
        try
        {
            var filterUserId = IsAdmin ? null : currentUser?.UserId;

            // Credit Check for Doctor
            if (currentUser?.Role == "Doctor")
            {
                int doctorProfileId = 0;
                if (currentUser.DoctorProfileId.HasValue && currentUser.DoctorProfileId.Value > 0)
                {
                    doctorProfileId = currentUser.DoctorProfileId.Value;
                }
                else if (!string.IsNullOrEmpty(currentUser.UserId))
                {
                    var docProf = await DoctorRepo.GetByUserIdAsync(currentUser.UserId);
                    if (docProf != null) doctorProfileId = docProf.Id;
                }

                if (doctorProfileId > 0)
                {
                    var targetBanner = banners.FirstOrDefault(b => b.Id == id);
                    string creditCode = (targetBanner?.TemplateType == "Template") ? "TEMPLATE_PUBLISH" : "AI_BANNER_PUBLISH";

                    var (credOk, credMsg, remaining) = await CreditRepo.DeductCreditOnPublishAsync(
                        doctorProfileId, 
                        creditCode, 
                        id.ToString(), 
                        $"Quick Published banner #{id}: {targetBanner?.Heading}");

                    if (!credOk)
                    {
                        feedbackMessage = credMsg;
                        ShowPopup("Insufficient Credits", credMsg, "warning");
                        return;
                    }
                }
            }

            var success = await BannerRepo.PublishBannerAsync(id, filterUserId);
            if (success)
            {
                feedbackMessage = $"Banner #{id} published successfully. Ready for download and social sharing.";
                ShowPopup("Banner Published!", $"Banner #{id} published successfully! Download and Share are now active.", "save");
                await LoadBannersAsync();
            }
            else
            {
                feedbackMessage = "Failed to publish banner.";
                ShowPopup("Publish Failed", "Banner could not be published.", "error");
            }
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Error: {ex.Message}";
            ShowPopup("Error", ex.Message, "error");
        }
    }

    private void ConfirmDeleteBanner(int id, string title)
    {
        var target = banners.FirstOrDefault(b => b.Id == id);
        if (target != null && target.Status == "Published" && !IsAdmin)
        {
            ShowPopup("Delete Locked", "Published banners can only be deleted by an Administrator.", "error");
            return;
        }

        pendingDeleteId = id;
        pendingDeleteTitle = title;
    }

    private void CancelDelete()
    {
        pendingDeleteId = null;
        pendingDeleteTitle = string.Empty;
    }

    private async Task ExecuteDelete()
    {
        if (!pendingDeleteId.HasValue) return;
        var id = pendingDeleteId.Value;
        CancelDelete();
        await DeleteBanner(id);
    }

    private async Task DeleteBanner(int id)
    {
        var target = banners.FirstOrDefault(b => b.Id == id);
        if (target != null && target.Status == "Published" && !IsAdmin)
        {
            ShowPopup("Permission Denied", "Published banners can only be deleted by an Administrator.", "error");
            return;
        }

        try
        {
            var filterUserId = IsAdmin ? null : currentUser?.UserId;
            var success = await BannerRepo.DeleteBannerAsync(id, filterUserId);
            if (success)
            {
                feedbackMessage = $"Banner #{id} deleted successfully from database.";
                ShowPopup("Banner Deleted!", $"Banner #{id} permanently deleted from database.", "delete");
                await LoadBannersAsync();
            }
            else
            {
                feedbackMessage = "Failed to delete banner.";
                ShowPopup("Delete Failed", "Banner could not be deleted.", "error");
            }
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Error: {ex.Message}";
            ShowPopup("Delete Error", ex.Message, "error");
        }
    }

    private void ShowPopup(string title, string message, string type = "save")
    {
        activePopup = new ToastNotificationDTO
        {
            Title = title,
            Message = message,
            Type = type
        };
    }

    private void DismissPopup()
    {
        activePopup = null;
    }
}
