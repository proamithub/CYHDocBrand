@page "/facebook-callback"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using CYHDocBrandModel.DTO
@using CYHDocBrandRepo.IRepository
@using CYHDocBrandUI.Services

@inject ISocialMediaPublisherService PublisherService
@inject ISocialAccountRepository SocialRepo
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<div class="container py-5 text-center fade-in" style="max-width: 650px;">
    <div class="card glass-panel p-4 p-md-5 rounded-4 shadow-lg" style="background: rgba(14, 25, 48, 0.95); border: 1px solid rgba(24, 119, 242, 0.4);">
        @if (isProcessing)
        {
            <div class="py-4">
                <div class="spinner-border text-primary mb-3" role="status" style="width: 3.5rem; height: 3.5rem;">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <h4 class="text-white fw-bold mb-2">Connecting to Meta Facebook &amp; Instagram...</h4>
                <p class="text-secondary small mb-0">Exchanging official OAuth credentials and retrieving clinic page access tokens.</p>
            </div>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="py-3">
                <div class="text-danger mb-3" style="font-size: 3rem;">
                    <i class="bi bi-x-circle-fill"></i>
                </div>
                <h4 class="text-white fw-bold mb-2">Connection Failed</h4>
                <div class="alert alert-danger text-start small mb-4" style="background: rgba(239, 68, 68, 0.15); border-color: rgba(239, 68, 68, 0.3);">
                    @errorMessage
                </div>
                <button type="button" class="btn btn-outline-info px-4 py-2" @onclick="GoBackToSettings">
                    <i class="bi bi-arrow-left me-1"></i> Back to Social Connections
                </button>
            </div>
        }
        else
        {
            <div class="py-3">
                <div class="text-success mb-3" style="font-size: 3.5rem;">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <h4 class="text-white fw-bold mb-2">Meta Accounts Successfully Connected!</h4>
                <p class="text-secondary small mb-4">
                    Saved <strong class="text-white">@savedCount</strong> clinic page / account(s) to database. You can now schedule banners directly.
                </p>

                <button type="button" class="btn btn-primary px-5 py-2 fw-semibold" @onclick="GoBackToSettings" style="background: #1877f2; border: none;">
                    Go to Social Dashboard <i class="bi bi-arrow-right ms-1"></i>
                </button>
            </div>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Code { get; set; }

    [SupplyParameterFromQuery]
    public string? State { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "error_description")]
    public string? ErrorDescription { get; set; }

    private bool isProcessing = true;
    private string? errorMessage;
    private int savedCount = 0;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(Error))
        {
            isProcessing = false;
            errorMessage = ErrorDescription ?? Error;
            return;
        }

        if (string.IsNullOrEmpty(Code))
        {
            isProcessing = false;
            errorMessage = "No authorization code returned from Meta OAuth.";
            return;
        }

        try
        {
            var currentUser = await AuthService.GetOrRestoreCurrentUserAsync();
            var redirectUri = NavigationManager.BaseUri + "facebook-callback";

            // Real Exchange with Meta Graph API
            var pages = await PublisherService.ExchangeFacebookCodeForPagesAsync(Code, redirectUri);

            if (pages.Count == 0)
            {
                isProcessing = false;
                errorMessage = "No Facebook Pages found under this Meta account. Make sure you are an Admin of a Facebook Page.";
                return;
            }

            foreach (var p in pages)
            {
                // Save Facebook Page
                await SocialRepo.SaveAccountAsync(new SocialAccountSaveRequest
                {
                    DoctorId = currentUser?.DoctorProfileId,
                    UserId = currentUser?.UserId,
                    DoctorName = currentUser?.FullName,
                    Platform = "Facebook",
                    AccountName = p.PageName,
                    PageOrAccountId = p.PageId,
                    AccessToken = p.PageAccessToken,
                    IsActive = true
                });
                savedCount++;

                // If linked Instagram business account exists, save it as well
                if (!string.IsNullOrEmpty(p.InstagramBusinessAccountId))
                {
                    await SocialRepo.SaveAccountAsync(new SocialAccountSaveRequest
                    {
                        DoctorId = currentUser?.DoctorProfileId,
                        UserId = currentUser?.UserId,
                        DoctorName = currentUser?.FullName,
                        Platform = "Instagram",
                        AccountName = p.InstagramUsername ?? $"{p.PageName} IG",
                        PageOrAccountId = p.InstagramBusinessAccountId,
                        AccessToken = p.PageAccessToken,
                        IsActive = true
                    });
                    savedCount++;
                }
            }

            isProcessing = false;
        }
        catch (Exception ex)
        {
            isProcessing = false;
            errorMessage = ex.Message;
        }
    }

    private void GoBackToSettings()
    {
        NavigationManager.NavigateTo("doctor/social-connections");
    }
}
